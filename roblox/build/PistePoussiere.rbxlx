-- paramètres
---------------------------------------------------------------------------
SCREENS.settings = function()
	winTitle.Text = "PARAMÈTRES"
	local s = App.profile.settings
	local function choice(title, key, options)
		local r = row(60)
		Ui.label(title, {Position = UDim2.fromOffset(16, 0), Size = UDim2.new(0.4, 0, 1, 0), Font = Enum.Font.GothamBold, TextSize = 17, Parent = r})
		local box = make("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0.58, 0, 0, 40), BackgroundTransparency = 1, Parent = r})
		Ui.list(box, 6, true, Enum.HorizontalAlignment.Right)
		for _, o in ipairs(options) do
			local b = Ui.button(o[1], {Size = UDim2.fromOffset(130, 40), TextSize = 14}, function()
				s[key] = o[2]
				App.req("setSettings", {[key] = o[2]})
				Menus.open("settings")
			end, s[key] == o[2] and "primary" or "secondary")
			b.Parent = box
		end
	end
	choice("Caméra par défaut", "camera", {{"Poursuite", 1}, {"Capot", 2}, {"Cockpit", 3}})
	choice("Boîte de vitesses", "manual", {{"Automatique", false}, {"Manuelle (M)", true}})
	choice("Sensibilité direction", "sens", {{"Douce", 0.75}, {"Normale", 1}, {"Vive", 1.25}})
	choice("Conseils du copilote", "hints", {{"Oui", true}, {"Non", false}})
	choice("Fantôme", "ghost", {{"Oui", true}, {"Non", false}})
	choice("Accepter des passagers", "passengers", {{"Oui", true}, {"Non", false}})
	section("Commandes : Z/W gaz · S frein puis marche arrière · Q/A et D direction · Espace frein à main · R dernier point de passage · Retour arrière (maintenir) recommencer · C caméra · M boîte manuelle (E/Maj monter, F/Ctrl descendre) · clic droit maintenu : regarder autour (cockpit)")
	section("Manette : gâchettes gaz/frein · stick gauche direction · X frein à main · Y récupération · B/L1 rapports")
end

---------------------------------------------------------------------------
-- résultats
---------------------------------------------------------------------------
SCREENS.results = function(arg)
	local res, replay = arg.result, arg.replay
	winTitle.Text = "ARRIVÉE !"
	if not res or res.error then
		section(res and res.error or "Résultat indisponible")
	else
		local head = row(110)
		Ui.label(Ui.fmt(res.total), {Position = UDim2.fromOffset(16, 6), Size = UDim2.new(0.5, 0, 0, 56), Font = Enum.Font.GothamBlack, TextSize = 52, Parent = head})
		Ui.label(string.format("Temps brut %s + pénalités %.1f s", Ui.fmt(res.raw), res.pen), {Position = UDim2.fromOffset(16, 66), Size = UDim2.new(0.5, 0, 0, 20), TextSize = 15, TextColor3 = C.dim, Parent = head})
		local mtxt = res.medal and ("Médaille " .. Config.MEDAL_NAMES[res.medal]) or "Pas de médaille"
		Ui.label(mtxt, {Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(0.5, -16, 0, 34), Font = Enum.Font.GothamBlack, TextSize = 28,
			TextColor3 = res.medal and Ui.rgb(Config.MEDAL_COLORS[res.medal]) or C.dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = head})
		local rec = res.newBest and "Nouveau record personnel !" or ("Record : " .. Ui.fmt(res.prev))
		Ui.label(rec, {Position = UDim2.new(0.5, 0, 0, 50), Size = UDim2.new(0.5, -16, 0, 22), Font = Enum.Font.GothamBold, TextSize = 16,
			TextColor3 = res.newBest and C.green or C.text, TextXAlignment = Enum.TextXAlignment.Right, Parent = head})
		if res.medals then
			Ui.label(string.format("Bronze %s · Argent %s · Or %s · Platine %s", Ui.fmt(res.medals.bronze), Ui.fmt(res.medals.argent), Ui.fmt(res.medals["or"]), Ui.fmt(res.medals.platine)),
				{Position = UDim2.new(0.5, 0, 0, 76), Size = UDim2.new(0.5, -16, 0, 20), TextSize = 13, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Right, Parent = head})
		end

		-- récompenses
		section("RÉCOMPENSES" .. (res.vip and "  (VIP ×2)" or ""))
		for _, r in ipairs(res.rewards or {}) do
			local rr = row(32)
			Ui.label(r.label, {Position = UDim2.fromOffset(16, 0), Size = UDim2.new(0.6, 0, 1, 0), TextSize = 15, Parent = rr})
			Ui.label(string.format("+%d EXP   +%d CR", r.exp, r.cr), {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 0), Size = UDim2.new(0.4, 0, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = C.acc, Parent = rr})
		end
		local tot = row(36)
		Ui.label(string.format("TOTAL  +%d EXP   +%d CR%s%s", res.exp or 0, res.cr or 0, (res.tokens and res.tokens > 0) and ("   +" .. res.tokens .. " jeton(s) de raid") or "",
			res.masteryUp and ("   ·   Maîtrise M" .. res.mastery .. " !") or ""), {Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -32, 1, 0),
			Font = Enum.Font.GothamBlack, TextSize = 16, Parent = tot})

		-- gain / perte par section
		if res.bestSplits and res.splits then
			section("GAIN / PERTE PAR SECTION (comparé à ton ancien record)")
			local chart = row(120)
			local n = #res.splits
			local prevA, prevB = 0, 0
			for k = 1, n do
				local a, b = res.splits[k], res.bestSplits[k]
				if a and b then
					local d = (a - prevA) - (b - prevB)
					prevA, prevB = a, b
					local h = math.clamp(math.abs(d) * 30, 2, 50)
					make("Frame", {AnchorPoint = Vector2.new(0, d < 0 and 1 or 0), Position = UDim2.new((k - 1) / n, 4, 0.5, 0), Size = UDim2.new(1 / n, -8, 0, h),
						BackgroundColor3 = d < 0 and C.green or C.red, Parent = chart})
				end
			end
			make("Frame", {Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.dim, Parent = chart})
		end
	end

	local btns = make("Frame", {Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, Parent = body})
	Ui.list(btns, 10, true)
	Ui.button("Réessayer", {Size = UDim2.fromOffset(170, 48)}, function() Menus.close(); App.retry() end).Parent = btns
	Ui.button("Regarder le replay", {Size = UDim2.fromOffset(210, 48)}, function() Menus.close(); App.replay(replay, arg) end, "secondary").Parent = btns
	Ui.button("Menu principal", {Size = UDim2.fromOffset(170, 48)}, function() App.toHub(); Menus.open("main") end, "secondary").Parent = btns
	Ui.button("Mon garage", {Size = UDim2.fromOffset(150, 48)}, function() App.toHub(); Menus.open("garage") end, "secondary").Parent = btns
end

function Menus.challengeResult(d)
	local txt
	if d.you and d.opponent then
		txt = string.format("%s ! %s contre %s pour %s", d.win and "Victoire" or "Défaite", Ui.fmt(d.you), Ui.fmt(d.opponent), d.opponentName)
	elseif d.you then
		txt = "Victoire : " .. d.opponentName .. " n'a pas terminé"
	else
		txt = "Défi terminé"
	end
	Menus.toast(txt, d.win and C.green or C.red)
end

return Menus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Replay</string><ProtectedString name="Source"><![CDATA[-- Replay : rejoue l'enregistrement de la course avec des caméras de bord de route

local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Rallye")
local Config = require(Shared.Config)
local Cars = require(Shared.Cars)
local Track = require(Shared.Track)
local Ui = require(script.Parent.Ui)

local Replay = {}
local M = Config.M
local camera = workspace.CurrentCamera

-- data : frames, car, T, origin ; onEnd appelé à la fin ou quand on passe
function Replay.play(data, paintRGB, onEnd)
	local frames = data.frames
	if not frames or #frames < 2 then
		if onEnd then onEnd() end
		return
	end
	local model = Cars.build(data.car, paintRGB, {anchored = true})
	model.Name = "ReplayCar"
	model.Parent = workspace

	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Ui.make("ScreenGui", {Name = "Replay", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20, Parent = pg})
	-- bandes du format « clip vertical »
	Ui.make("Frame", {Size = UDim2.new(0.18, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.15, Parent = gui})
	Ui.make("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.18, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.15, Parent = gui})
	local rec = Ui.make("Frame", {Position = UDim2.new(0.2, 0, 0, 20), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Ui.C.red, Parent = gui})
	Ui.corner(rec, 8)
	Ui.label("REPLAY", {Position = UDim2.new(0.2, 24, 0, 14), Size = UDim2.fromOffset(200, 28), Font = Enum.Font.GothamBlack, TextSize = 24, Parent = gui})
	local tl = Ui.label("", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0.8, -10, 0, 14), Size = UDim2.fromOffset(200, 28), Font = Enum.Font.GothamBlack,
		TextSize = 24, TextXAlignment = Enum.TextXAlignment.Right, Parent = gui})
	local skip = Ui.button("ENTRÉE : Passer", {AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(220, 44)}, nil, "secondary")
	skip.Parent = gui

	local done = false
	local conn, keyConn
	local function finish()
		if done then return end
		done = true
		conn:Disconnect()
		keyConn:Disconnect()
		gui:Destroy()
		model:Destroy()
		if onEnd then onEnd() end
	end
	skip.MouseButton1Click:Connect(finish)
	keyConn = UIS.InputBegan:Connect(function(io)
		if io.KeyCode == Enum.KeyCode.Return or io.KeyCode == Enum.KeyCode.ButtonA then finish() end
	end)

	local t0 = frames[1].t
	local tEnd = frames[#frames].t
	local t = t0
	local i = 1
	local shot, shotT, shotPos = 0, 99, nil
	local T, origin = data.T, data.origin
	conn = RunService.RenderStepped:Connect(function(dt)
		t = t + dt
		if t >= tEnd + 1.5 then finish() return end
		while frames[i + 1] and frames[i + 1].t <= t do i = i + 1 end
		local a, b = frames[i], frames[i + 1] or frames[i]
		local u = (b.t > a.t) and math.clamp((t - a.t) / (b.t - a.t), 0, 1) or 0
		local cf = a.cf:Lerp(b.cf, u)
		model:PivotTo(cf)
		tl.Text = Ui.fmt(math.max(0, t))
		rec.BackgroundTransparency = (math.floor(t * 2) % 2 == 0) and 0 or 0.7
		-- changement de plan toutes les 4 s
		shotT = shotT + dt
		if shotT > 4 then
			shotT = 0
			shot = (shot % 4) + 1
			-- caméra fixe placée sur le bord de la route, un peu plus loin
			local px = (cf.Position.X - origin.X) / M
			local pz = (cf.Position.Z - origin.Z) / M
			local idx = Track.nearest(T, px, pz, nil)
			local s = T.S[math.min(#T.S, idx + 25)]
			local side = (shot % 2 == 0) and 1 or -1
			shotPos = origin + Vector3.new((s.x + s.nx * side * (Config.HALF + 5)) * M, (s.y + 2) * M, (s.z + s.nz * side * (Config.HALF + 5)) * M)
		end
		camera.CameraType = Enum.CameraType.Scriptable
		if shot == 1 or shot == 3 then
			camera.CFrame = CFrame.lookAt(shotPos or cf.Position + Vector3.new(20, 10, 20), cf.Position)
			camera.FieldOfView = 50
		elseif shot == 2 then
			camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, 22 * M, 0) - cf.LookVector * 12 * M, cf.Position)
			camera.FieldOfView = 60
		else
			camera.CFrame = CFrame.lookAt((cf * CFrame.new(1.8 * M, 0.3 * M, -5 * M)).Position, cf.Position + Vector3.new(0, 0.5 * M, 0))
			camera.FieldOfView = 70
		end
	end)
	shotT = 99
end

return Replay
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Ui</string><ProtectedString name="Source"><![CDATA[-- Petits outils d'interface (création d'instances, boutons, thème)

local Ui = {}

Ui.C = {
	bg = Color3.fromRGB(16, 20, 26),
	panel = Color3.fromRGB(26, 32, 41),
	panel2 = Color3.fromRGB(36, 44, 56),
	acc = Color3.fromRGB(255, 201, 60),
	red = Color3.fromRGB(229, 72, 77),
	green = Color3.fromRGB(76, 195, 138),
	blue = Color3.fromRGB(70, 140, 230),
	text = Color3.fromRGB(244, 241, 232),
	dim = Color3.fromRGB(160, 166, 176),
	black = Color3.fromRGB(10, 10, 12),
}
local C = Ui.C

function Ui.rgb(t) return Color3.fromRGB(t[1], t[2], t[3]) end

function Ui.make(class, props, children)
	local o = Instance.new(class)
	if class == "Frame" or class == "TextLabel" or class == "TextButton" or class == "ScrollingFrame" or class == "ImageLabel" or class == "CanvasGroup" then
		o.BorderSizePixel = 0
	end
	if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
		o.Font = Enum.Font.GothamMedium
		o.TextColor3 = C.text
		o.BackgroundTransparency = 1
		o.TextSize = 16
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, ch in ipairs(children or {}) do ch.Parent = o end
	if parent then o.Parent = parent end
	return o
end
local make = Ui.make

function Ui.corner(o, r)
	make("UICorner", {CornerRadius = UDim.new(0, r or 10), Parent = o})
	return o
end

function Ui.pad(o, p)
	make("UIPadding", {PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p), PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p), Parent = o})
	return o
end

function Ui.stroke(o, color, th)
	make("UIStroke", {Color = color or C.acc, Thickness = th or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o})
	return o
end

function Ui.list(o, padding, horizontal, align)
	return make("UIListLayout", {Padding = UDim.new(0, padding or 8), FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = align or Enum.HorizontalAlignment.Left, Parent = o})
end

function Ui.panel(props)
	local f = make("Frame", props)
	f.BackgroundColor3 = props.BackgroundColor3 or C.panel
	Ui.corner(f, 14)
	return f
end

function Ui.label(text, props)
	props = props or {}
	local l = make("TextLabel", props)
	l.Text = text
	l.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	l.TextWrapped = true
	return l
end

function Ui.button(text, props, onClick, style)
	props = props or {}
	local b = make("TextButton", props)
	b.Text = text
	b.AutoButtonColor = true
	b.BackgroundTransparency = 0
	b.Font = Enum.Font.GothamBold
	b.TextSize = props.TextSize or 17
	if style == "secondary" then
		b.BackgroundColor3 = C.panel2
		b.TextColor3 = C.text
	elseif style == "danger" then
		b.BackgroundColor3 = C.red
		b.TextColor3 = C.text
	else
		b.BackgroundColor3 = C.acc
		b.TextColor3 = Color3.fromRGB(26, 19, 0)
	end
	Ui.corner(b, 10)
	if onClick then b.MouseButton1Click:Connect(onClick) end
	return b
end

function Ui.bar(parent, props, frac, color)
	local back = make("Frame", props)
	back.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	back.BackgroundTransparency = 0.5
	back.Parent = parent
	Ui.corner(back, 4)
	local fill = make("Frame", {Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1), BackgroundColor3 = color or C.acc, Parent = back})
	Ui.corner(fill, 4)
	return back, fill
end

function Ui.clear(o)
	for _, ch in ipairs(o:GetChildren()) do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") and not ch:IsA("UICorner") and not ch:IsA("UIGridLayout") and not ch:IsA("UIStroke") then
			ch:Destroy()
		end
	end
end

function Ui.fmt(t)
	if not t then return "--:--.-" end
	local neg = t < 0
	t = math.abs(t)
	local m = math.floor(t / 60)
	local s = t - m * 60
	local str = string.format("%d:%04.1f", m, s)
	return neg and ("-" .. str) or str
end

function Ui.fmtDelta(d)
	if not d then return "" end
	return (d < 0 and "−" or "+") .. string.format("%.1f", math.abs(d))
end

function Ui.num(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^ ", ""))
end

return Ui
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000012"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000000E"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Piste Poussière : serveur principal
-- Construit le parc et les étapes, gère les profils, les courses, les récompenses, les défis et les passagers.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")
local PhysicsService = game:GetService("PhysicsService")
local MarketplaceService = game:GetService("MarketplaceService")
local Lighting = game:GetService("Lighting")

Players.CharacterAutoLoads = false

local Shared = RS:WaitForChild("Rallye")
local Config = require(Shared.Config)
local Track = require(Shared.Track)
local Cars = require(Shared.Cars)
local ServerMods = SSS:WaitForChild("RallyeServer")
local Builder = require(ServerMods.Builder)
local Data = require(ServerMods.Data)

local M = Config.M
workspace.Gravity = Config.G * M

-- groupes de collision : les voitures se traversent (courses fantômes)
pcall(function()
	PhysicsService:RegisterCollisionGroup("Cars")
	PhysicsService:CollisionGroupSetCollidable("Cars", "Cars", false)
	-- personnages assis dans les voitures : ne touchent rien
	PhysicsService:RegisterCollisionGroup("Riders")
	PhysicsService:CollisionGroupSetCollidable("Riders", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("Riders", "Cars", false)
	PhysicsService:CollisionGroupSetCollidable("Riders", "Riders", false)
end)

-- éclairage doux
Lighting.ClockTime = 14
Lighting.Brightness = 2.2
Lighting.OutdoorAmbient = Color3.fromRGB(130, 130, 130)
Lighting.GlobalShadows = true
local atm = Instance.new("Atmosphere")
atm.Density = 0.28
atm.Haze = 1.2
atm.Parent = Lighting

-- communication
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Request = Instance.new("RemoteFunction")
Request.Name = "Request"
Request.Parent = remotes
local Push = Instance.new("RemoteEvent")
Push.Name = "Push"
Push.Parent = remotes
remotes.Parent = Shared

local world = Instance.new("Folder")
world.Name = "Rallye"
world.Parent = workspace
local stagesFolder = Instance.new("Folder")
stagesFolder.Name = "Stages"
stagesFolder.Parent = world
local carsFolder = Instance.new("Folder")
carsFolder.Name = "Cars"
carsFolder.Parent = world

Builder.applyMaterialColors()
local hub, hubSpawn = Builder.buildHub(world)

local tracks = {}
local origins = Builder.layout()
local session = {}
local hubReady = true

---------------------------------------------------------------------------
-- outils
---------------------------------------------------------------------------
local function now() return workspace:GetServerTimeNow() end

local function push(player, kind, data)
	if player and player.Parent then Push:FireClient(player, kind, data) end
end

local function sendProfile(player)
	local prof = Data.profiles[player]
	if prof then
		player:SetAttribute("Level", Data.level(prof))
		push(player, "profile", prof)
	end
end

local function notify(player, text)
	push(player, "notify", {text = text})
end

local function isVip(player)
	if Config.VIP_GAMEPASS_ID == 0 then return false end
	local ok, res = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.VIP_GAMEPASS_ID) end)
	return ok and res
end

local function ownsComete(player)
	if Config.COMETE_GAMEPASS_ID == 0 then return false end
	local ok, res = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.COMETE_GAMEPASS_ID) end)
	return ok and res
end

local function setGroup(model, group)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then d.CollisionGroup = group end
	end
end

local function hubPosition()
	return hubSpawn.CFrame + Vector3.new(math.random(-6, 6), 4, math.random(-6, 6))
end

local function getSession(player)
	if not session[player] then session[player] = {} end
	return session[player]
end

---------------------------------------------------------------------------
-- voitures
---------------------------------------------------------------------------
local function unseat(humanoid)
	if not humanoid then return end
	humanoid.Sit = false
	if humanoid.SeatPart then
		local w = humanoid.SeatPart:FindFirstChild("SeatWeld")
		if w then w:Destroy() end
	end
end

local function charParts(char, massless)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Massless = massless
			d.CollisionGroup = massless and "Riders" or "Default"
		end
	end
end

local function removeCar(player)
	local ses = getSession(player)
	-- passager éventuel : retour au parc
	if ses.passenger and ses.passenger.Parent then
		local p = ses.passenger
		local ps = getSession(p)
		ps.riding = nil
		if p.Character then
			unseat(p.Character:FindFirstChildOfClass("Humanoid"))
			charParts(p.Character, false)
			p.Character:PivotTo(hubPosition())
		end
		push(p, "passengerEnd", {})
	end
	ses.passenger = nil
	if player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		unseat(hum)
		charParts(player.Character, false)
	end
	if ses.copilot then ses.copilot:Destroy(); ses.copilot = nil end
	if ses.car then ses.car:Destroy(); ses.car = nil end
	ses.run = nil
	player:SetAttribute("StageName", nil)
end

local function toHub(player)
	removeCar(player)
	local ses = getSession(player)
	if ses.riding then
		local d = ses.riding
		ses.riding = nil
		if d.Parent then getSession(d).passenger = nil end
	end
	if player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		unseat(hum)
		charParts(player.Character, false)
		task.wait()
		player.Character:PivotTo(hubPosition())
	end
end

-- copilote IA : l'avatar d'un ami (ou un avatar par défaut)
local function makeCopilot(player, seat)
	local ses = getSession(player)
	local rig
	local name = "Copilote"
	if ses.friendId then
		local ok, r = pcall(function() return Players:CreateHumanoidModelFromUserId(ses.friendId) end)
		if ok and r then rig = r; name = ses.friendName or name end
	end
	if not rig then
		local ok, r = pcall(function()
			return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
		end)
		if ok then rig = r end
	end
	if not rig then return end
	rig.Name = name
	for _, d in ipairs(rig:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Massless = true
			d.CanCollide = false
			d.CollisionGroup = "Riders"
		end
	end
	local hum = rig:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	end
	rig:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
	rig.Parent = seat.Parent
	if hum then seat:Sit(hum) end
	ses.copilot = rig
	ses.copilotName = name
end

local function spawnCar(player, stageId, carId)
	local T = tracks[stageId]
	local origin = origins[stageId]
	local car = Config.CAR_BY_ID[carId]
	local prof = Data.profiles[player]
	removeCar(player)
	local paintIdx = prof.paints[carId]
	local rgb = paintIdx and Config.PAINTS[paintIdx] and Config.PAINTS[paintIdx].rgb or nil
	local model = Cars.build(car, rgb)
	model.Name = player.Name .. "_" .. car.id
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("Stage", stageId)
	local s = T.S[Track.indexAtD(T, Config.SPAWN_D)]
	local pos = origin + Vector3.new(s.x * M, (s.y + 1.2) * M, s.z * M)
	local fwd = Vector3.new(math.sin(s.h), 0, math.cos(s.h))
	model:PivotTo(CFrame.lookAt(pos, pos + fwd))
	setGroup(model, "Cars")
	model.Parent = carsFolder
	local ses = getSession(player)
	ses.car = model

	local char = player.Character
	if not char or not char.Parent then
		player:LoadCharacter()
		char = player.Character or player.CharacterAdded:Wait()
	end
	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		unseat(hum)
		charParts(char, true)
		char:PivotTo(model.DriverSeat.CFrame + Vector3.new(0, 3, 0))
		model.DriverSeat:Sit(hum)
	end
	pcall(function() model.PrimaryPart:SetNetworkOwner(player) end)
	makeCopilot(player, model.PassengerSeat)
	return model
end

---------------------------------------------------------------------------
-- course
---------------------------------------------------------------------------
local function beginRun(player, stageId, carId, startAt, challenge)
	local prof = Data.profiles[player]
	if not prof then return false, "Profil non chargé" end
	local T = tracks[stageId]
	if not T then return false, "Étape en construction, patiente quelques secondes" end
	local car = Config.CAR_BY_ID[carId]
	if not car or not prof.owned[carId] then return false, "Voiture non possédée" end
	local model = spawnCar(player, stageId, carId)
	local ses = getSession(player)
	ses.run = {stageId = stageId, carId = carId, startAt = startAt, cps = {}, challenge = challenge}
	player:SetAttribute("StageName", Config.STAGE_BY_ID[stageId].name)
	prof.car = carId
	push(player, "raceStart", {stageId = stageId, carId = carId, startAt = startAt, carName = model.Name,
		challenge = challenge and {opponent = challenge.names[player]} or nil, copilot = ses.copilotName})
	return true
end

local function medalFor(T, total)
	local best = nil
	for _, m in ipairs(Config.MEDALS) do
		if total <= T.medals[m] then best = m end
	end
	return best
end

local function medalRank(m)
	for i, x in ipairs(Config.MEDALS) do if x == m then return i end end
	return 0
end

local challenges = {}
local nextChallenge = 1

local function finishChallenge(ch)
	if ch.done then return end
	ch.done = true
	local a, b = ch.players[1], ch.players[2]
	local ta, tb = ch.results[a], ch.results[b]
	local winner
	if ta and tb then winner = (ta <= tb) and a or b elseif ta then winner = a elseif tb then winner = b end
	for _, p in ipairs(ch.players) do
		push(p, "challengeResult", {
			you = ch.results[p], opponent = ch.results[(p == a) and b or a],
			opponentName = ch.names[p], win = (winner == p), stage = ch.stageId,
		})
	end
	challenges[ch.id] = nil
end

local function onFinish(player, info)
	local ses = getSession(player)
	local run = ses.run
	local prof = Data.profiles[player]
	if not run or not prof or run.finished then return nil end
	local T = tracks[run.stageId]
	local stage = Config.STAGE_BY_ID[run.stageId]
	local car = Config.CAR_BY_ID[run.carId]
	-- contrôles : tous les points de passage, temps cohérent avec l'horloge serveur
	if #run.cps < #T.cps then return {error = "Points de passage manquants"} end
	local raw = tonumber(info.raw) or 0
	local pen = math.max(0, tonumber(info.pen) or 0)
	local elapsed = now() - run.startAt
	-- le chrono démarre à l'arche (quelques secondes après le feu vert) : il ne peut pas être
	-- beaucoup plus court que le temps écoulé côté serveur
	if raw < elapsed - 15 or raw < T.par * 0.7 then
		raw = math.max(elapsed - 3, T.par * 0.7)
	end
	run.finished = true
	local total = math.floor((raw + pen) * 1000 + 0.5) / 1000

	local vip = isVip(player)
	local mult = vip and 2 or 1
	local rewards = {}
	local expSum, crSum = 0, 0
	local function give(labelText, r)
		rewards[#rewards + 1] = {label = labelText, exp = r.exp * mult, cr = r.cr * mult}
		expSum = expSum + r.exp * mult
		crSum = crSum + r.cr * mult
	end
	give("Fin d'étape", Config.REWARDS.finish)
	local medal = medalFor(T, total)
	if medal then
		give("Médaille " .. Config.MEDAL_NAMES[medal], Config.REWARDS.medal[medal])
		prof.medalTiers[run.stageId] = prof.medalTiers[run.stageId] or {}
		if not prof.medalTiers[run.stageId][medal] then
			prof.medalTiers[run.stageId][medal] = true
			give("Première médaille " .. Config.MEDAL_NAMES[medal], Config.REWARDS.firstMedal)
		end
		if medalRank(medal) > medalRank(prof.medals[run.stageId]) then prof.medals[run.stageId] = medal end
	end
	local today = Data.today()
	if prof.lastDay ~= today then
		prof.lastDay = today
		give("Première course du jour", Config.REWARDS.firstOfDay)
	end
	-- pièces
	prof.coins[run.stageId] = prof.coins[run.stageId] or {}
	local newCoins = 0
	local got = 0
	if type(info.coins) == "table" then
		for _, k in ipairs(info.coins) do
			k = tonumber(k)
			if k and T.coins[k] then
				got = got + 1
				if not prof.coins[run.stageId][tostring(k)] then
					prof.coins[run.stageId][tostring(k)] = true
					newCoins = newCoins + 1
				end
			end
		end
	end
	if newCoins > 0 then
		give(newCoins .. " nouvelle(s) pièce(s)", {exp = 0, cr = Config.REWARDS.coin.cr * newCoins})
	end
	-- jetons d'événement
	local tokens = 0
	if stage.event then
		tokens = medal and Config.EVENT.tokens[medal] or 1
		prof.tokens = prof.tokens + tokens
		if prof.tokens >= 10 then prof.ownedGloves.sable = true end
	end

	prof.exp = prof.exp + expSum
	prof.cr = prof.cr + crSum
	local oldM = Data.masteryLevel(prof.mastery[run.carId] or 0)
	prof.mastery[run.carId] = (prof.mastery[run.carId] or 0) + expSum
	local newM = Data.masteryLevel(prof.mastery[run.carId])
	if newM >= 10 then prof.ownedGloves["or"] = true end
	prof.runs = prof.runs + 1
	prof.km = prof.km + T.stageLength / 1000

	-- record
	local prev = prof.best[run.stageId]
	local newBest = (prev == nil) or total < prev.t
	local bestSplits = prev and prev.splits or nil
	if newBest then
		prof.best[run.stageId] = {t = total, car = run.carId, splits = run.cps}
		Data.submitTime(player, run.stageId, total)
	end

	-- contrats
	Data.contractProgress(prof, "finish3", 1)
	if medal and medalRank(medal) >= 3 then Data.contractProgress(prof, "gold1", 1) end
	Data.contractProgress(prof, "coins15", got)
	if pen == 0 then Data.contractProgress(prof, "clean2", 1) end
	if Config.SNOW_STAGES[run.stageId] then Data.contractProgress(prof, "snow1", 1) end
	Data.contractProgress(prof, "km5", math.floor(T.stageLength / 100) / 10)
	if car.front == 1 then Data.contractProgress(prof, "fwd1", 1) end
	local hp = 0
	for _, c in ipairs(T.corners) do if c.hairpin then hp = hp + 1 end end
	Data.contractProgress(prof, "hairpin10", hp)

	if run.challenge then
		run.challenge.results[player] = total
		local all = true
		for _, p in ipairs(run.challenge.players) do
			if not run.challenge.results[p] and p.Parent then all = false end
		end
		if all then finishChallenge(run.challenge) end
	end

	sendProfile(player)
	return {
		total = total, raw = raw, pen = pen, medal = medal, rewards = rewards, exp = expSum, cr = crSum,
		newBest = newBest, prev = prev and prev.t or nil, splits = run.cps, bestSplits = bestSplits,
		tokens = tokens, mastery = newM, masteryUp = newM > oldM, vip = vip, medals = T.medals,
	}
end

---------------------------------------------------------------------------
-- requêtes des clients
---------------------------------------------------------------------------
local leaderboards = {}
local nameCache = {}
local function nameOf(userId)
	if nameCache[userId] then return nameCache[userId] end
	local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(userId) end)
	nameCache[userId] = ok and n or ("#" .. userId)
	return nameCache[userId]
end

local function refreshBoards()
	for _, st in ipairs(Config.STAGES) do
		local list = Data.topTimes(st.id, 10)
		for _, e in ipairs(list) do e.name = nameOf(e.userId) end
		leaderboards[st.id] = list
	end
end

local H = {}

function H.getProfile(player)
	local prof = Data.profiles[player]
	while not prof and player.Parent do
		task.wait(0.2)
		prof = Data.profiles[player]
	end
	return {profile = prof, vip = isVip(player), comete = Config.COMETE_GAMEPASS_ID ~= 0, cometeId = Config.COMETE_GAMEPASS_ID, vipId = Config.VIP_GAMEPASS_ID}
end

function H.leaderboard(player, stageId)
	return leaderboards[stageId] or {}
end

function H.startStage(player, stageId, carId)
	local ses = getSession(player)
	if ses.riding then return {ok = false, msg = "Tu es passager"} end
	local ok, msg = beginRun(player, stageId, carId, now() + 4.5, nil)
	return {ok = ok, msg = msg}
end

function H.checkpoint(player, k, t)
	local run = getSession(player).run
	if not run then return false end
	k = tonumber(k)
	if k == #run.cps + 1 then run.cps[k] = tonumber(t) or 0 end
	return true
end

function H.finish(player, info)
	if type(info) ~= "table" then return nil end
	return onFinish(player, info)
end

function H.abandon(player)
	local ses = getSession(player)
	if ses.run and ses.run.challenge and not ses.run.finished then
		local ch = ses.run.challenge
		ses.run.finished = true
		local all = true
		for _, p in ipairs(ch.players) do
			if p ~= player and not ch.results[p] and p.Parent and getSession(p).run then all = false end
		end
		if all then finishChallenge(ch) end
	end
	toHub(player)
	return true
end

function H.freeRoam(player)
	toHub(player)
	return true
end

function H.buyCar(player, carId)
	local prof = Data.profiles[player]
	local car = Config.CAR_BY_ID[carId]
	if not car or prof.owned[carId] then return {ok = false} end
	if car.gamepass and Config[car.gamepass] ~= 0 then
		return {ok = false, msg = "Disponible avec le pass de jeu", gamepass = Config[car.gamepass]}
	end
	if prof.cr < car.price then return {ok = false, msg = "Crédits insuffisants"} end
	prof.cr = prof.cr - car.price
	prof.owned[carId] = true
	prof.car = carId
	sendProfile(player)
	return {ok = true}
end

function H.selectCar(player, carId)
	local prof = Data.profiles[player]
	if prof.owned[carId] then prof.car = carId; sendProfile(player); return true end
	return false
end

function H.setPaint(player, carId, idx)
	local prof = Data.profiles[player]
	idx = tonumber(idx)
	if not idx or not Config.PAINTS[idx] or not prof.ownedPaints[tostring(idx)] then return false end
	prof.paints[carId] = idx
	sendProfile(player)
	return true
end

function H.setGloves(player, id)
	local prof = Data.profiles[player]
	if prof.ownedGloves[id] then prof.gloves = id; sendProfile(player); return true end
	return false
end

function H.buyGloves(player, id)
	local prof = Data.profiles[player]
	for _, g in ipairs(Config.GLOVES) do
		if g.id == id and g.price and not prof.ownedGloves[id] and prof.cr >= g.price then
			prof.cr = prof.cr - g.price
			prof.ownedGloves[id] = true
			prof.gloves = id
			sendProfile(player)
			return {ok = true}
		end
	end
	return {ok = false, msg = "Achat impossible"}
end

function H.openCrate(player, kind)
	local prof = Data.profiles[player]
	local crate = Config.CRATES[kind]
	if not crate then return {ok = false} end
	if prof.cr < crate.price then return {ok = false, msg = "Crédits insuffisants"} end
	prof.cr = prof.cr - crate.price
	local result
	if kind == "paint" then
		local pool = {}
		for i = 2, #Config.PAINTS do if not prof.ownedPaints[tostring(i)] then pool[#pool + 1] = i end end
		if #pool == 0 then
			prof.cr = prof.cr + math.floor(crate.price / 2)
			result = {ok = true, text = "Toutes les peintures sont à toi : 50 % remboursés"}
		else
			local i = pool[math.random(1, #pool)]
			prof.ownedPaints[tostring(i)] = true
			result = {ok = true, text = "Nouvelle peinture : " .. Config.PAINTS[i].name, paint = i}
		end
	elseif kind == "perf" then
		-- caisse de performance : une voiture au hasard (les classes basses sortent plus souvent)
		local pool, total = {}, 0
		for _, c in ipairs(Config.CARS) do
			if not prof.owned[c.id] and not c.gamepass then
				local w = ({D = 10, C = 7, B = 5, A = 3, S = 1})[c.cls] or 1
				pool[#pool + 1] = {c, w}
				total = total + w
			end
		end
		if #pool == 0 then
			prof.cr = prof.cr + math.floor(crate.price / 2)
			result = {ok = true, text = "Garage complet : 50 % remboursés"}
		else
			local r = math.random() * total
			local pick = pool[1][1]
			for _, e in ipairs(pool) do
				r = r - e[2]
				if r <= 0 then pick = e[1]; break end
			end
			prof.owned[pick.id] = true
			result = {ok = true, text = "Nouvelle voiture : " .. pick.name .. " (" .. pick.cls .. ")", car = pick.id}
		end
	elseif kind == "glove" then
		local pool = {}
		for _, g in ipairs(Config.GLOVES) do
			if g.price and not prof.ownedGloves[g.id] then pool[#pool + 1] = g end
		end
		if #pool == 0 then
			prof.cr = prof.cr + math.floor(crate.price / 2)
			result = {ok = true, text = "Tous les gants sont à toi : 50 % remboursés"}
		else
			local g = pool[math.random(1, #pool)]
			prof.ownedGloves[g.id] = true
			result = {ok = true, text = "Nouveaux gants : " .. g.name}
		end
	end
	sendProfile(player)
	return result
end

function H.claimContract(player, id)
	local prof = Data.profiles[player]
	Data.refreshContracts(prof)
	for _, c in ipairs(prof.contracts.list) do
		if c.id == id and c.done and not c.claimed then
			for _, d in ipairs(Config.CONTRACTS) do
				if d.id == id then prof.cr = prof.cr + d.cr end
			end
			c.claimed = true
			sendProfile(player)
			return true
		end
	end
	return false
end

function H.setSettings(player, s)
	local prof = Data.profiles[player]
	if type(s) ~= "table" then return false end
	for k, v in pairs(s) do
		if prof.settings[k] ~= nil and type(v) == type(prof.settings[k]) then prof.settings[k] = v end
	end
	return true
end

-- défis tête-à-tête
function H.challenge(player, targetId, stageId)
	local target = Players:GetPlayerByUserId(tonumber(targetId) or 0)
	if not target or target == player or not tracks[stageId] then return {ok = false, msg = "Défi impossible"} end
	local id = nextChallenge
	nextChallenge = nextChallenge + 1
	challenges[id] = {id = id, from = player, to = target, stageId = stageId, created = os.clock(), results = {},
		players = {player, target}, names = {[player] = target.DisplayName, [target] = player.DisplayName}}
	push(target, "invite", {id = id, from = player.DisplayName, stage = Config.STAGE_BY_ID[stageId].name})
	return {ok = true}
end

function H.challengeReply(player, id, accept)
	local ch = challenges[tonumber(id) or 0]
	if not ch or ch.to ~= player then return false end
	if not accept or not ch.from.Parent then
		challenges[ch.id] = nil
		notify(ch.from, player.DisplayName .. " a refusé le défi")
		return true
	end
	local startAt = now() + 7
	for _, p in ipairs(ch.players) do
		local prof = Data.profiles[p]
		task.spawn(function()
			local ok, msg = beginRun(p, ch.stageId, prof.car, startAt, ch)
			if not ok then notify(p, msg) end
		end)
	end
	return true
end

-- conduite partagée : monter à côté d'un chauffeur
function H.drivers(player)
	local out = {}
	for p, ses in pairs(session) do
		if p ~= player and p.Parent and ses.car and ses.run and not ses.passenger then
			local prof = Data.profiles[p]
			if prof and prof.settings.passengers then
				out[#out + 1] = {userId = p.UserId, name = p.DisplayName, stage = Config.STAGE_BY_ID[ses.run.stageId].name, car = Config.CAR_BY_ID[ses.run.carId].name}
			end
		end
	end
	return out
end

function H.joinPassenger(player, driverId)
	local driver = Players:GetPlayerByUserId(tonumber(driverId) or 0)
	if not driver then return {ok = false, msg = "Chauffeur introuvable"} end
	local ds = getSession(driver)
	if not ds.car or ds.passenger then return {ok = false, msg = "Place occupée"} end
	removeCar(player)
	if ds.copilot then ds.copilot:Destroy(); ds.copilot = nil end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return {ok = false} end
	charParts(char, true)
	char:PivotTo(ds.car.PassengerSeat.CFrame + Vector3.new(0, 3, 0))
	ds.car.PassengerSeat:Sit(hum)
	ds.passenger = player
	getSession(player).riding = driver
	push(player, "passengerStart", {driver = driver.DisplayName, stageId = ds.run.stageId, carName = ds.car.Name, carId = ds.run.carId, startAt = ds.run.startAt})
	push(driver, "notify", {text = player.DisplayName .. " est ton copilote !"})
	push(driver, "copilotName", {name = player.DisplayName})
	return {ok = true}
end

function H.leavePassenger(player)
	toHub(player)
	return true
end

function H.callout(player, text)
	local driver = getSession(player).riding
	if driver and type(text) == "string" and #text < 40 then
		push(driver, "callout", {from = player.DisplayName, text = text})
	end
	return true
end

function H.buildStatus(player)
	local out = {}
	for _, st in ipairs(Config.STAGES) do out[st.id] = tracks[st.id] ~= nil end
	return out
end

Request.OnServerInvoke = function(player, action, ...)
	local f = H[action]
	if not f then return nil end
	local ok, res = pcall(f, player, ...)
	if not ok then
		warn("[Rallye] " .. tostring(action) .. " : " .. tostring(res))
		return nil
	end
	return res
end

---------------------------------------------------------------------------
-- joueurs
---------------------------------------------------------------------------
local function onPlayer(player)
	Data.load(player)
	local ses = getSession(player)
	task.spawn(function()
		local ok, pages = pcall(function() return Players:GetFriendsAsync(player.UserId) end)
		if ok and pages then
			local page = pages:GetCurrentPage()
			if page[1] then
				ses.friendId = page[1].Id
				ses.friendName = page[1].DisplayName or page[1].Username
			end
		end
	end)
	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			task.wait(3)
			if player.Parent then
				removeCar(player)
				player:LoadCharacter()
			end
		end)
	end)
	player:LoadCharacter()
	sendProfile(player)
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, p) end

Players.PlayerRemoving:Connect(function(player)
	removeCar(player)
	local ses = session[player]
	if ses and ses.riding and ses.riding.Parent then getSession(ses.riding).passenger = nil end
	for _, ch in pairs(challenges) do
		for _, p in ipairs(ch.players) do
			if p == player then finishChallenge(ch) break end
		end
	end
	session[player] = nil
	Data.release(player)
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then return end
	local prof = Data.profiles[player]
	if not prof then return end
	if passId == Config.COMETE_GAMEPASS_ID then prof.owned.comete = true end
	sendProfile(player)
	notify(player, "Merci pour ton achat !")
end)

game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do Data.save(p) end
	task.wait(2)
end)

-- sauvegarde régulière, contrats du jour, pass Comète
task.spawn(function()
	while true do
		task.wait(120)
		for _, p in ipairs(Players:GetPlayers()) do
			local prof = Data.profiles[p]
			if prof then
				if not prof.owned.comete and ownsComete(p) then prof.owned.comete = true; sendProfile(p) end
				Data.save(p)
			end
		end
	end
end)

-- défis expirés
task.spawn(function()
	while true do
		task.wait(10)
		for id, ch in pairs(challenges) do
			if os.clock() - ch.created > 900 then finishChallenge(ch) end
		end
	end
end)

---------------------------------------------------------------------------
-- construction des étapes (en arrière-plan, l'une après l'autre)
---------------------------------------------------------------------------
task.spawn(function()
	for i, st in ipairs(Config.STAGES) do
		Shared:SetAttribute("Building", st.name)
		local ok, err = pcall(function()
			local T = Builder.buildStage(st, origins[st.id], stagesFolder, function(p)
				Shared:SetAttribute("BuildProgress", (i - 1 + p) / #Config.STAGES)
			end)
			tracks[st.id] = T
		end)
		if not ok then warn("[Rallye] construction " .. st.id .. " : " .. tostring(err)) end
		Push:FireAllClients("stageReady", {id = st.id})
	end
	Shared:SetAttribute("Building", nil)
	Shared:SetAttribute("BuildProgress", 1)
	refreshBoards()
	while true do
		task.wait(90)
		refreshBoards()
	end
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000011"><Properties><string name="Name">RallyeServer</string></Properties><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Builder</string><ProtectedString name="Source"><![CDATA[-- Construction des étapes et du parc d'assistance (serveur)
-- Terrain lisse Roblox pour la route et le sol (la surface est lue par la physique), pièces pour le décor.

local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Rallye")
local Config = require(Shared.Config)
local Track = require(Shared.Track)
local Cars = require(Shared.Cars)

local Builder = {}
local M = Config.M
local HALF = Config.HALF
local terrain = workspace.Terrain
local Mat = Enum.Material

local function c3(r, g, b) return Color3.fromRGB(r, g, b) end

local function newPart(parent, size, cf, color, material, collide, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Mat.SmoothPlastic
	p.CanCollide = collide == true
	p.CanQuery = collide == true
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.Parent = parent
	return p
end
Builder.newPart = newPart

local function label(p, face, text, bg, fg, size)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 20
	sg.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg or c3(255, 255, 255)
	t.BackgroundTransparency = bg and 0 or 1
	t.TextColor3 = fg or c3(20, 20, 20)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = text
	t.Parent = sg
	return sg
end
Builder.label = label

function Builder.applyMaterialColors()
	for name, rgb in pairs(Config.MATERIAL_COLORS) do
		pcall(function() terrain:SetMaterialColor(Mat[name], c3(rgb[1], rgb[2], rgb[3])) end)
	end
	pcall(function() terrain.Decoration = true end)
	terrain.WaterColor = c3(60, 120, 150)
	terrain.WaterTransparency = 0.4
	terrain.WaterWaveSize = 0.08
end

-- position monde d'un échantillon
local function W(origin, s, lat, up)
	lat = lat or 0
	up = up or 0
	return origin + Vector3.new((s.x + s.nx * lat) * M, (s.y + up) * M, (s.z + s.nz * lat) * M)
end
Builder.W = W

local function segFrame(origin, a, b, lat, up, pitched)
	local p1 = W(origin, a, lat, up)
	local p2 = W(origin, b, lat, up)
	local dir = p2 - p1
	if not pitched then dir = Vector3.new(dir.X, 0, dir.Z) end
	if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, 1) end
	local mid = (p1 + p2) / 2
	return CFrame.lookAt(mid, mid + dir), (p2 - p1).Magnitude
end

local function featureAt(T, d, kind)
	for _, f in ipairs(T.features) do
		if f.kind == kind and d >= f.d0 - 0.01 and d <= f.d1 + 0.01 then return f end
	end
	return nil
end

-- colonne de terrain : demi-largeur hw (m), sommet top (m, relatif à la route), base absolue
local function column(origin, a, b, hw, top, baseY, material, extraLen)
	local cf, len = segFrame(origin, a, b, 0, 0, false)
	local topY = (math.min(a.y, b.y) + top) * M + origin.Y
	local bottom = baseY * M + origin.Y
	local h = topY - bottom
	if h < 1 then return end
	local c = CFrame.new(cf.Position.X, (topY + bottom) / 2, cf.Position.Z) * (cf - cf.Position)
	terrain:FillBlock(c, Vector3.new(hw * 2 * M, h, len + (extraLen or 1) * M), material)
end

---------------------------------------------------------------------------
-- Décor
---------------------------------------------------------------------------
local DECO = {}

local trunkC = c3(92, 62, 36)
DECO.pins = function(f, pos, r)
	local h = r(4, 7)
	newPart(f, Vector3.new(0.6, 2.2, 0.6) * M, CFrame.new(pos + Vector3.new(0, 1.1 * M, 0)), trunkC, Mat.Wood, true)
	for k = 0, 2 do
		local w = (2.8 - k * 0.8) * M
		newPart(f, Vector3.new(w, h / 3 * M, w), CFrame.new(pos + Vector3.new(0, (2.2 + (k + 0.5) * h / 3) * M, 0)) * CFrame.Angles(0, r(0, 3), 0),
			c3(36 + k * 6, 82 + k * 8, 44), Mat.SmoothPlastic, false)
	end
end
DECO.sapins = DECO.pins
DECO.sapinsNeige = function(f, pos, r)
	local h = r(4, 7)
	newPart(f, Vector3.new(0.6, 2.2, 0.6) * M, CFrame.new(pos + Vector3.new(0, 1.1 * M, 0)), trunkC, Mat.Wood, true)
	for k = 0, 2 do
		local w = (2.8 - k * 0.8) * M
		local y = (2.2 + (k + 0.5) * h / 3) * M
		local rot = CFrame.Angles(0, r(0, 3), 0)
		newPart(f, Vector3.new(w, h / 3 * M, w), CFrame.new(pos + Vector3.new(0, y, 0)) * rot, c3(40, 80, 58), Mat.SmoothPlastic, false)
		newPart(f, Vector3.new(w * 0.9, 0.25 * M, w * 0.9), CFrame.new(pos + Vector3.new(0, y + h / 6 * M, 0)) * rot, c3(250, 252, 255), Mat.Snow, false)
	end
end
DECO.erables = function(f, pos, r)
	newPart(f, Vector3.new(0.7, 3, 0.7) * M, CFrame.new(pos + Vector3.new(0, 1.5 * M, 0)), trunkC, Mat.Wood, true)
	local cols = {c3(214, 70, 40), c3(236, 130, 40), c3(190, 40, 40), c3(240, 180, 60)}
	local c = cols[math.floor(r(1, 4.99))]
	newPart(f, Vector3.new(4, 2.5, 4) * M, CFrame.new(pos + Vector3.new(0, 4.2 * M, 0)) * CFrame.Angles(0, r(0, 3), 0), c, Mat.SmoothPlastic, false)
	newPart(f, Vector3.new(2.8, 1.6, 2.8) * M, CFrame.new(pos + Vector3.new(0.4 * M, 6 * M, 0)) * CFrame.Angles(0, r(0, 3), 0), c, Mat.SmoothPlastic, false)
end
DECO.oliviers = function(f, pos, r)
	newPart(f, Vector3.new(0.6, 1.8, 0.6) * M, CFrame.new(pos + Vector3.new(0, 0.9 * M, 0)), c3(110, 90, 70), Mat.Wood, true)
	newPart(f, Vector3.new(3.2, 1.4, 3.2) * M, CFrame.new(pos + Vector3.new(0, 2.4 * M, 0)) * CFrame.Angles(0, r(0, 3), 0), c3(120, 140, 90), Mat.SmoothPlastic, false)
	if r() < 0.3 then
		newPart(f, Vector3.new(0.3, 0.3, 0.3) * M, CFrame.new(pos + Vector3.new(1.2 * M, 2.2 * M, 0)), c3(245, 220, 60), Mat.SmoothPlastic, false)
	end
end
DECO.plage = function(f, pos, r)
	if r() < 0.5 then
		-- palmier
		for k = 0, 4 do
			newPart(f, Vector3.new(0.45, 1.2, 0.45) * M, CFrame.new(pos + Vector3.new(k * 0.15 * M, (0.6 + k * 1.15) * M, 0)), c3(130, 100, 70), Mat.Wood, k == 0)
		end
		for a = 0, 4 do
			newPart(f, Vector3.new(0.5, 0.15, 2.6) * M, CFrame.new(pos + Vector3.new(0.75 * M, 6 * M, 0)) * CFrame.Angles(math.rad(-20), a * 1.25, 0) * CFrame.new(0, 0, -1.2 * M),
				c3(60, 150, 70), Mat.SmoothPlastic, false)
		end
	else
		-- parasol
		newPart(f, Vector3.new(0.15, 2.5, 0.15) * M, CFrame.new(pos + Vector3.new(0, 1.25 * M, 0)), c3(240, 240, 240), Mat.SmoothPlastic, true)
		newPart(f, Vector3.new(2.6, 0.25, 2.6) * M, CFrame.new(pos + Vector3.new(0, 2.5 * M, 0)) * CFrame.Angles(0, r(0, 3), 0),
			r() < 0.5 and c3(230, 60, 60) or c3(40, 120, 220), Mat.SmoothPlastic, false)
	end
end
DECO.desert = function(f, pos, r)
	local k = r()
	if k < 0.4 then
		-- acacia au sommet plat
		newPart(f, Vector3.new(0.5, 3, 0.5) * M, CFrame.new(pos + Vector3.new(0, 1.5 * M, 0)), c3(100, 80, 60), Mat.Wood, true)
		newPart(f, Vector3.new(5, 0.8, 4) * M, CFrame.new(pos + Vector3.new(0, 3.3 * M, 0)) * CFrame.Angles(0, r(0, 3), 0), c3(110, 130, 60), Mat.SmoothPlastic, false)
	elseif k < 0.75 then
		local s = r(1, 3)
		newPart(f, Vector3.new(s * 1.3, s, s) * M, CFrame.new(pos + Vector3.new(0, s * 0.4 * M, 0)) * CFrame.Angles(r(0, 1), r(0, 3), r(0, 1)), c3(170, 120, 80), Mat.Slate, true)
	else
		newPart(f, Vector3.new(1.2, 0.8, 1.2) * M, CFrame.new(pos + Vector3.new(0, 0.4 * M, 0)), c3(150, 140, 80), Mat.Grass, false)
	end
end
DECO.canyon = function(f, pos, r)
	local s = r(1.5, 4.5)
	newPart(f, Vector3.new(s * 1.2, s * r(0.8, 2), s) * M, CFrame.new(pos + Vector3.new(0, s * 0.5 * M, 0)) * CFrame.Angles(r(0, 0.5), r(0, 3), r(0, 0.5)),
		r() < 0.5 and c3(170, 80, 45) or c3(140, 70, 50), Mat.Slate, true)
end
DECO.village = function(f, pos, r, yaw)
	local w, d, h = r(5, 8), r(5, 8), r(4, 7)
	local wall = ({c3(240, 236, 226), c3(236, 214, 170), c3(220, 180, 150), c3(200, 220, 230)})[math.floor(r(1, 4.99))]
	local base = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	newPart(f, Vector3.new(w, h, d) * M, base * CFrame.new(0, h / 2 * M, 0), wall, Mat.SmoothPlastic, true)
	newPart(f, Vector3.new(w + 0.6, 0.8, d + 0.6) * M, base * CFrame.new(0, (h + 0.4) * M, 0), c3(170, 70, 50), Mat.SmoothPlastic, false)
	newPart(f, Vector3.new(1.2, 2, 0.1) * M, base * CFrame.new(0, 1 * M, -d / 2 * M - 0.05 * M), c3(90, 60, 40), Mat.Wood, false)
end
DECO.ferme = function(f, pos, r, yaw)
	if r() < 0.25 then
		local base = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
		newPart(f, Vector3.new(9, 5, 7) * M, base * CFrame.new(0, 2.5 * M, 0), c3(170, 40, 35), Mat.WoodPlanks, true)
		newPart(f, Vector3.new(9.6, 1, 7.6) * M, base * CFrame.new(0, 5.5 * M, 0), c3(70, 70, 75), Mat.SmoothPlastic, false)
	else
		DECO.pins(f, pos, r)
	end
end
DECO.lac = DECO.sapins
DECO.phare = DECO.oliviers

---------------------------------------------------------------------------
-- Construction d'une étape
---------------------------------------------------------------------------
function Builder.buildStage(stage, origin, parent, progress)
	local T = Track.generate(stage)
	local S = T.S
	local folder = Instance.new("Folder")
	folder.Name = stage.id
	folder.Parent = parent
	local deco = Instance.new("Folder")
	deco.Name = "Decor"
	deco.Parent = folder

	local offMat = Mat[stage.offroad] or Mat.Grass
	local x0, x1, z0, z1, y0 = Track.bounds(T)
	local baseY = y0 - 2
	local yield = 0
	local function tick()
		yield = yield + 1
		if yield % 25 == 0 then task.wait() end
	end

	-- sol de base
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	local bw, bd = (x1 - x0 + 500), (z1 - z0 + 500)
	local tiles = 4
	for ix = 0, tiles - 1 do
		for iz = 0, tiles - 1 do
			local px = cx - bw / 2 + (ix + 0.5) * bw / tiles
			local pz = cz - bd / 2 + (iz + 0.5) * bd / tiles
			terrain:FillBlock(CFrame.new(origin + Vector3.new(px * M, (baseY - 3) * M, pz * M)),
				Vector3.new(bw / tiles * M, 6 * M, bd / tiles * M), offMat)
			task.wait()
		end
	end
	if progress then progress(0.1) end

	local n = #S
	-- 1) talus et collines
	for i = 1, n - 2, 2 do
		local a, b = S[i], S[i + 2]
		local bridge = featureAt(T, a.d, "pont") or featureAt(T, a.d, "pontCouvert")
		local lake = featureAt(T, a.d, "lac")
		local beach = featureAt(T, a.d, "plage")
		local mat = offMat
		if beach then mat = Mat.Sand end
		if lake then mat = Mat.Glacier end
		if not bridge then
			column(origin, a, b, HALF + 3, -0.3, baseY - 3, mat)
			column(origin, a, b, HALF + 14, -1.0, baseY - 3, mat)
			if i % 4 == 1 then
				column(origin, a, b, HALF + 32, -3.5, baseY - 3, mat, 5)
				local high = a.y - baseY
				if high > 12 then column(origin, a, b, HALF + 70, -9, baseY - 3, offMat, 5) end
				if high > 28 then column(origin, a, b, HALF + 130, -22, baseY - 3, offMat, 9) end
			end
			if lake and i % 4 == 1 then
				column(origin, a, b, HALF + 110, -0.05, baseY - 3, Mat.Glacier, 6)
			end
		end
		tick()
	end
	if progress then progress(0.4) end

	-- 2) masses rocheuses (tunnels, falaises)
	for i = 1, n - 2, 2 do
		local a, b = S[i], S[i + 2]
		if featureAt(T, a.d, "tunnel") then
			column(origin, a, b, HALF + 16, 22, baseY - 3, Mat.Rock, 2)
		end
		if stage.deco == "canyon" and i % 4 == 1 and not featureAt(T, a.d, "gue") then
			for _, side in ipairs({-1, 1}) do
				local cf = segFrame(origin, a, b, side * (HALF + 26), 0, false)
				local top = (a.y + 14 + ((i * 7) % 11)) * M + origin.Y
				local bottom = (baseY - 3) * M + origin.Y
				terrain:FillBlock(CFrame.new(cf.Position.X, (top + bottom) / 2, cf.Position.Z) * (cf - cf.Position),
					Vector3.new(16 * M, top - bottom, 9 * M), (i % 8 == 1) and Mat.Sandstone or Mat.Rock)
			end
		end
		tick()
	end

	-- 3) dégagement au-dessus de la route
	for i = 1, n - 1 do
		local a, b = S[i], S[i + 1]
		local tunnel = featureAt(T, a.d, "tunnel")
		local cf, len = segFrame(origin, a, b, 0, 0, true)
		local h = tunnel and 6.5 or 16
		local lift = (h / 2 - 0.4) * M
		terrain:FillBlock(cf * CFrame.new(0, lift, 0), Vector3.new((HALF + 2.5) * 2 * M, h * M, len + 0.6 * M), Mat.Air)
		tick()
	end
	if progress then progress(0.55) end

	-- 4) rivières sous les ponts
	for _, f in ipairs(T.features) do
		if f.kind == "pont" or f.kind == "pontCouvert" then
			local i0, i1 = Track.indexAtD(T, f.d0), Track.indexAtD(T, f.d1)
			local mid = S[math.floor((i0 + i1) / 2)]
			local yRoad = mid.y
			local p = origin + Vector3.new(mid.x * M, 0, mid.z * M)
			local dir = Vector3.new(math.sin(mid.h), 0, math.cos(mid.h))
			local cf = CFrame.lookAt(p, p + dir)
			local span = (f.d1 - f.d0 - 4) * M
			terrain:FillBlock(cf * CFrame.new(0, (yRoad - 2.5) * M + origin.Y - p.Y, 0), Vector3.new(90 * M, 9 * M, span), Mat.Air)
			terrain:FillBlock(cf * CFrame.new(0, (yRoad - 6.5) * M + origin.Y - p.Y, 0), Vector3.new(90 * M, 2 * M, span), Mat.Mud)
			terrain:FillBlock(cf * CFrame.new(0, (yRoad - 5) * M + origin.Y - p.Y, 0), Vector3.new(90 * M, 1.6 * M, span), Mat.Water)
		end
	end

	-- 5) la route
	for i = 1, n - 1 do
		local a, b = S[i], S[i + 1]
		local bridge = featureAt(T, a.d, "pont") or featureAt(T, a.d, "pontCouvert")
		local cf, len = segFrame(origin, a, b, 0, 0, true)
		if not bridge then
			local mat = Mat[a.surf] or Mat.Ground
			terrain:FillBlock(cf * CFrame.new(0, -1.2 * M, 0), Vector3.new(HALF * 2 * M, 2.4 * M, len + 0.6 * M), mat)
		end
		tick()
	end
	if progress then progress(0.7) end

	-- 6) eau : gués, lacs, mer
	for i = 1, n - 1, 2 do
		local a = S[i]
		local b = S[math.min(n, i + 2)]
		if featureAt(T, a.d, "gue") then
			local cf, len = segFrame(origin, a, b, 0, 0, false)
			local y = (math.min(a.y, b.y)) * M + origin.Y
			terrain:FillBlock(CFrame.new(cf.Position.X, y + 0.05 * M, cf.Position.Z) * (cf - cf.Position), Vector3.new((HALF + 14) * 2 * M, 0.5 * M, len + 1 * M), Mat.Water)
		end
		if featureAt(T, a.d, "plage") and i % 4 == 1 then
			local cf = segFrame(origin, a, b, -(HALF + 70), 0, false)
			local y = a.y * M + origin.Y
			terrain:FillBlock(CFrame.new(cf.Position.X, y - 2.5 * M, cf.Position.Z) * (cf - cf.Position), Vector3.new(110 * M, 3 * M, 12 * M), Mat.Water)
		end
		if a.deco == "lac" and stage.offroad ~= "Snow" and i % 4 == 1 then
			local cf = segFrame(origin, a, b, HALF + 60, 0, false)
			local y = a.y * M + origin.Y
			terrain:FillBlock(CFrame.new(cf.Position.X, y - 3 * M, cf.Position.Z) * (cf - cf.Position), Vector3.new(90 * M, 3.5 * M, 12 * M), Mat.Water)
		end
		tick()
	end

	-- 7) congères (murs souples de neige) et arche de grès
	for i = 1, n - 1, 2 do
		local a = S[i]
		local b = S[math.min(n, i + 2)]
		if featureAt(T, a.d, "congeres") then
			for _, side in ipairs({-1, 1}) do
				local cf, len = segFrame(origin, a, b, side * (HALF + 1.2), 0, true)
				terrain:FillBlock(cf * CFrame.new(0, 0.3 * M, 0), Vector3.new(2.2 * M, 2.2 * M, len + 1 * M), Mat.Snow)
			end
		end
		tick()
	end
	for _, f in ipairs(T.features) do
		if f.kind == "arche" then
			local s = S[Track.indexAtD(T, (f.d0 + f.d1) / 2)]
			local p = W(origin, s)
			local cf = CFrame.lookAt(p, p + Vector3.new(math.sin(s.h), 0, math.cos(s.h)))
			terrain:FillBlock(cf * CFrame.new(0, 10 * M, 0), Vector3.new((HALF * 2 + 12) * M, 4 * M, 10 * M), Mat.Sandstone)
			for _, side in ipairs({-1, 1}) do
				terrain:FillBlock(cf * CFrame.new(side * (HALF + 4) * M, 3 * M, 0), Vector3.new(5 * M, 18 * M, 10 * M), Mat.Sandstone)
			end
		end
	end
	if progress then progress(0.8) end

	-- 8) ponts (planches, rondins, toit)
	for i = 1, n - 1 do
		local a, b = S[i], S[i + 1]
		local f = featureAt(T, a.d, "pont") or featureAt(T, a.d, "pontCouvert")
		if f then
			local cf, len = segFrame(origin, a, b, 0, 0, true)
			local deck = newPart(deco, Vector3.new((HALF * 2 + 0.6) * M, 0.6 * M, len + 0.4 * M), cf * CFrame.new(0, -0.3 * M, 0), c3(130, 92, 58), Mat.WoodPlanks, true)
			deck.CanQuery = true
			for _, side in ipairs({-1, 1}) do
				local log = newPart(deco, Vector3.new(len + 0.4 * M, 0.7 * M, 0.7 * M), cf * CFrame.new(side * (HALF + 0.3) * M, 0.35 * M, 0) * CFrame.Angles(0, math.pi / 2, 0),
					c3(110, 76, 46), Mat.Wood, true, Enum.PartType.Cylinder)
				log.CanQuery = false
				if i % 3 == 0 then
					newPart(deco, Vector3.new(0.6, 6, 0.6) * M, cf * CFrame.new(side * (HALF + 0.3) * M, -3 * M, 0), c3(90, 62, 36), Mat.Wood, false)
				end
				if f.kind == "pontCouvert" then
					newPart(deco, Vector3.new(0.4 * M, 4.5 * M, len + 0.4 * M), cf * CFrame.new(side * (HALF + 0.5) * M, 2.6 * M, 0), c3(150, 40, 35), Mat.WoodPlanks, true)
				end
			end
			if f.kind == "pontCouvert" then
				newPart(deco, Vector3.new((HALF * 2 + 2) * M, 0.5 * M, len + 0.4 * M), cf * CFrame.new(0, 5 * M, 0), c3(80, 60, 50), Mat.WoodPlanks, false)
			end
		end
	end

	-- 9) lumières de tunnel
	for i = 1, n - 1, 6 do
		local a = S[i]
		if featureAt(T, a.d, "tunnel") then
			local p = newPart(deco, Vector3.new(1.5, 0.2, 0.6) * M, CFrame.new(W(origin, a, 0, 6.1)), c3(255, 230, 170), Mat.Neon, false)
			local l = Instance.new("PointLight")
			l.Range = 40
			l.Brightness = 1.5
			l.Color = c3(255, 220, 160)
			l.Parent = p
		end
	end

	-- 10) décor (arbres, rochers, maisons) : rien sur la route
	local grid = {}
	local CELL = 20
	for i, s in ipairs(S) do
		local k = math.floor(s.x / CELL) .. "," .. math.floor(s.z / CELL)
		grid[k] = grid[k] or {}
		table.insert(grid[k], i)
	end
	local function clearOfRoad(x, z, margin)
		local gx, gz = math.floor(x / CELL), math.floor(z / CELL)
		for ax = -1, 1 do
			for az = -1, 1 do
				local list = grid[(gx + ax) .. "," .. (gz + az)]
				if list then
					for _, i in ipairs(list) do
						local s = S[i]
						local dx, dz = s.x - x, s.z - z
						if dx * dx + dz * dz < margin * margin then return false end
					end
				end
			end
		end
		return true
	end
	local r = Track.rng(stage.seed * 7 + 3)
	for i = 4, n - 4, 3 do
		local s = S[i]
		local kind = s.deco
		local village = featureAt(T, s.d, "village")
		local lake = featureAt(T, s.d, "lac")
		local fn = DECO[kind]
		if village then fn = DECO.village end
		local density = (kind == "desert" or kind == "canyon") and 0.22 or (lake and 0.04 or 0.5)
		if kind == "plage" then density = 0.18 end
		if village then density = 0.45 end
		for _, side in ipairs({-1, 1}) do
			if fn and r() < density then
				local off = village and r(HALF + 7, HALF + 11) or r(HALF + 4.5, HALF + 26)
				if kind == "plage" and side == -1 then off = r(HALF + 4, HALF + 8) end
				local x, z = s.x + s.nx * off * side, s.z + s.nz * off * side
				if clearOfRoad(x, z, HALF + 3.5) then
					local pos = origin + Vector3.new(x * M, (s.y - 0.4) * M, z * M)
					fn(deco, pos, r, s.h + (side == 1 and math.pi / 2 or -math.pi / 2))
				end
			end
		end
		if i % 30 == 0 then task.wait() end
	end
	if progress then progress(0.9) end

	-- 11) piquets, chevrons et panneaux
	local red, white, yellow, black = c3(210, 35, 40), c3(245, 245, 245), c3(255, 205, 30), c3(20, 20, 20)
	for i = 6, n - 6, 8 do
		local s = S[i]
		for _, side in ipairs({-1, 1}) do
			if not featureAt(T, s.d, "pont") and not featureAt(T, s.d, "pontCouvert") and not featureAt(T, s.d, "tunnel") then
				local p = W(origin, s, side * (HALF + 0.9), 0)
				local a1 = newPart(deco, Vector3.new(0.22, 0.55, 0.22) * M, CFrame.new(p + Vector3.new(0, 0.28 * M, 0)), red, Mat.SmoothPlastic, true)
				newPart(deco, Vector3.new(0.22, 0.55, 0.22) * M, CFrame.new(p + Vector3.new(0, 0.83 * M, 0)), white, Mat.SmoothPlastic, true)
				a1.CanQuery = false
			end
		end
	end
	for _, c in ipairs(T.corners) do
		if c.grade <= 3 or c.hairpin then
			local side = -c.dir -- extérieur du virage
			for i = c.i0 + 1, c.i1, 3 do
				local s = S[i]
				local p = W(origin, s, side * (HALF + 2.0), 0)
				local cf = CFrame.lookAt(p, p - Vector3.new(math.sin(s.h), 0, math.cos(s.h)))
				local board = newPart(deco, Vector3.new(1.6 * M, 0.9 * M, 0.08 * M), cf * CFrame.new(0, 1.0 * M, 0), yellow, Mat.SmoothPlastic, true)
				label(board, Enum.NormalId.Front, c.dir == 1 and "<<<" or ">>>", yellow, black)
				newPart(deco, Vector3.new(0.12, 0.6, 0.12) * M, cf * CFrame.new(0, 0.3 * M, 0), black, Mat.SmoothPlastic, false)
			end
		end
	end
	for _, nt in ipairs(T.notes) do
		if nt.danger or nt.hairpin then
			local i = Track.indexAtD(T, math.max(2, nt.d - 55))
			local s = S[i]
			local p = W(origin, s, -(HALF + 2.2), 0)
			local cf = CFrame.lookAt(p, p - Vector3.new(math.sin(s.h), 0, math.cos(s.h)))
			newPart(deco, Vector3.new(0.12, 1.6, 0.12) * M, cf * CFrame.new(0, 0.8 * M, 0), c3(150, 150, 150), Mat.Metal, true)
			-- triangle jaune (deux biseaux dos à dos)
			local sz = 1.3 * M
			for _, sgn in ipairs({-1, 1}) do
				local w = Instance.new("WedgePart")
				w.Anchored = true
				w.CanCollide = false
				w.Size = Vector3.new(0.08 * M, sz, sz / 2)
				w.Color = yellow
				w.CFrame = cf * CFrame.new(0, 2.2 * M, 0) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.new(0, 0, sgn * sz / 4) * CFrame.Angles(0, sgn == 1 and math.pi or 0, 0)
				w.Parent = deco
			end
			local mark = newPart(deco, Vector3.new(0.15, 0.6, 0.12) * M, cf * CFrame.new(0, 2.1 * M, -0.06 * M), black, Mat.SmoothPlastic, false)
			mark.Transparency = 0
		end
	end

	-- 12) arches de départ et d'arrivée
	local function gantry(d, text, isStart)
		local s = S[Track.indexAtD(T, d)]
		local p = W(origin, s)
		local cf = CFrame.lookAt(p, p + Vector3.new(math.sin(s.h), 0, math.cos(s.h)))
		local g = Instance.new("Model")
		g.Name = isStart and "StartGantry" or "FinishGantry"
		g.Parent = folder
		local col = isStart and c3(30, 30, 34) or c3(255, 205, 30)
		for _, side in ipairs({-1, 1}) do
			newPart(g, Vector3.new(0.8, 6.5, 0.8) * M, cf * CFrame.new(side * (HALF + 1.2) * M, 3.25 * M, 0), col, Mat.Metal, true)
		end
		local beam = newPart(g, Vector3.new((HALF * 2 + 3.2) * M, 1.4 * M, 0.6 * M), cf * CFrame.new(0, 6.6 * M, 0), col, Mat.Metal, false)
		label(beam, Enum.NormalId.Front, text, col, isStart and c3(255, 205, 30) or c3(20, 20, 20))
		label(beam, Enum.NormalId.Back, text, col, isStart and c3(255, 205, 30) or c3(20, 20, 20))
		if isStart then
			for k = 1, 3 do
				local l = newPart(g, Vector3.new(0.7, 0.7, 0.3) * M, cf * CFrame.new((k - 2) * 1.2 * M, 5.3 * M, 0.35 * M), c3(60, 0, 0), Mat.Neon, false)
				l.Name = "Light" .. k
			end
		else
			-- damier
			for k = 0, 9 do
				newPart(g, Vector3.new((HALF * 2 + 3) / 10 * M, 0.5 * M, 0.62 * M), cf * CFrame.new(((k + 0.5) / 10 - 0.5) * (HALF * 2 + 3) * M, 5.65 * M, 0),
					(k % 2 == 0) and c3(20, 20, 20) or c3(245, 245, 245), Mat.SmoothPlastic, false)
			end
		end
		-- tentes et barrières
		for _, side in ipairs({-1, 1}) do
			local tp = cf * CFrame.new(side * (HALF + 8) * M, 0, -3 * M)
			newPart(g, Vector3.new(5, 0.3, 5) * M, tp * CFrame.new(0, 3 * M, 0), isStart and c3(220, 40, 40) or c3(40, 90, 200), Mat.Fabric, false)
			for _, cx in ipairs({-2.3, 2.3}) do
				for _, cz in ipairs({-2.3, 2.3}) do
					newPart(g, Vector3.new(0.15, 3, 0.15) * M, tp * CFrame.new(cx * M, 1.5 * M, cz * M), c3(200, 200, 200), Mat.Metal, false)
				end
			end
		end
	end
	gantry(T.startD, "DÉPART", true)
	gantry(T.finishD, "ARRIVÉE", false)

	-- phare au bout de la corniche
	for i = n, 1, -1 do
		if S[i].deco == "phare" then
			local s = S[i]
			local p = W(origin, s, HALF + 14, -0.5)
			for k = 0, 7 do
				newPart(deco, Vector3.new(4 - k * 0.25, 2, 4 - k * 0.25) * M, CFrame.new(p + Vector3.new(0, (1 + k * 2) * M, 0)),
					(k % 2 == 0) and c3(245, 245, 245) or c3(200, 40, 40), Mat.SmoothPlastic, true, Enum.PartType.Cylinder)
			end
			local lamp = newPart(deco, Vector3.new(2, 2, 2) * M, CFrame.new(p + Vector3.new(0, 17 * M, 0)), c3(255, 240, 180), Mat.Neon, false)
			local l = Instance.new("PointLight")
			l.Range = 60
			l.Parent = lamp
			break
		end
	end

	folder:SetAttribute("OriginX", origin.X)
	folder:SetAttribute("OriginY", origin.Y)
	folder:SetAttribute("OriginZ", origin.Z)
	folder:SetAttribute("Ready", true)
	if progress then progress(1) end
	return T, folder
end

-- emplacement des étapes : grille autour du parc (évite les coordonnées trop lointaines)
function Builder.layout()
	local origins = {}
	local slots = {
		Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
		Vector3.new(1, 0, 1), Vector3.new(-1, 0, -1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1),
	}
	local SPACING = 2700 -- m
	for i, st in ipairs(Config.STAGES) do
		local T = Track.generate(st)
		local x0, x1, z0, z1, y0 = Track.bounds(T)
		local slot = slots[i]
		local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
		-- centre de la boîte du tracé placé sur la case ; altitude au-dessus du parc
		origins[st.id] = Vector3.new((slot.X * SPACING - cx) * M, (20 - y0) * M, (slot.Z * SPACING - cz) * M)
	end
	return origins
end

---------------------------------------------------------------------------
-- Parc d'assistance (zone libre à pied)
---------------------------------------------------------------------------
function Builder.buildHub(parent)
	local hub = Instance.new("Folder")
	hub.Name = "Hub"
	hub.Parent = parent
	terrain:FillBlock(CFrame.new(0, -6 * M, 0), Vector3.new(400 * M, 12 * M, 400 * M), Mat.Grass)
	terrain:FillBlock(CFrame.new(0, -0.6 * M, -20 * M), Vector3.new(90 * M, 1.2 * M, 120 * M), Mat.Asphalt)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(4, 0.4, 4) * M
	spawn.CFrame = CFrame.new(0, 0.2 * M, 30 * M)
	spawn.Color = c3(255, 205, 30)
	spawn.Material = Mat.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = hub

	local prompts = {}
	local function sign(name, text, pos, color, action, sub)
		local post = newPart(hub, Vector3.new(0.4, 4, 0.4) * M, CFrame.new(pos + Vector3.new(0, 2 * M, 0)), c3(80, 80, 85), Mat.Metal, true)
		local board = newPart(hub, Vector3.new(7, 2.4, 0.3) * M, CFrame.new(pos + Vector3.new(0, 4.6 * M, 0)), color, Mat.SmoothPlastic, true)
		board.Name = name
		label(board, Enum.NormalId.Front, text, color, c3(255, 255, 255))
		label(board, Enum.NormalId.Back, text, color, c3(255, 255, 255))
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = sub or text
		pp.ObjectText = text
		pp.MaxActivationDistance = 14
		pp.RequiresLineOfSight = false
		pp:SetAttribute("Action", action)
		pp.Parent = post
		prompts[#prompts + 1] = pp
		return post
	end
	-- tentes
	local function tent(pos, color, w, d)
		newPart(hub, Vector3.new(w, 0.4, d) * M, CFrame.new(pos + Vector3.new(0, 4 * M, 0)), color, Mat.Fabric, false)
		for _, cx in ipairs({-1, 1}) do
			for _, cz in ipairs({-1, 1}) do
				newPart(hub, Vector3.new(0.2, 4, 0.2) * M, CFrame.new(pos + Vector3.new(cx * (w / 2 - 0.2) * M, 2 * M, cz * (d / 2 - 0.2) * M)), c3(220, 220, 220), Mat.Metal, true)
			end
		end
	end
	tent(Vector3.new(-30, 0, 0) * M, c3(200, 40, 45), 14, 10)
	tent(Vector3.new(30, 0, 0) * M, c3(40, 90, 200), 14, 10)
	tent(Vector3.new(-30, 0, -35) * M, c3(250, 190, 30), 12, 10)
	sign("Garage", "MON GARAGE", Vector3.new(-30, 0, 8) * M, c3(40, 90, 200), "garage", "Ouvrir le garage")
	sign("Shop", "BOUTIQUE", Vector3.new(30, 0, 8) * M, c3(200, 40, 45), "shop", "Ouvrir la boutique")
	sign("Crate", "CAISSE DE PERFORMANCE 2 500 CR", Vector3.new(30, 0, -12) * M, c3(120, 60, 180), "crate", "Ouvrir une caisse")
	sign("Contracts", "CONTRATS", Vector3.new(-30, 0, -26) * M, c3(250, 150, 30), "contracts", "Voir les contrats")
	sign("Menu", "MENU", Vector3.new(0, 0, 18) * M, c3(30, 30, 34), "menu", "Ouvrir le menu")

	-- départs des étapes, à 75 m de l'apparition
	for i, st in ipairs(Config.STAGES) do
		local x = (i - (#Config.STAGES + 1) / 2) * 11
		local pad = newPart(hub, Vector3.new(8, 0.3, 8) * M, CFrame.new(Vector3.new(x, 0.15, -45) * M), st.event and c3(250, 150, 30) or c3(255, 205, 30), Mat.Neon, true)
		pad.Name = "Pad_" .. st.id
		sign("StageSign_" .. st.id, st.name, Vector3.new(x, 0, -50) * M, c3(30, 30, 34), "stage:" .. st.id, "Prendre le départ")
	end
	newPart(hub, Vector3.new(84, 1.2, 1.2) * M, CFrame.new(Vector3.new(0, 7.5, -54) * M), c3(30, 30, 34), Mat.Metal, false)
	local banner = newPart(hub, Vector3.new(40, 3, 0.4) * M, CFrame.new(Vector3.new(0, 9.6, -54) * M), c3(255, 205, 30), Mat.SmoothPlastic, false)
	label(banner, Enum.NormalId.Back, "ÉTAPES — PRENDRE LE DÉPART", c3(255, 205, 30), c3(20, 20, 20))
	label(banner, Enum.NormalId.Front, "PISTE POUSSIÈRE", c3(255, 205, 30), c3(20, 20, 20))

	-- vitrine des voitures
	local show = Instance.new("Folder")
	show.Name = "Showroom"
	show.Parent = hub
	for i, car in ipairs(Config.CARS) do
		local ok, model = pcall(Cars.build, car, nil, {anchored = true})
		if ok then
			local row = (i - 1) % 6
			local col = math.floor((i - 1) / 6)
			local pos = Vector3.new(-40 + row * 16, 0, 55 + col * 18) * M
			model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.rad(200), 0))
			model.Parent = show
			local pl = newPart(show, Vector3.new(14, 0.3, 12) * M, CFrame.new(pos + Vector3.new(0, 0.15 * M, 0)), c3(60, 60, 66), Mat.SmoothPlastic, true)
			label(pl, Enum.NormalId.Top, car.name .. "  " .. car.cls, c3(60, 60, 66), c3(255, 205, 30))
			local pp = Instance.new("ProximityPrompt")
			pp.ActionText = "Voir dans le garage"
			pp.ObjectText = car.name
			pp.MaxActivationDistance = 16
			pp.RequiresLineOfSight = false
			pp:SetAttribute("Action", "garage:" .. car.id)
			pp.Parent = pl
		end
	end

	-- quelques sapins autour
	local r = Track.rng(99)
	for _ = 1, 60 do
		local a = r(0, math.pi * 2)
		local d = r(110, 180)
		DECO.pins(hub, Vector3.new(math.cos(a) * d, 0, math.sin(a) * d) * M, r)
	end
	return hub, spawn
end

return Builder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Profils joueurs : crédits, EXP, maîtrise, voitures, records, médailles, contrats (DataStore)

local DataStoreService = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")
local Config = require(RS:WaitForChild("Rallye").Config)

local Data = {}
local store, bestStores = nil, {}
pcall(function() store = DataStoreService:GetDataStore("PistePoussiere_Profils_v1") end)

Data.profiles = {}

local function default()
	return {
		v = 1, cr = 500, exp = 0, tokens = 0,
		car = "moineau", owned = {moineau = true},
		paints = {}, ownedPaints = {["1"] = true}, medalTiers = {},
		gloves = "cuir", ownedGloves = {cuir = true},
		mastery = {},
		best = {}, medals = {}, coins = {}, runs = 0, km = 0,
		lastDay = "", contracts = nil,
		settings = {camera = 1, manual = false, sens = 1, hints = true, ghost = true, passengers = true},
	}
end

local function merge(dst, src)
	for k, v in pairs(src) do
		if dst[k] == nil then dst[k] = v
		elseif type(v) == "table" and type(dst[k]) == "table" and k == "settings" then merge(dst[k], v) end
	end
	return dst
end

function Data.today()
	return os.date("!%Y-%m-%d")
end

function Data.load(player)
	local prof
	if store then
		for _ = 1, 3 do
			local ok, res = pcall(function() return store:GetAsync("p_" .. player.UserId) end)
			if ok then prof = res; break end
			task.wait(1)
		end
	end
	prof = merge(prof or {}, default())
	Data.profiles[player] = prof
	Data.refreshContracts(prof)
	return prof
end

function Data.save(player)
	local prof = Data.profiles[player]
	if not prof or not store then return end
	pcall(function() store:SetAsync("p_" .. player.UserId, prof) end)
end

function Data.release(player)
	Data.save(player)
	Data.profiles[player] = nil
end

-- contrats du jour (3 tirés selon la date)
function Data.refreshContracts(prof)
	local day = Data.today()
	if prof.contracts and prof.contracts.day == day then return end
	local seed = 0
	for i = 1, #day do seed = seed + string.byte(day, i) * i end
	local list, used = {}, {}
	local n = #Config.CONTRACTS
	local k = seed
	while #list < 3 do
		k = (k * 1103515245 + 12345) % 2147483648
		local idx = (k % n) + 1
		if not used[idx] then
			used[idx] = true
			local c = Config.CONTRACTS[idx]
			list[#list + 1] = {id = c.id, progress = 0, done = false, claimed = false}
		end
	end
	prof.contracts = {day = day, list = list}
end

function Data.contractProgress(prof, id, amount)
	Data.refreshContracts(prof)
	for _, c in ipairs(prof.contracts.list) do
		if c.id == id and not c.done then
			local def
			for _, d in ipairs(Config.CONTRACTS) do if d.id == id then def = d end end
			c.progress = math.min(def.goal, c.progress + amount)
			if c.progress >= def.goal then c.done = true end
		end
	end
end

function Data.level(prof)
	return math.floor(prof.exp / Config.LEVEL_EXP) + 1
end

function Data.masteryLevel(exp)
	local lvl = 1
	for i, need in ipairs(Config.MASTERY_EXP) do
		if exp >= need then lvl = i end
	end
	return lvl
end

-- classement mondial par étape (temps en millisecondes, plus petit = meilleur)
function Data.bestStore(stageId)
	if bestStores[stageId] == nil then
		local ok, s = pcall(function() return DataStoreService:GetOrderedDataStore("PistePoussiere_Temps_" .. stageId) end)
		bestStores[stageId] = ok and s or false
	end
	return bestStores[stageId] or nil
end

function Data.submitTime(player, stageId, t)
	local s = Data.bestStore(stageId)
	if not s then return end
	local ms = math.floor(t * 1000)
	pcall(function()
		s:UpdateAsync(tostring(player.UserId), function(old)
			if old == nil or ms < old then return ms end
			return nil
		end)
	end)
end

function Data.topTimes(stageId, n)
	local s = Data.bestStore(stageId)
	if not s then return {} end
	local out = {}
	local ok, pages = pcall(function() return s:GetSortedAsync(true, n or 10) end)
	if ok and pages then
		for _, e in ipairs(pages:GetCurrentPage()) do
			out[#out + 1] = {userId = tonumber(e.key), t = e.value / 1000}
		end
	end
	return out
end

return Data
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000015"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000014"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000013"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Piste Poussière : script client principal (relie menus, course, replay et messages du serveur)

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local StarterGui = game:GetService("StarterGui")

local Shared = RS:WaitForChild("Rallye")
local Config = require(Shared.Config)
local ClientMods = Shared:WaitForChild("Client")
local Ui = require(ClientMods.Ui)
local Hud = require(ClientMods.Hud)
local Menus = require(ClientMods.Menus)
local Drive = require(ClientMods.Drive)
local Replay = require(ClientMods.Replay)

local player = Players.LocalPlayer
local Remotes = Shared:WaitForChild("Remotes")
local Request = Remotes:WaitForChild("Request")
local Push = Remotes:WaitForChild("Push")

workspace.Gravity = Config.G * Config.M

local function req(...)
	local ok, res = pcall(Request.InvokeServer, Request, ...)
	if not ok then warn("[Rallye] " .. tostring(res)) return nil end
	return res
end

local App = {
	profile = nil, vip = false, vipId = 0, cometeId = 0,
	leaderboards = {}, stageReady = {}, lastStage = nil, req = req,
}

function App.startStage(stageId)
	App.lastStage = stageId
	Menus.close()
	local res = req("startStage", stageId, App.profile.car)
	if not res or not res.ok then
		Menus.toast((res and res.msg) or "Départ impossible", Ui.C.red)
		Menus.showTop(true)
	end
end

function App.retry()
	if App.lastStage then App.startStage(App.lastStage) end
end

function App.toHub()
	Drive.stop()
	req("abandon")
	Menus.showTop(true)
end

function App.freeRoam()
	Drive.stop()
	req("freeRoam")
	Menus.showTop(true)
end

function App.replay(data, resultsArg)
	Drive.stop()
	if not data then
		Menus.open("results", resultsArg)
		return
	end
	local paintIdx = App.profile.paints[data.car.id]
	local rgb = paintIdx and Config.PAINTS[paintIdx] and Config.PAINTS[paintIdx].rgb or nil
	Replay.play(data, rgb, function()
		local camera = workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
		Menus.open("results", resultsArg)
	end)
end

-- démarrage
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)
local pg = player:WaitForChild("PlayerGui")
Hud.create(pg)
local init = req("getProfile") or {}
App.profile = init.profile
App.vip = init.vip
App.vipId = init.vipId or 0
App.cometeId = init.cometeId or 0
local status = req("buildStatus") or {}
for id, ok in pairs(status) do App.stageReady[id] = ok end
Menus.init(App)
Menus.open("main")

-- messages du serveur
Push.OnClientEvent:Connect(function(kind, data)
	if kind == "profile" then
		App.profile = data
		Menus.refreshTop()
	elseif kind == "raceStart" then
		Menus.close()
		Menus.showTop(false)
		App.lastStage = data.stageId
		task.spawn(function()
			Drive.start({
				stageId = data.stageId, carId = data.carId, carName = data.carName, startAt = data.startAt, mode = "driver",
				profile = App.profile, copilot = data.copilot, challenge = data.challenge,
				onFinish = function(result, replay)
					Menus.open("results", {result = result, replay = replay})
				end,
			})
			if data.challenge then
				Hud.tip("Défi contre " .. data.challenge.opponent .. " : que le meilleur gagne !", 4)
			end
		end)
	elseif kind == "passengerStart" then
		Menus.close()
		Menus.showTop(false)
		task.spawn(function()
			Drive.start({stageId = data.stageId, carId = data.carId, carName = data.carName, startAt = data.startAt, mode = "passenger",
				profile = App.profile, copilot = player.DisplayName .. " (toi)"})
			Hud.tip("Tu es le copilote de " .. data.driver .. " !", 4)
		end)
	elseif kind == "passengerEnd" then
		Drive.stop()
		Menus.showTop(true)
		Menus.toast("Fin de la course de ton chauffeur")
	elseif kind == "callout" then
		Drive.onCallout(data.from, data.text)
	elseif kind == "copilotName" then
		Drive.setCopilot(data.name)
	elseif kind == "invite" then
		Menus.invite(data)
	elseif kind == "challengeResult" then
		Menus.challengeResult(data)
	elseif kind == "notify" then
		Menus.toast(data.text)
	elseif kind == "stageReady" then
		App.stageReady[data.id] = true
	end
end)

-- panneaux du parc (ProximityPrompt)
ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
	if who ~= player then return end
	local action = prompt:GetAttribute("Action")
	if not action or Drive.active() then return end
	if action == "garage" then Menus.open("garage")
	elseif action == "shop" or action == "crate" then Menus.open("shop")
	elseif action == "contracts" then Menus.open("contracts")
	elseif action == "menu" then Menus.open("main")
	elseif string.sub(action, 1, 6) == "stage:" then
		local id = string.sub(action, 7)
		if App.stageReady[id] then App.startStage(id) else Menus.toast("Étape en construction, patiente un peu…") end
	elseif string.sub(action, 1, 7) == "garage:" then Menus.open("garage", string.sub(action, 8))
	end
end)

-- rafraîchissements
task.spawn(function()
	local n = 0
	while true do
		task.wait(2)
		n = n + 1
		Menus.refreshTop()
		if Drive.active() and n % 2 == 0 then Hud.updatePlayers() end
		if n % 30 == 1 then
			for _, st in ipairs(Config.STAGES) do
				if App.stageReady[st.id] then
					local lb = req("leaderboard", st.id)
					if lb then App.leaderboards[st.id] = lb end
				end
			end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>