]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Physics</string><ProtectedString name="Source"><![CDATA[-- Modèle de conduite (pur : aucune API Roblox, testable hors du jeu)
-- Modèle « bicyclette » à deux essieux avec pneus à saturation, cercle d'adhérence,
-- transfert de charge, frein à main, turbo, hybride et boîte de vitesses.
-- Repère voiture : vF = vitesse avant (m/s), vL = vitesse vers la gauche, r = lacet (rad/s, + = gauche)

local Physics = {}

local G = 9.81
local SHIFT_FRACS = {
	[1] = {1.0},
	[4] = {0.40, 0.70, 0.88, 1.0},
	[5] = {0.36, 0.67, 0.82, 0.92, 1.0},
	[6] = {0.30, 0.52, 0.68, 0.81, 0.92, 1.0},
}
local EFF = 0.82           -- rendement de transmission
local HB_GAIN = 1.8        -- les roues arrière bloquées creusent le gravier
local SHIFT_TIME = 0.18

local function clamp(v, a, b)
	if v < a then return a elseif v > b then return b end
	return v
end
local function sign(v)
	if v > 0 then return 1 elseif v < 0 then return -1 end
	return 0
end
Physics.clamp = clamp

-- prépare les constantes dérivées d'une voiture
function Physics.prepare(car, baseMu, longMu)
	local p = {}
	p.car = car
	p.m = car.kg
	p.L = car.wheelbase or 2.5
	-- a = distance CG -> essieu avant, b = CG -> essieu arrière ; car.rear = part de masse à l'arrière
	p.a = p.L * car.rear
	p.b = p.L - p.a
	p.h = 0.45 + car.travel * 0.4
	p.Iz = p.m * p.a * p.b * 1.05
	p.P = car.ch * 735.5 * EFF
	p.Fmax = car.nm * 40
	p.vmax = car.vmax / 3.6
	p.cd = p.P / (p.vmax * p.vmax * p.vmax)
	p.brake = car.brake or 18
	p.mu = (baseMu or 1.6) * (car.grip or 1)
	p.longMu = longMu or 1.45
	local fr = SHIFT_FRACS[car.gears or 5] or SHIFT_FRACS[5]
	p.tops = {}
	for i, f in ipairs(fr) do p.tops[i] = f * p.vmax end
	p.vrev = p.vmax * 0.43
	p.hybridP = car.hybrid and car.hybrid.ch * 735.5 * EFF or 0
	return p
end

function Physics.newState()
	return {
		vF = 0, vL = 0, r = 0, steer = 0, ax = 0,
		gear = 1, shiftT = 0, rpm = 0.1, reverse = false,
		boost = 0, boost2 = 0, battery = 0.3, hybridOn = false,
		slipR = 0, slipF = 0, spin = 0, manual = false,
		temps = {oil = 40, water = 45, box = 35}, fuel = 1.0,
	}
end

local function tire(alpha)
	-- courbe de pneu : pic vers 12°, retombe à ~85 % en glissade
	return math.sin(1.5 * math.atan(8 * alpha))
end

-- angle de braquage maximal selon la vitesse (clavier)
function Physics.maxSteer(v, sens)
	return (0.58 / (1 + math.abs(v) / 24)) * (sens or 1)
end

-- inp : throttle 0..1, brake 0..1, steer -1..1 (+ = gauche), hb bool, shift (+1/-1/0)
-- surf : gF, gR (adhérence avant / arrière), drag (m/s²), sandF (multiplicateur de drag)
function Physics.step(p, st, inp, surf, dt)
	local car = p.car
	local m = p.m
	local v = math.sqrt(st.vF * st.vF + st.vL * st.vL)

	-- direction progressive
	local target = clamp(inp.steer, -1, 1) * Physics.maxSteer(v, inp.sens)
	local rate = (math.abs(target) > math.abs(st.steer)) and 3.2 or 5.0
	local ds = target - st.steer
	st.steer = st.steer + clamp(ds, -rate * dt, rate * dt)

	-- marche arrière automatique : frein tenu quasi à l'arrêt
	if inp.brake > 0.5 and st.vF < 0.8 and inp.throttle < 0.1 then
		st.reverse = true
	elseif inp.throttle > 0.1 then
		st.reverse = false
	end

	-- boîte de vitesses
	local tops = p.tops
	local ng = #tops
	if st.shiftT > 0 then st.shiftT = st.shiftT - dt end
	local spd = math.abs(st.vF)
	if st.reverse then
		st.gear = -1
	elseif st.manual then
		if st.gear < 1 then st.gear = 1 end
		if inp.shift == 1 and st.gear < ng then st.gear = st.gear + 1; st.shiftT = SHIFT_TIME end
		if inp.shift == -1 and st.gear > 1 then st.gear = st.gear - 1; st.shiftT = SHIFT_TIME * 0.5 end
	else
		if st.gear < 1 then st.gear = 1 end
		local g = st.gear
		if g < ng and spd > tops[g] * 0.985 and inp.throttle > 0.05 then
			st.gear = g + 1; st.shiftT = SHIFT_TIME
		elseif g > 1 then
			local down = tops[g - 1] * ((inp.brake > 0.1 or inp.hb) and 1.17 or 0.8)
			if spd < down then st.gear = g - 1 end
		end
	end
	local gTop = st.gear >= 1 and tops[st.gear] or p.vrev
	local gLow = (st.gear > 1) and tops[st.gear - 1] * 0.55 or 0
	st.rpm = clamp(0.12 + 0.88 * (spd - gLow) / math.max(1, gTop - gLow), 0.12, 1.05)

	-- turbo(s) et hybride
	local thr = inp.throttle
	if car.turbo then
		local want = (thr > 0.3 and st.rpm > 0.35) and 1 or 0
		local k = want > st.boost and dt / car.turbo.lag or dt * 4
		st.boost = st.boost + (want - st.boost) * clamp(k, 0, 1)
		if car.turbo.lag2 then
			local w2 = (want == 1 and st.boost > 0.8 and st.rpm > 0.55) and 1 or 0
			local k2 = w2 > st.boost2 and dt / car.turbo.lag2 or dt * 3
			st.boost2 = st.boost2 + (w2 - st.boost2) * clamp(k2, 0, 1)
		end
	end
	local powerMul = 1
	if car.turbo then
		if car.turbo.lag2 then
			powerMul = 0.38 + 0.32 * st.boost + 0.30 * st.boost2
		else
			powerMul = 0.32 + 0.68 * st.boost
		end
	end
	local P = p.P * powerMul
	st.hybridOn = false
	if car.hybrid and thr > 0.5 and st.battery > 0.02 and spd > 3 then
		P = P + p.hybridP
		st.battery = math.max(0, st.battery - dt * 0.28)
		st.hybridOn = true
	end

	-- force motrice
	local Fdrive = 0
	if st.reverse then
		if inp.brake > 0.1 then
			Fdrive = -inp.brake * math.min(p.Fmax * 0.7, P / math.max(spd, 5)) * (1 - clamp(-st.vF / p.vrev, 0, 1))
		end
	elseif thr > 0 and st.shiftT <= 0 then
		local lim = 1
		if spd >= gTop then lim = 0 end
		if st.manual and st.gear > 1 and spd < gLow then lim = 0.45 end
		Fdrive = thr * math.min(p.Fmax, P / math.max(spd, 3)) * lim
	end
	-- frein moteur au lever de pied
	if thr < 0.05 and not st.reverse and spd > 1 then
		Fdrive = Fdrive - sign(st.vF) * m * (0.7 + 0.6 * st.rpm)
	end

	-- freins de service (pas en marche arrière)
	local Fbrake = 0
	if inp.brake > 0 and not st.reverse and st.vF > 0.3 then
		Fbrake = inp.brake * p.brake * m
		if car.hybrid then st.battery = math.min(1, st.battery + dt * 0.35 * inp.brake * clamp(spd / 20, 0, 1)) end
	end

	-- charges sur les essieux (transfert)
	local Fz = m * G
	local Fzf = clamp(Fz * p.b / p.L - m * st.ax * p.h / p.L, 0.15 * Fz, 0.85 * Fz)
	local Fzr = Fz - Fzf

	local muF = p.mu * surf.gF
	local muR = p.mu * surf.gR

	-- forces longitudinales par essieu (repère roue)
	local front = car.front
	local FxF = Fdrive * front - Fbrake * 0.65 * sign(st.vF)
	local FxR = Fdrive * (1 - front) - Fbrake * 0.35 * sign(st.vF)
	local hbOn = inp.hb and spd > 0.5
	if hbOn then
		FxR = -sign(st.vF) * muR * Fzr * HB_GAIN
	end
	local capF = muF * p.longMu * Fzf
	local capR = muR * p.longMu * Fzr * (hbOn and HB_GAIN or 1)
	-- patinage : si la demande dépasse l'adhérence, la force retombe et consomme le latéral
	local spinR = math.abs(FxR) > capR
	local spinF = math.abs(FxF) > capF
	FxF = clamp(FxF, -capF, capF)
	FxR = clamp(FxR, -capR, capR)
	st.spin = (spinR or spinF) and 1 or 0

	-- vitesses aux roues
	local d = st.steer
	local cd, sd = math.cos(d), math.sin(d)
	local vyF = st.vL + p.a * st.r
	local vyR = st.vL - p.b * st.r
	local wlF = st.vF * cd + vyF * sd
	local wtF = -st.vF * sd + vyF * cd
	local alphaF = math.atan2(wtF, math.max(math.abs(wlF), 1.5))
	local alphaR = math.atan2(vyR, math.max(math.abs(st.vF), 1.5))
	st.slipF, st.slipR = alphaF, alphaR

	-- forces latérales avec cercle d'adhérence
	local function lat(alpha, mu, fz, fx, cap, kill)
		local maxY = mu * fz
		local used = cap > 0 and math.abs(fx) / cap or 0
		local rem = math.sqrt(math.max(0, 1 - used * used))
		return -maxY * tire(alpha) * math.max(rem, kill)
	end
	local FyF = lat(alphaF, muF, Fzf, FxF, capF, 0.25)
	local FyR = lat(alphaR, muR, Fzr, FxR, capR, hbOn and 0.5 or (spinR and 0.35 or 0.3))
	if hbOn then FyR = FyR * 0.95 end

	-- retour au repère voiture
	local FxFc = FxF * cd - FyF * sd
	local FyFc = FxF * sd + FyF * cd

	-- résistances
	local drag = p.cd * st.vF * math.abs(st.vF)
	local roll = m * (surf.drag or 0) * clamp(math.abs(st.vF) / 3, 0, 1) * sign(st.vF)
	-- frottement latéral supplémentaire sur bas-côtés
	local sideRoll = m * (surf.drag or 0) * 0.3 * clamp(math.abs(st.vL) / 3, 0, 1) * sign(st.vL)

	local FxTot = FxFc + FxR - drag - roll
	local FyTot = FyFc + FyR - sideRoll

	local axNew = FxTot / m
	local ay = FyTot / m
	local yawAcc = (p.a * FyFc - p.b * FyR) / p.Iz
	-- stabilité des 4x4 à haute vitesse
	if front > 0 and front < 1 then yawAcc = yawAcc - st.r * clamp(spd / 30, 0, 1) * 0.8 end

	st.vF = st.vF + (axNew + st.vL * st.r) * dt
	st.vL = st.vL + (ay - st.vF * st.r) * dt
	st.r = st.r + yawAcc * dt
	-- arcade : rotation plafonnée (~110°/s mesuré en épingle) et amortie quand l'arrière glisse
	if math.abs(alphaR) > 0.35 then st.r = st.r * (1 - clamp(dt * 2.5, 0, 1)) end
	st.r = clamp(st.r, -1.95, 1.95)

	-- basse vitesse : modèle cinématique pour éviter les oscillations
	local blend = clamp((v - 1.5) / 3, 0, 1)
	if blend < 1 then
		local rKin = st.vF * math.tan(st.steer) / p.L
		st.r = st.r * blend + rKin * (1 - blend)
		st.vL = st.vL * (0.6 + 0.4 * blend)
	end
	-- arrêt net
	if math.abs(st.vF) < 0.25 and thr < 0.05 and inp.brake < 0.05 then
		st.vF = st.vF * 0.85
	end
	st.ax = st.ax + (axNew - st.ax) * clamp(dt * 8, 0, 1)

	-- tableau de bord : températures et carburant
	local t = st.temps
	t.oil = t.oil + ((70 + 40 * st.rpm * thr) - t.oil) * dt * 0.05
	t.water = t.water + ((82 + 12 * st.rpm) - t.water) * dt * 0.08
	t.box = t.box + ((60 + 30 * thr) - t.box) * dt * 0.03
	st.fuel = math.max(0.05, st.fuel - dt * thr * 0.0008)
end

-- avance sans adhérence (en l'air) : la direction et le régime évoluent quand même
function Physics.air(p, st, inp, dt)
	local target = clamp(inp.steer, -1, 1) * Physics.maxSteer(0)
	st.steer = st.steer + clamp(target - st.steer, -4 * dt, 4 * dt)
	if inp.throttle > 0.5 then st.rpm = math.min(1.05, st.rpm + dt * 2) else st.rpm = math.max(0.12, st.rpm - dt) end
end

function Physics.gearLabel(st)
	if st.gear == -1 then return "R" end
	if math.abs(st.vF) < 0.3 then return "N" end
	return tostring(st.gear)
end

return Physics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Track</string><ProtectedString name="Source"><![CDATA[-- Génération du tracé d'une étape (pur : aucune API Roblox)
-- Le même code tourne sur le serveur (construction) et sur le client (copilote, chrono, pénalités).

local Config = require(script.Parent.Config)

local Track = {}
local STEP = Config.STEP
local HALF = Config.HALF

-- générateur pseudo-aléatoire déterministe
function Track.rng(seed)
	local s = (seed % 2147483646) + 1
	return function(a, b)
		s = (s * 16807) % 2147483647
		local r = (s - 1) / 2147483646
		if a then return a + (b - a) * r end
		return r
	end
end

local function lerp(a, b, t) return a + (b - a) * t end

local function elevAt(elev, d)
	if d <= elev[1][1] then return elev[1][2] end
	for i = 1, #elev - 1 do
		local a, b = elev[i], elev[i + 1]
		if d <= b[1] then
			local t = (d - a[1]) / (b[1] - a[1])
			t = (1 - math.cos(t * math.pi)) / 2
			return lerp(a[2], b[2], t)
		end
	end
	return elev[#elev][2]
end

local function gradeOf(radius, angle)
	local g
	if radius >= 120 then g = 6 elseif radius >= 80 then g = 5 elseif radius >= 55 then g = 4
	elseif radius >= 38 then g = 3 elseif radius >= 24 then g = 2 else g = 1 end
	if angle < 25 and g < 6 then g = g + 1 end
	return g
end
Track.gradeOf = gradeOf

local HAZARDS = {
	saut = {text = "Crête", tip = "Crête : relâchez, gardez le droit"},
	gue = {text = "Gué", tip = "Gué : levez le pied, la boue glisse"},
	pont = {text = "Pont", tip = "Pont étroit : restez au centre"},
	pontCouvert = {text = "Pont couvert", tip = "Pont étroit : restez au centre"},
	tunnel = {text = "Tunnel", tip = "Tunnel : gardez la ligne"},
	congeres = {text = "Congères", tip = "Congères : appuyez-vous dessus, sans prendre trop large"},
	lac = {text = "Glace !", tip = "Glace : gestes doux, longues glissades"},
	arche = {text = "Arche", tip = nil},
	plage = {text = "Sable", tip = "Sable : gardez de l'élan"},
}
Track.HAZARDS = HAZARDS

function Track.generate(stage)
	local S = {}
	local x, z, h = 0, 0, 0
	local d = 0
	local surf = "Ground"
	local deco = stage.deco
	local corners = {}
	local features = {}

	local function push(curv, feat, cornerId)
		local s = {x = x, y = 0, z = z, h = h, d = d, surf = surf, curv = curv, feat = feat, corner = cornerId, deco = deco}
		S[#S + 1] = s
	end
	push(0, nil, nil)

	local function addFeature(f, d0, d1)
		if not f then return end
		local last = features[#features]
		if last and last.kind == f and math.abs(last.d1 - d0) < 0.01 then
			last.d1 = d1
		else
			features[#features + 1] = {kind = f, d0 = d0, d1 = d1}
		end
	end

	local path = {}
	for _, c in ipairs(stage.path) do path[#path + 1] = c end
	path[#path + 1] = {"S", 70} -- dégagement après l'arrivée

	for _, c in ipairs(path) do
		local k = c[1]
		if k == "surf" then
			surf = c[2]
		elseif k == "deco" then
			deco = c[2]
		elseif k == "S" then
			local n = math.max(1, math.floor(c[2] / STEP + 0.5))
			local d0 = d
			for _ = 1, n do
				x = x + math.sin(h) * STEP
				z = z + math.cos(h) * STEP
				d = d + STEP
				push(0, c.f, nil)
			end
			addFeature(c.f, d0, d)
		else
			local dir, angle, radius, hairpin
			if k == "HL" or k == "HR" then
				dir = (k == "HL") and 1 or -1
				angle, radius, hairpin = 175, 9, true
			else
				dir = (k == "L") and 1 or -1
				angle, radius = c[2], c[3]
			end
			local arc = math.rad(angle) * radius
			local n = math.max(1, math.floor(arc / STEP + 0.5))
			local dh = math.rad(angle) / n * dir
			local stepLen = arc / n
			local id = #corners + 1
			local d0 = d
			local i0 = #S + 1
			for _ = 1, n do
				-- intégration au point milieu pour suivre l'arc
				local hm = h + dh / 2
				x = x + math.sin(hm) * stepLen
				z = z + math.cos(hm) * stepLen
				h = h + dh
				d = d + stepLen
				push(dir / radius, c.f, id)
			end
			corners[id] = {id = id, dir = dir, angle = angle, radius = radius, hairpin = hairpin,
				d0 = d0, d1 = d, i0 = i0, i1 = #S, grade = gradeOf(radius, angle)}
			addFeature(c.f, d0, d)
		end
	end

	-- altitude
	for _, s in ipairs(S) do s.y = elevAt(stage.elev, s.d) end
	for _, f in ipairs(features) do
		if f.kind == "saut" then
			-- crête : montée douce puis rupture nette => la voiture décolle
			local peak = f.d0 + (f.d1 - f.d0) * 0.6
			for _, s in ipairs(S) do
				local u = s.d - peak
				if u > -18 and u <= 0 then
					s.y = s.y + 2.4 * (1 - math.cos((u + 18) / 18 * math.pi)) / 2
				elseif u > 0 and u < 10 then
					s.y = s.y + 2.4 * (1 - u / 10) ^ 2
				end
			end
		elseif f.kind == "pont" or f.kind == "pontCouvert" or f.kind == "lac" then
			local y0, y1
			for _, s in ipairs(S) do
				if s.d >= f.d0 and not y0 then y0 = s.y end
				if s.d <= f.d1 then y1 = s.y end
			end
			for _, s in ipairs(S) do
				if s.d >= f.d0 and s.d <= f.d1 then
					s.y = lerp(y0, y1, (s.d - f.d0) / math.max(1, f.d1 - f.d0))
				end
			end
		end
	end

	-- vecteurs gauche
	for _, s in ipairs(S) do
		s.nx, s.nz = math.cos(s.h), -math.sin(s.h)
	end

	local T = {stage = stage, S = S, corners = corners, features = features}
	T.length = d
	T.finishD = d - 60
	T.startD = Config.START_D
	T.startIdx = math.floor(Config.START_D / STEP) + 1
	T.finishIdx = 1
	for i, s in ipairs(S) do
		if s.d <= T.finishD then T.finishIdx = i end
	end
	T.stageLength = T.finishD - T.startD

	-- points de passage
	local nCP = math.max(4, math.floor(T.stageLength / 125 + 0.5))
	T.cps = {}
	for k = 1, nCP do
		local cd = T.startD + T.stageLength * k / (nCP + 1)
		T.cps[k] = Track.indexAtD(T, cd)
	end

	-- pièces
	local rnd = Track.rng(stage.seed)
	T.coins = {}
	local span = T.finishD - 40 - 60
	for k = 1, stage.coins do
		local cd = 60 + (k - 0.5) * span / stage.coins
		local i = Track.indexAtD(T, cd)
		local s = S[i]
		local off = rnd(-2.6, 2.6)
		T.coins[k] = {i = i, x = s.x + s.nx * off, y = s.y + 1.3, z = s.z + s.nz * off}
	end

	Track.buildNotes(T)
	T.par = Track.parTime(T)
	T.medals = {}
	for _, m in ipairs(Config.MEDALS) do
		T.medals[m] = math.floor(T.par * Config.MEDAL_FACTORS[m] * 2 + 0.5) / 2
	end
	return T
end

function Track.indexAtD(T, d)
	local i = math.floor(d / STEP) + 1
	local S = T.S
	i = math.max(1, math.min(#S, i))
	while i < #S and S[i + 1].d <= d do i = i + 1 end
	while i > 1 and S[i].d > d do i = i - 1 end
	return i
end

-- annonces du copilote
function Track.buildNotes(T)
	local notes = {}
	for _, c in ipairs(T.corners) do
		if c.angle >= 12 then
			local dirTxt = c.dir == 1 and "Gauche" or "Droite"
			local n = {d = c.d0, dEnd = c.d1, kind = "corner", dir = c.dir, grade = c.grade, corner = c.id}
			if c.hairpin then
				n.text = "Épingle " .. string.lower(dirTxt)
				n.label = "DIFFICILE"
				n.tight = true
				n.tip = "Épingle : freinez tôt, puis utilisez le frein à main"
				n.hairpin = true
			else
				n.text = dirTxt .. " " .. c.grade
				if c.angle >= 100 and c.grade <= 3 then n.text = n.text .. " long" end
				if c.grade >= 5 then n.label = "LÉGER"
				elseif c.grade <= 2 then n.label = "DIFFICILE"; n.tight = true
				else n.label = "" end
			end
			notes[#notes + 1] = n
		end
	end
	for _, f in ipairs(T.features) do
		local hz = HAZARDS[f.kind]
		if hz then
			notes[#notes + 1] = {d = f.d0, dEnd = f.d1, kind = "hazard", text = hz.text, label = "DANGER", tip = hz.tip, danger = true, feat = f.kind}
		end
	end
	table.sort(notes, function(a, b) return a.d < b.d end)
	-- enchaînements et lignes droites
	local out = {}
	for i, n in ipairs(notes) do
		local nx = notes[i + 1]
		if nx and n.kind == "corner" and nx.kind == "corner" and nx.d - n.dEnd < 25 then
			n.puis = nx.text
		end
		out[#out + 1] = n
		local nextD = nx and nx.d or T.finishD
		if n.kind == "corner" and nextD - n.dEnd > 110 then
			out[#out + 1] = {d = n.dEnd + 5, dEnd = nextD, kind = "flat", text = "À fond", label = "", dir = 0}
		end
	end
	T.notes = out
end

-- prochaine annonce à partir de la distance d (avec anticipation en mètres)
function Track.noteAt(T, d, ahead)
	for _, n in ipairs(T.notes) do
		if n.dEnd >= d and n.d <= d + ahead then return n end
		if n.d > d + ahead then break end
	end
	return nil
end

-- échantillon le plus proche (recherche locale autour de hint)
function Track.nearest(T, px, pz, hint)
	local S = T.S
	local best, bd = hint or 1, math.huge
	local i0, i1 = 1, #S
	if hint then i0 = math.max(1, hint - 25); i1 = math.min(#S, hint + 45) end
	for i = i0, i1 do
		local s = S[i]
		local dx, dz = px - s.x, pz - s.z
		local dd = dx * dx + dz * dz
		if dd < bd then bd = dd; best = i end
	end
	if hint and bd > 900 then return Track.nearest(T, px, pz, nil) end
	local s = S[best]
	local lat = (px - s.x) * s.nx + (pz - s.z) * s.nz
	return best, lat, s
end

-- temps de référence (passe avant/arrière sur la vitesse limite de chaque échantillon)
function Track.parTime(T)
	local S = T.S
	local mu, g = Config.BASE_MU, Config.G
	local m, P, vmax = 1090, 470 * 735.5 * 0.82, 195 / 3.6
	local cd = P / (vmax ^ 3)
	local n = #S
	local cap = {}
	for i = 1, n do
		local s = S[i]
		local sf = Config.SURFACES[s.surf] or Config.DEFAULT_SURFACE
		local c = vmax
		if s.curv ~= 0 then c = math.min(c, math.sqrt(mu * sf.grip * g * 0.9 / math.abs(s.curv))) end
		if s.feat == "saut" then c = math.min(c, 30) end
		cap[i] = c
	end
	local v = {}
	v[1] = 0
	for i = 2, n do
		local sf = Config.SURFACES[S[i].surf] or Config.DEFAULT_SURFACE
		local pv = v[i - 1]
		local a = math.min(mu * sf.grip * g, P / (m * math.max(pv, 3))) - cd * pv * pv / m - sf.drag
		v[i] = math.min(cap[i], math.sqrt(math.max(0, pv * pv + 2 * math.max(a, 0.2) * STEP)))
	end
	for i = n - 1, 1, -1 do
		local sf = Config.SURFACES[S[i].surf] or Config.DEFAULT_SURFACE
		local a = mu * sf.grip * g * 1.25
		v[i] = math.min(v[i], math.sqrt(v[i + 1] ^ 2 + 2 * a * STEP))
	end
	local t = 0
	for i = 2, n do
		local s = S[i]
		if s.d > T.startD and s.d <= T.finishD then
			local dd = s.d - S[i - 1].d
			t = t + dd / math.max(1, (v[i] + v[i - 1]) / 2)
		end
	end
	return t
end

-- distance minimale entre deux portions éloignées du tracé (contrôle des croisements)
function Track.selfCheck(T)
	local S = T.S
	local minD, at = math.huge, nil
	for i = 1, #S, 2 do
		for j = i + 40, #S, 2 do
			local dx, dz = S[i].x - S[j].x, S[i].z - S[j].z
			local dd = math.sqrt(dx * dx + dz * dz)
			if dd < minD then minD = dd; at = {i, j} end
		end
	end
	return minD, at
end

function Track.bounds(T)
	local x0, x1, z0, z1, y0, y1 = math.huge, -math.huge, math.huge, -math.huge, math.huge, -math.huge
	for _, s in ipairs(T.S) do
		x0 = math.min(x0, s.x); x1 = math.max(x1, s.x)
		z0 = math.min(z0, s.z); z1 = math.max(z1, s.z)
		y0 = math.min(y0, s.y); y1 = math.max(y1, s.y)
	end
	return x0, x1, z0, z1, y0, y1
end

return Track
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000000A"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Drive</string><ProtectedString name="Source"><![CDATA[-- Session de course côté client : pilotage (suspension par rayons + modèle de pneus),
-- caméra, chrono, points de passage, pénalités, copilote, dégâts, fantôme et enregistrement du replay.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local RS = game:GetService("ReplicatedStorage")

local Shared = RS:WaitForChild("Rallye")
local Config = require(Shared.Config)
local Track = require(Shared.Track)
local Physics = require(Shared.Physics)
local Cars = require(Shared.Cars)
local Hud = require(script.Parent.Hud)
local Ui = require(script.Parent.Ui)

local Drive = {}
local player = Players.LocalPlayer
local M = Config.M
local HALF = Config.HALF
local camera = workspace.CurrentCamera

local trackCache = {}
function Drive.track(stageId)
	if not trackCache[stageId] then trackCache[stageId] = Track.generate(Config.STAGE_BY_ID[stageId]) end
	return trackCache[stageId]
end

function Drive.origin(stageId)
	local f = workspace:WaitForChild("Rallye"):WaitForChild("Stages"):WaitForChild(stageId, 60)
	if not f then return nil end
	while not f:GetAttribute("Ready") do task.wait(0.2) end
	return Vector3.new(f:GetAttribute("OriginX"), f:GetAttribute("OriginY"), f:GetAttribute("OriginZ")), f
end

local ghosts = {} -- meilleur passage de la session par étape+voiture

local input = {gas = 0, brake = 0, left = 0, right = 0, stickX = nil, hb = false, shift = 0}
local S = nil -- session en cours

local function setControls(on)
	local ok, pm = pcall(function() return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")) end)
	if ok and pm then
		local controls = pm:GetControls()
		if on then controls:Enable() else controls:Disable() end
	end
end

local function hum()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

---------------------------------------------------------------------------
-- commandes
---------------------------------------------------------------------------
local SINK = Enum.ContextActionResult.Sink
local PASS = Enum.ContextActionResult.Pass
local K = Enum.KeyCode

local function bindAll()
	local function axis(name, field, keys)
		CAS:BindActionAtPriority(name, function(_, state, obj)
			if obj.KeyCode == K.ButtonR2 or obj.KeyCode == K.ButtonL2 then
				input[field] = math.clamp(obj.Position.Z, 0, 1)
			else
				input[field] = (state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change) and 1 or 0
			end
			return SINK
		end, name ~= "RallyeLeft" and name ~= "RallyeRight", 3000, table.unpack(keys))
	end
	axis("RallyeGas", "gas", {K.W, K.Z, K.Up, K.ButtonR2})
	axis("RallyeBrake", "brake", {K.S, K.Down, K.ButtonL2})
	axis("RallyeLeft", "left", {K.A, K.Q, K.Left})
	axis("RallyeRight", "right", {K.D, K.Right})
	CAS:BindActionAtPriority("RallyeHB", function(_, state)
		input.hb = state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change
		return SINK
	end, true, 3000, K.Space, K.ButtonX, K.ButtonR1)
	CAS:BindActionAtPriority("RallyeStick", function(_, _, obj)
		local x = obj.Position.X
		input.stickX = math.abs(x) > 0.12 and x or nil
		return SINK
	end, false, 3000, K.Thumbstick1)
	CAS:BindActionAtPriority("RallyeKeys", function(_, state, obj)
		if state ~= Enum.UserInputState.Begin or not S then return PASS end
		local kc = obj.KeyCode
		if kc == K.R or kc == K.ButtonY then Drive.recover(true)
		elseif kc == K.C or kc == K.ButtonR3 then Drive.cycleCamera()
		elseif kc == K.M or kc == K.Semicolon then
			if S.st then
				S.st.manual = not S.st.manual
				Hud.tip(S.st.manual and "Boîte manuelle : E / Maj = monter, F / Ctrl = descendre" or "Boîte automatique", 3)
			end
		elseif kc == K.E or kc == K.LeftShift or kc == K.ButtonB then input.shift = 1
		elseif kc == K.F or kc == K.LeftControl or kc == K.ButtonL1 then input.shift = -1
		elseif kc == K.Return and S.state == "finished" and S.onSkip then S.onSkip()
		elseif kc == K.One then Drive.sendCallout("Serré !")
		elseif kc == K.Two then Drive.sendCallout("À fond !")
		elseif kc == K.Three then Drive.sendCallout("Freine !")
		elseif kc == K.Four then Drive.sendCallout("Bien joué !")
		else return PASS end
		return SINK
	end, false, 3000, K.R, K.C, K.M, K.Semicolon, K.E, K.F, K.LeftShift, K.LeftControl, K.Return, K.ButtonY, K.ButtonR3, K.ButtonB, K.ButtonL1,
		K.One, K.Two, K.Three, K.Four)
	CAS:BindActionAtPriority("RallyeRestart", function(_, state)
		if not S then return PASS end
		if state == Enum.UserInputState.Begin then
			S.restartHold = os.clock()
		elseif state == Enum.UserInputState.End then
			S.restartHold = nil
		end
		return SINK
	end, false, 3000, K.Backspace, K.ButtonSelect)
	pcall(function()
		CAS:SetTitle("RallyeGas", "Gaz")
		CAS:SetTitle("RallyeBrake", "Frein")
		CAS:SetTitle("RallyeHB", "FàM")
		CAS:SetPosition("RallyeGas", UDim2.new(1, -95, 1, -170))
		CAS:SetPosition("RallyeBrake", UDim2.new(1, -175, 1, -110))
		CAS:SetPosition("RallyeHB", UDim2.new(1, -95, 1, -250))
	end)
	-- direction tactile : deux grandes zones à gauche de l'écran
	if UIS.TouchEnabled then
		local pg = player:WaitForChild("PlayerGui")
		local tg = Ui.make("ScreenGui", {Name = "RallyeTouch", ResetOnSpawn = false, Parent = pg})
		for _, side in ipairs({{"left", 0, "◀"}, {"right", 1, "▶"}}) do
			local b = Ui.make("TextButton", {Size = UDim2.fromOffset(90, 90), Position = UDim2.new(0, 20 + side[2] * 100, 1, -120), Text = side[3],
				BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.7, TextSize = 36, Parent = tg})
			Ui.corner(b, 45)
			b.InputBegan:Connect(function() input[side[1]] = 1 end)
			b.InputEnded:Connect(function() input[side[1]] = 0 end)
		end
		S.touchGui = tg
	end
end

local function unbindAll()
	for _, n in ipairs({"RallyeGas", "RallyeBrake", "RallyeLeft", "RallyeRight", "RallyeHB", "RallyeStick", "RallyeKeys", "RallyeRestart"}) do
		CAS:UnbindAction(n)
	end
	for k in pairs(input) do input[k] = 0 end
	input.hb = false
	input.stickX = nil
end

---------------------------------------------------------------------------
-- caméra
---------------------------------------------------------------------------
local CAM_NAMES = {"Poursuite", "Capot", "Cockpit"}
function Drive.cycleCamera()
	if not S then return end
	S.camMode = S.camMode % 3 + 1
	Hud.tip("Caméra : " .. CAM_NAMES[S.camMode], 1.5)
end

local function setCharVisible(visible)
	local c = player.Character
	if not c then return end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = visible and 0 or 1 end
	end
end

local function updateCamera(dt)
	local ch = S.model and S.model.PrimaryPart
	if not ch then return end
	camera.CameraType = Enum.CameraType.Scriptable
	local cf = ch.CFrame
	local speed = ch.AssemblyLinearVelocity.Magnitude / M
	camera.FieldOfView = 68 + math.clamp(speed / 50, 0, 1) * 12
	if S.camMode == 1 then
		local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if flatLook.Magnitude < 0.1 then flatLook = Vector3.new(0, 0, -1) end
		flatLook = flatLook.Unit
		local blended = S.camLook and S.camLook:Lerp(flatLook, math.clamp(dt * 4, 0, 1)) or flatLook
		S.camLook = blended.Magnitude > 0.05 and blended.Unit or flatLook
		local target = cf.Position - S.camLook * 7.5 * M + Vector3.new(0, 2.6 * M, 0)
		S.camPos = S.camPos and S.camPos:Lerp(target, math.clamp(dt * 8, 0, 1)) or target
		camera.CFrame = CFrame.lookAt(S.camPos, cf.Position + S.camLook * 3 * M + Vector3.new(0, 0.8 * M, 0))
		setCharVisible(true)
	elseif S.camMode == 2 then
		camera.CFrame = cf * CFrame.new(0, 0.9 * M, -1.0 * M) * CFrame.Angles(math.rad(-3), 0, 0)
		setCharVisible(true)
	else
		local eye = ch:FindFirstChild("Eye")
		local base = eye and eye.WorldCFrame or cf * CFrame.new(0, 1 * M, 0)
		-- regarder autour à la souris (clic droit maintenu)
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			local d = UIS:GetMouseDelta()
			S.lookYaw = math.clamp((S.lookYaw or 0) - d.X * 0.004, -2.2, 2.2)
			S.lookPitch = math.clamp((S.lookPitch or 0) - d.Y * 0.004, -0.6, 0.5)
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		else
			S.lookYaw = (S.lookYaw or 0) * (1 - math.clamp(dt * 5, 0, 1))
			S.lookPitch = (S.lookPitch or 0) * (1 - math.clamp(dt * 5, 0, 1))
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
		camera.CFrame = base * CFrame.Angles(0, S.lookYaw, 0) * CFrame.Angles(S.lookPitch - math.rad(4), 0, 0)
		setCharVisible(false)
	end
	if S.gloveParts then
		for _, g in ipairs(S.gloveParts) do g.LocalTransparencyModifier = (S.camMode == 3) and 0 or 1 end
	end
	if S.dashGui then S.dashGui.Enabled = S.camMode == 3 end
end

---------------------------------------------------------------------------
-- tableau de bord du cockpit et gants
---------------------------------------------------------------------------
local function buildCockpit(model, gloveId)
	local dash = model:FindFirstChild("Dash")
	if dash then
		local sg = Ui.make("SurfaceGui", {Face = Enum.NormalId.Back, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 60,
			LightInfluence = 0, Parent = dash})
		local bg = Ui.make("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(14, 14, 16), Parent = sg})
		local function cell(x, w, big)
			return Ui.make("TextLabel", {Position = UDim2.fromScale(x, 0.05), Size = UDim2.fromScale(w, 0.9), TextScaled = true, Font = big and Enum.Font.GothamBlack or Enum.Font.GothamBold,
				TextColor3 = big and Color3.fromRGB(255, 205, 60) or Color3.fromRGB(150, 230, 160), Parent = bg})
		end
		S.dash = {
			speed = cell(0.02, 0.16, true), gear = cell(0.19, 0.12, true), time = cell(0.32, 0.2),
			temps = cell(0.53, 0.26), hdg = cell(0.8, 0.18),
		}
		S.dashGui = sg
	end
	local wheel = model:FindFirstChild("SteeringWheel")
	if wheel then
		local g = Config.GLOVES[1]
		for _, gl in ipairs(Config.GLOVES) do if gl.id == gloveId then g = gl end end
		S.gloveParts = {}
		for _, sx in ipairs({-1, 1}) do
			local p = Instance.new("Part")
			p.Size = Vector3.new(0.13, 0.13, 0.2) * M
			p.Color = Ui.rgb(g.rgb)
			p.Material = Enum.Material.Fabric
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			p.CFrame = wheel.CFrame * CFrame.new(sx * 0.17 * M, 0.05 * M, -0.05 * M)
			local w = Instance.new("WeldConstraint")
			w.Part0 = wheel
			w.Part1 = p
			w.Parent = p
			p.Parent = model
			table.insert(S.gloveParts, p)
		end
	end
end

---------------------------------------------------------------------------
-- démarrage d'une session
---------------------------------------------------------------------------
local Remotes = Shared:WaitForChild("Remotes")
local Request = Remotes:WaitForChild("Request")

local function req(...)
	local ok, res = pcall(Request.InvokeServer, Request, ...)
	if ok then return res end
	return nil
end

local function applyLighting(stage)
	local sky = stage.sky
	Lighting.ClockTime = sky.clock
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then
		atm.Color = Ui.rgb(sky.fog)
		atm.Decay = Ui.rgb(sky.fog)
	end
	Lighting.OutdoorAmbient = Ui.rgb(sky.ambient)
end

local function makeCoins(T, origin, collected)
	local folder = Instance.new("Folder")
	folder.Name = "Coins"
	folder.Parent = workspace
	local list = {}
	for k, c in ipairs(T.coins) do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.25, 1.3, 1.3) * M
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 200, 40)
		p.Transparency = collected[tostring(k)] and 0.6 or 0
		local pos = origin + Vector3.new(c.x, c.y, c.z) * M
		p.CFrame = CFrame.new(pos)
		p.Parent = folder
		list[k] = {part = p, pos = pos, got = false}
	end
	return folder, list
end

-- opts : stageId, carId, carName, startAt, mode ("driver" | "passenger"), profile, challenge, copilot, onFinish(result, replay)
function Drive.start(opts)
	if S then Drive.stop() end
	local stage = Config.STAGE_BY_ID[opts.stageId]
	local car = Config.CAR_BY_ID[opts.carId]
	local T = Drive.track(opts.stageId)
	local origin = Drive.origin(opts.stageId)
	local carsFolder = workspace:WaitForChild("Rallye"):WaitForChild("Cars")
	local model = carsFolder:WaitForChild(opts.carName, 15)
	if not model or not origin then
		Hud.tip("Impossible de charger la voiture", 3)
		return
	end
	local prof = opts.profile or {}
	local settings = prof.settings or {}

	S = {
		opts = opts, stage = stage, car = car, T = T, origin = origin, model = model, mode = opts.mode or "driver",
		state = "countdown", startAt = opts.startAt, raw = 0, pen = 0, cpIdx = 0, cpTimes = {}, idx = 1, d = 0,
		camMode = settings.camera or 1, sens = settings.sens or 1, hints = settings.hints ~= false,
		damage = 0, mud = 0, crashes = 0, cutCorner = nil, cutT = 0, cuts = 0, airT = 0, flipT = 0,
		lastNote = nil, frames = {}, recT = 0, lastSpeed = 0, hairpins = 0,
		bestSplits = prof.best and prof.best[opts.stageId] and prof.best[opts.stageId].splits or nil,
		wheels = {}, compress = {},
	}
	S.p = Physics.prepare(car, Config.BASE_MU, Config.LONG_MU)
	S.p.L = Cars.shapeOf(car).wb
	S.p.a = S.p.L * car.rear
	S.p.b = S.p.L - S.p.a
	S.p.Iz = S.p.m * S.p.a * S.p.b * 1.05
	S.st = Physics.newState()
	S.st.manual = settings.manual == true

	applyLighting(stage)
	Hud.show(true)
	Hud.buildMap(T)
	Hud.setCP("PP 0/" .. #T.cps)
	Hud.setCall(nil)
	Hud.setCracks(0, false)
	Hud.setMud(0, false)
	Hud.setCopilot(opts.copilot and ("Copilote : " .. opts.copilot) or "")
	if S.mode == "passenger" then
		Hud.setHelp("Tu es copilote ! 1 = Serré · 2 = À fond · 3 = Freine · 4 = Bien joué — annonce les virages à ton chauffeur")
	else
		Hud.setHelp("Z/W gaz · S frein/arrière · Q/A D direction · Espace frein à main · R dernier PP · Retour arrière (maintenir) recommencer · C caméra · M boîte manuelle")
	end
	Hud.updatePlayers()

	-- roues et suspension
	for _, w in ipairs(Cars.wheelMounts(model)) do
		local wp = model:FindFirstChild("Wheel" .. w.name)
		local joint = wp and wp:FindFirstChild("Joint" .. w.name)
		table.insert(S.wheels, {name = w.name, pos = w.pos, front = w.front, part = wp, joint = joint, base = joint and joint.C0, x = 0, spin = 0, grounded = false})
	end
	S.rad = model:GetAttribute("WheelRadius") or 1
	local freq = car.freq or 1.4
	S.k = (2 * math.pi * freq) ^ 2
	S.c = 2 * 0.55 * math.sqrt(S.k)
	S.sag = workspace.Gravity / S.k
	S.travel = car.travel * M
	S.restLen = 2 * S.rad + S.sag
	S.rayLen = S.restLen + 0.35 * M + S.travel * 0.5

	S.ray = RaycastParams.new()
	S.ray.FilterType = Enum.RaycastFilterType.Exclude
	S.ray.IgnoreWater = true
	S.ray.FilterDescendantsInstances = {carsFolder, workspace:FindFirstChild("Coins") or carsFolder}
	S.charFilterT = 0

	if S.mode == "driver" then
		buildCockpit(model, prof.gloves)
		local coinFolder, coins = makeCoins(T, origin, (prof.coins and prof.coins[opts.stageId]) or {})
		S.coinFolder, S.coins = coinFolder, coins
		setControls(false)
		local h = hum()
		if h then
			h:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		end
		bindAll()
		-- fantôme du meilleur passage de la session
		local gk = opts.stageId .. "/" .. opts.carId
		if settings.ghost ~= false and ghosts[gk] then
			local g = Cars.build(car, nil, {anchored = true, ghost = true})
			g.Name = "Fantome"
			g.Parent = workspace
			S.ghost = {model = g, frames = ghosts[gk].frames}
		end
	else
		S.camMode = 1
		bindAll()
	end

	-- feux de départ (locaux)
	local _, folder = Drive.origin(opts.stageId)
	S.gantry = folder and folder:FindFirstChild("StartGantry")

	S.conn = RunService.Heartbeat:Connect(function(dt) Drive.step(math.min(dt, 1 / 20)) end)
	S.camConn = RunService:BindToRenderStep("RallyeCam", Enum.RenderPriority.Camera.Value + 1, function(dt) if S then updateCamera(dt) end end)
end

function Drive.stop()
	if not S then return end
	if S.conn then S.conn:Disconnect() end
	pcall(function() RunService:UnbindFromRenderStep("RallyeCam") end)
	unbindAll()
	if S.coinFolder then S.coinFolder:Destroy() end
	if S.ghost then S.ghost.model:Destroy() end
	if S.touchGui then S.touchGui:Destroy() end
	if S.gloveParts then for _, g in ipairs(S.gloveParts) do g:Destroy() end end
	if S.dashGui then S.dashGui:Destroy() end
	S = nil
	Hud.show(false)
	setControls(true)
	setCharVisible(true)
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	local h = hum()
	if h then h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local c = player.Character
	if c then camera.CameraSubject = c:FindFirstChildOfClass("Humanoid") end
end

function Drive.active() return S ~= nil end
function Drive.session() return S end

function Drive.sendCallout(text)
	if S and S.mode == "passenger" then
		task.spawn(req, "callout", text)
		Hud.callout("Tu annonces : " .. text)
	end
end

function Drive.onCallout(from, text)
	if S then Hud.callout(from .. " : " .. text) end
end

function Drive.setCopilot(name)
	Hud.setCopilot("Copilote : " .. name)
end

---------------------------------------------------------------------------
-- récupération (R) : dernier point de passage
---------------------------------------------------------------------------
function Drive.recover(manual)
	if not S or S.mode ~= "driver" or S.state == "finished" then return end
	if S.state == "countdown" then return end
	local T = S.T
	local idx = (S.cpIdx > 0) and T.cps[S.cpIdx] or Track.indexAtD(T, Config.SPAWN_D)
	local s = T.S[idx]
	local pos = S.origin + Vector3.new(s.x * M, (s.y + 1.4) * M, s.z * M)
	local fwd = Vector3.new(math.sin(s.h), 0, math.cos(s.h))
	S.model:PivotTo(CFrame.lookAt(pos, pos + fwd))
	local ch = S.model.PrimaryPart
	ch.AssemblyLinearVelocity = Vector3.zero
	ch.AssemblyAngularVelocity = Vector3.zero
	S.st.vF, S.st.vL, S.st.r = 0, 0, 0
	S.idx = idx
	if S.state == "running" then
		S.pen = S.pen + Config.RECOVER_PENALTY
		Hud.penalty(string.format("Récupération +%d s", Config.RECOVER_PENALTY))
	end
	S.flipT = 0
end

---------------------------------------------------------------------------
-- boucle physique
---------------------------------------------------------------------------
local function surfaceOf(material)
	return Config.SURFACES[material.Name] or Config.DEFAULT_SURFACE
end

local function driverInputs()
	local steer = input.left - input.right
	if input.stickX then steer = -input.stickX end
	local inp = {throttle = input.gas, brake = input.brake, steer = steer, hb = input.hb, shift = input.shift, sens = S.sens}
	input.shift = 0
	if S.state ~= "running" then
		inp.throttle, inp.brake, inp.hb = 0, 1, true
		if S.state == "countdown" then inp.steer = 0 end
	end
	return inp
end

function Drive.step(dt)
	if not S then return end
	local model = S.model
	local ch = model and model.PrimaryPart
	if not ch or not model.Parent then
		Drive.stop()
		return
	end
	local T = S.T
	local now = workspace:GetServerTimeNow()

	-- compte à rebours et feux
	if S.state == "countdown" then
		local left = S.startAt - now
		local n = math.ceil(left)
		if n ~= S.lastCount then
			S.lastCount = n
			if n >= 1 and n <= 3 then Hud.big(tostring(n), Ui.C.text) end
			if S.gantry then
				for k = 1, 3 do
					local l = S.gantry:FindFirstChild("Light" .. k)
					if l then l.Color = (k <= 4 - n and n <= 3) and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(60, 0, 0) end
				end
			end
		end
		if left <= 0 then
			S.state = "running"
			S.goTime = now
			Hud.big("ALLEZ !", Ui.C.green, 1)
			if S.gantry then
				for k = 1, 3 do
					local l = S.gantry:FindFirstChild("Light" .. k)
					if l then l.Color = Color3.fromRGB(40, 255, 80) end
				end
			end
		end
	end

	local cf = ch.CFrame
	local up = cf.UpVector
	local mass = ch.AssemblyMass

	-- position sur le tracé
	local px = (cf.Position.X - S.origin.X) / M
	local pz = (cf.Position.Z - S.origin.Z) / M
	local idx, lat, smp = Track.nearest(T, px, pz, S.idx)
	S.idx, S.lat = idx, lat
	S.d = smp.d

	if S.mode == "driver" then
		-- filtre des rayons : voitures et personnages
		S.charFilterT = S.charFilterT - dt
		if S.charFilterT <= 0 then
			S.charFilterT = 1
			local list = {workspace.Rallye.Cars}
			if S.coinFolder then table.insert(list, S.coinFolder) end
			if S.ghost then table.insert(list, S.ghost.model) end
			for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(list, p.Character) end end
			S.ray.FilterDescendantsInstances = list
		end

		-- suspension par rayons
		local grounded = 0
		local nSum = Vector3.zero
		local gF, gR, nF, nR, drag, mudHit = 0, 0, 0, 0, 0, false
		local surfName = nil
		for _, w in ipairs(S.wheels) do
			local origin = cf:PointToWorldSpace(w.pos)
			local res = workspace:Raycast(origin, -up * S.rayLen, S.ray)
			local x = 0
			if res and res.Distance < S.restLen + S.travel * 0.5 then
				x = S.restLen - res.Distance
				local xdot = (x - w.x) / dt
				local f = (S.k * x + S.c * xdot) * mass / 4
				if x > S.sag + S.travel then f = f + (x - S.sag - S.travel) * S.k * 6 * mass / 4 end
				f = math.max(0, f)
				ch:ApplyImpulseAtPosition(up * f * dt, origin)
				w.grounded = true
				grounded = grounded + 1
				nSum = nSum + res.Normal
				local sf = surfaceOf(res.Material)
				if w.front then gF = gF + sf.grip; nF = nF + 1 else gR = gR + sf.grip; nR = nR + 1 end
				local dg = sf.drag
				if sf.sand and S.car.sand then dg = dg * 0.4 end
				drag = drag + dg
				if sf.mud then mudHit = true end
				w.surf = sf
				surfName = surfName or sf.name
				w.dist = res.Distance
			else
				w.grounded = false
				w.dist = S.restLen + S.travel * 0.4
			end
			w.x = x
		end

		local inp = driverInputs()
		local st = S.st
		local p = S.p
		if grounded >= 2 then
			if S.airT > 0.45 and S.car.nervous then
				st.r = st.r + (math.random() - 0.5) * 1.4
				Hud.tip("La voiture est nerveuse sur les crêtes !", 1.5)
			end
			S.airT = 0
			local n = (nSum / grounded).Unit
			local fwd = cf.LookVector - n * cf.LookVector:Dot(n)
			if fwd.Magnitude < 0.05 then fwd = cf.LookVector end
			fwd = fwd.Unit
			local left = n:Cross(fwd)
			local v = ch.AssemblyLinearVelocity
			local w = ch.AssemblyAngularVelocity
			st.vF = v:Dot(fwd) / M
			st.vL = v:Dot(left) / M
			st.r = w:Dot(n)
			local vN = v:Dot(n)
			if smp.feat == "gue" then drag = drag + 2.5 * grounded; mudHit = true end
			local surf = {
				gF = nF > 0 and gF / nF or (nR > 0 and gR / nR or 0.7),
				gR = nR > 0 and gR / nR or (nF > 0 and gF / nF or 0.7),
				drag = drag / grounded,
			}
			local sub = 4
			for _ = 1, sub do Physics.step(p, st, inp, surf, dt / sub) end
			if S.state == "countdown" then st.vF, st.vL, st.r = 0, 0, 0 end
			ch.AssemblyLinearVelocity = fwd * st.vF * M + left * st.vL * M + n * vN
			local wPerp = w - n * w:Dot(n)
			ch.AssemblyAngularVelocity = wPerp * 0.96 + n * st.r
			S.surfName = surfName
			S.mudHit = mudHit
		else
			S.airT = S.airT + dt
			Physics.air(p, st, inp, dt)
			-- se redresse doucement en l'air
			local wv = ch.AssemblyAngularVelocity
			local fix = up:Cross(Vector3.yAxis) * 2.2 * dt
			ch.AssemblyAngularVelocity = wv * 0.995 + fix
			local v = ch.AssemblyLinearVelocity
			st.vF = v:Dot(cf.LookVector) / M
		end

		-- roues : suspension, braquage, rotation
		for _, w in ipairs(S.wheels) do
			if w.joint and w.base then
				local yoff = (2 * S.rad) - (w.dist or S.restLen)
				w.spin = (w.spin + st.vF * M / S.rad * dt) % (math.pi * 2)
				local steerA = w.front and st.steer or 0
				w.joint.C0 = CFrame.new(w.base.Position + Vector3.new(0, yoff, 0)) * CFrame.Angles(0, steerA, 0) * CFrame.Angles(-w.spin, 0, 0)
			end
		end

		-- poussière et projections
		local spd = math.abs(st.vF)
		for _, nm in ipairs({"DustRL", "DustRR"}) do
			local at = ch:FindFirstChild(nm)
			if at then
				local pe = at:FindFirstChild("Dust")
				local chunks = at:FindFirstChild("Chunks")
				local wsurf = nil
				for _, w in ipairs(S.wheels) do if ("Dust" .. w.name) == nm then wsurf = w.grounded and w.surf end end
				if pe then
					if wsurf and wsurf.dust and spd > 3 then
						pe.Color = ColorSequence.new(Color3.fromRGB(wsurf.dust[1], wsurf.dust[2], wsurf.dust[3]))
						pe.Rate = math.clamp(spd * 1.5 + math.abs(st.slipR) * 60, 0, 90)
					else
						pe.Rate = 0
					end
				end
				if chunks then
					if wsurf and (wsurf.mud or S.mudHit) and spd > 4 then
						chunks.Color = ColorSequence.new(Color3.fromRGB(80, 56, 34))
						chunks.Rate = math.clamp(spd * 2, 0, 60)
					else
						chunks.Rate = 0
					end
				end
			end
		end
		if S.mudHit and spd > 5 then S.mud = math.min(1, S.mud + dt * 0.25) else S.mud = math.max(0, S.mud - dt * 0.03) end

		-- chocs
		local speedNow = ch.AssemblyLinearVelocity.Magnitude / M
		local drop = S.lastSpeed - speedNow
		if drop > 6 and S.state == "running" then
			S.crashes = S.crashes + 1
			S.damage = math.min(1, S.damage + drop / 35)
			Hud.flash()
			local wsg = model:FindFirstChild("Windshield")
			if wsg then wsg.Transparency = math.min(0.6, wsg.Transparency + 0.1) ; wsg.Color = wsg.Color:Lerp(Color3.fromRGB(240, 240, 240), 0.3) end
		end
		S.lastSpeed = speedNow

		-- retourné ou trop loin : récupération automatique
		if up.Y < 0.25 then S.flipT = S.flipT + dt else S.flipT = 0 end
		if S.flipT > 2.5 or math.abs(lat) > 45 or cf.Position.Y < S.origin.Y + (smp.y - 25) * M then
			Hud.tip("Récupération automatique", 2)
			Drive.recover(false)
		end

		-- pièces
		if S.coins then
			for k, c in ipairs(S.coins) do
				if not c.got and (c.pos - cf.Position).Magnitude < 3 * M then
					c.got = true
					c.part.Transparency = 1
				end
				if not c.got then c.part.CFrame = CFrame.new(c.pos) * CFrame.Angles(0, os.clock() * 3 + k, 0) end
			end
		end

		-- redémarrage (maintenir Retour arrière)
		if S.restartHold and os.clock() - S.restartHold > 1 then
			S.restartHold = nil
			Hud.big("Redémarrage…", Ui.C.text, 1)
			task.spawn(function() req("startStage", S.opts.stageId, S.opts.carId) end)
		end
	end

	-- chrono, points de passage, arrivée
	if S.state == "running" then
		if not S.crossed and S.d >= T.startD then
			S.crossed = true
			S.t0 = now
		end
		if S.crossed then S.raw = now - S.t0 end
		if S.mode == "driver" then
			-- points de passage
			local nextCp = T.cps[S.cpIdx + 1]
			if nextCp and S.idx >= nextCp and S.crossed then
				S.cpIdx = S.cpIdx + 1
				local t = S.raw + S.pen
				S.cpTimes[S.cpIdx] = t
				task.spawn(req, "checkpoint", S.cpIdx, t)
				local best = S.bestSplits and S.bestSplits[S.cpIdx]
				if best then
					local dlt = t - best
					Hud.setCP(Ui.fmtDelta(dlt) .. "  PP " .. S.cpIdx .. "/" .. #T.cps, dlt < 0 and Ui.C.green or Ui.C.red)
				else
					Hud.setCP("PP " .. S.cpIdx .. "/" .. #T.cps)
				end
			end
			-- coupe de virage : loin à l'intérieur d'un virage serré
			local c = smp.corner and T.corners[smp.corner]
			if c and (c.grade <= 3 or c.hairpin) and math.abs(lat) > HALF + 2.5 and (lat > 0) == (c.dir == 1) then
				S.cutT = S.cutT + dt
				if S.cutT > 0.3 and S.cutCorner ~= c.id then
					S.cutCorner = c.id
					local p = (math.abs(lat) > HALF + 7) and 2.5 or 1.5
					S.pen = S.pen + p
					S.cuts = S.cuts + 1
					Hud.penalty(string.format("Coupe de virage : +%.1f s", p):gsub("%.", ","))
				end
			else
				S.cutT = 0
			end
			-- arrivée
			if S.d >= T.finishD and S.cpIdx >= #T.cps then
				Drive.finish()
			end
		end
	end

	-- copilote
	local spdNow = (ch.AssemblyLinearVelocity.Magnitude) / M
	local ahead = math.max(70, spdNow * 3.4)
	local note = Track.noteAt(T, S.d, ahead)
	if note then Hud.setCall(note, math.max(0, note.d - S.d)) else Hud.setCall({kind = "flat", text = "À fond", dir = 0, label = ""}) end
	if note and note ~= S.lastNote then
		S.lastNote = note
		if note.hairpin then S.hairpins = S.hairpins + 1 end
		if S.hints and note.tip then Hud.tip(note.tip, 4) end
	end

	-- affichage
	Hud.setTimer(S.raw + S.pen)
	Hud.setProgress((S.d - T.startD) / T.stageLength)
	local st = S.st
	local boost, boostTxt = nil, nil
	if S.car.turbo then boost = S.car.turbo.lag2 and (st.boost * 0.55 + st.boost2 * 0.45) or st.boost; boostTxt = "Turbo" end
	if S.car.hybrid then boost = st.battery; boostTxt = st.hybridOn and "Hybride : BOOST +134 ch" or "Batterie hybride" end
	local km = math.max(0, S.d - T.startD) / 1000
	if S.mode == "driver" then
		Hud.setDash(math.abs(st.vF) * 3.6, Physics.gearLabel(st), st.rpm, S.surfName or "", km, S.car.name, boost, boostTxt)
	else
		Hud.setDash(spdNow * 3.6, "-", 0, "", km, S.car.name)
	end
	local h = math.atan2(cf.LookVector.X, cf.LookVector.Z)
	Hud.updateMap(px, pz, h)
	local inside = S.camMode >= 2
	Hud.setCracks(S.damage, inside)
	Hud.setMud(S.mud, S.camMode == 3)
	if S.dash then
		S.dash.speed.Text = tostring(math.floor(math.abs(st.vF) * 3.6))
		S.dash.gear.Text = Physics.gearLabel(st)
		S.dash.time.Text = Ui.fmt(S.raw + S.pen)
		S.dash.temps.Text = string.format("H%d E%d B%d  %d%%", st.temps.oil, st.temps.water, st.temps.box, math.floor(st.fuel * 100))
		S.dash.hdg.Text = string.format("HDG %03d", math.floor(math.deg(h) % 360))
	end

	-- fantôme
	if S.ghost and S.crossed and S.state == "running" then
		local fr = S.ghost.frames
		local t = S.raw
		local i = S.ghostI or 1
		while fr[i + 1] and fr[i + 1].t <= t do i = i + 1 end
		S.ghostI = i
		local a = fr[i]
		local b = fr[i + 1] or a
		if a then
			local u = (b.t > a.t) and math.clamp((t - a.t) / (b.t - a.t), 0, 1) or 0
			S.ghost.model:PivotTo(a.cf:Lerp(b.cf, u))
		end
	end

	-- enregistrement du replay (20 images/s)
	S.recT = S.recT + dt
	if S.recT >= 0.05 and S.state ~= "finished" then
		S.recT = 0
		table.insert(S.frames, {t = S.crossed and S.raw or -(S.startAt - now), cf = cf, v = spdNow})
	end
end

---------------------------------------------------------------------------
-- arrivée
---------------------------------------------------------------------------
function Drive.finish()
	if S.state == "finished" then return end
	S.state = "finished"
	local total = S.raw + S.pen
	Hud.big("ARRIVÉE", Ui.C.acc)
	local coins = {}
	if S.coins then
		for k, c in ipairs(S.coins) do if c.got then coins[#coins + 1] = k end end
	end
	local session = S
	local frames = S.frames
	task.spawn(function()
		local result = req("finish", {raw = session.raw, pen = session.pen, coins = coins, crashes = session.crashes, cuts = session.cuts})
		-- fantôme : meilleur passage de la session
		local gk = session.opts.stageId .. "/" .. session.opts.carId
		if not ghosts[gk] or total < ghosts[gk].t then ghosts[gk] = {t = total, frames = frames} end
		task.wait(1.2)
		if session.opts.onFinish then session.opts.onFinish(result, {frames = frames, car = session.car, stageId = session.opts.stageId, T = session.T, origin = session.origin}) end
	end)
end

return Drive
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Interface de course : chrono, points de passage, copilote, compteur, mini-carte, dégâts

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Ui = require(script.Parent.Ui)
local make, C = Ui.make, Ui.C

local Hud = {}
local gui, el = nil, {}

local function txt(props)
	local l = make("TextLabel", props)
	l.TextStrokeTransparency = 0.6
	return l
end

function Hud.create(playerGui)
	if gui then gui:Destroy() end
	gui = make("ScreenGui", {Name = "RallyeHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5, Enabled = false, Parent = playerGui})
	el = {}

	-- surcouches : boue, fissures, flash rouge
	el.mud = make("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui})
	el.cracks = make("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui})
	el.flash = make("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.red, BackgroundTransparency = 1, Parent = gui})

	-- chrono (haut centre)
	local top = make("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(300, 92), BackgroundTransparency = 1, Parent = gui})
	el.cp = txt({Size = UDim2.new(1, 0, 0, 20), Text = "", Font = Enum.Font.GothamBold, TextSize = 18, Parent = top})
	el.timer = txt({Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 44), Text = "0:00.0", Font = Enum.Font.GothamBlack, TextSize = 42, Parent = top})
	local _, fill = Ui.bar(top, {Position = UDim2.fromOffset(40, 66), Size = UDim2.new(1, -80, 0, 6)}, 0, C.acc)
	el.progress = fill

	-- annonce du copilote
	el.call = make("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 108), Size = UDim2.fromOffset(330, 70),
		BackgroundColor3 = Color3.fromRGB(12, 16, 22), BackgroundTransparency = 0.2, Parent = gui})
	Ui.corner(el.call, 14)
	el.callStroke = Ui.stroke(el.call, C.red, 0)
	el.callStroke = el.call:FindFirstChildOfClass("UIStroke")
	el.arrow = txt({Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(64, 70), Text = "↑", Font = Enum.Font.GothamBlack, TextSize = 46, Parent = el.call})
	el.callText = txt({Position = UDim2.fromOffset(76, 8), Size = UDim2.new(1, -86, 0, 30), Text = "", Font = Enum.Font.GothamBlack, TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = el.call})
	el.callSub = txt({Position = UDim2.fromOffset(76, 40), Size = UDim2.new(1, -86, 0, 22), Text = "", Font = Enum.Font.GothamBold, TextSize = 16,
		TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = el.call})
	el.callTag = txt({AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(110, 22), Text = "", Font = Enum.Font.GothamBlack,
		TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, Parent = el.call})

	-- message central / pénalités / appels du copilote humain
	el.big = txt({AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(600, 110), Text = "",
		Font = Enum.Font.GothamBlack, TextSize = 90, Parent = gui})
	el.pen = txt({AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 186), Size = UDim2.fromOffset(500, 30), Text = "",
		Font = Enum.Font.GothamBlack, TextSize = 24, TextColor3 = C.red, Parent = gui})
	el.callout = txt({AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 220), Size = UDim2.fromOffset(500, 30), Text = "",
		Font = Enum.Font.GothamBlack, TextSize = 24, TextColor3 = Color3.fromRGB(110, 220, 255), Parent = gui})

	-- conseils (bas gauche) + mini-carte
	el.tip = make("TextLabel", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -200), Size = UDim2.fromOffset(330, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(12, 16, 22), BackgroundTransparency = 0.2, Text = "", TextWrapped = true, Font = Enum.Font.GothamBold, TextSize = 16,
		TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, Visible = false, Parent = gui})
	Ui.corner(el.tip, 10)
	Ui.pad(el.tip, 10)
	el.map = make("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -14), Size = UDim2.fromOffset(176, 176),
		BackgroundColor3 = Color3.fromRGB(12, 16, 22), BackgroundTransparency = 0.25, ClipsDescendants = true, Parent = gui})
	Ui.corner(el.map, 88)
	el.mapInner = make("Frame", {Size = UDim2.fromOffset(176, 176), BackgroundTransparency = 1, Parent = el.map})
	el.mapDot = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = C.acc, ZIndex = 3, Parent = el.map})
	Ui.corner(el.mapDot, 5)
	el.hdg = txt({AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(100, 18), Text = "HDG 000", Font = Enum.Font.GothamBold, TextSize = 13, ZIndex = 4, Parent = el.map})

	-- compteur (bas droite)
	local dash = make("Frame", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14), Size = UDim2.fromOffset(250, 170),
		BackgroundColor3 = Color3.fromRGB(12, 16, 22), BackgroundTransparency = 0.2, Parent = gui})
	Ui.corner(dash, 14)
	el.speed = txt({Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -70, 0, 60), Text = "0", Font = Enum.Font.GothamBlack, TextSize = 56, TextXAlignment = Enum.TextXAlignment.Right, Parent = dash})
	txt({Position = UDim2.new(1, -60, 0, 36), Size = UDim2.fromOffset(50, 20), Text = "km/h", TextColor3 = C.dim, TextSize = 14, Parent = dash})
	el.gear = txt({Position = UDim2.new(1, -60, 0, 4), Size = UDim2.fromOffset(50, 34), Text = "N", Font = Enum.Font.GothamBlack, TextSize = 30, TextColor3 = C.acc, Parent = dash})
	local _, rpm = Ui.bar(dash, {Position = UDim2.fromOffset(12, 70), Size = UDim2.new(1, -24, 0, 8)}, 0, C.green)
	el.rpm = rpm
	local boostBack, boost = Ui.bar(dash, {Position = UDim2.fromOffset(12, 84), Size = UDim2.new(1, -24, 0, 5)}, 0, C.blue)
	el.boost, el.boostBack = boost, boostBack
	el.boostLabel = txt({Position = UDim2.fromOffset(12, 90), Size = UDim2.new(1, -24, 0, 16), Text = "", TextSize = 12, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = dash})
	el.surface = txt({Position = UDim2.fromOffset(12, 106), Size = UDim2.new(1, -24, 0, 18), Text = "", Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = dash})
	el.km = txt({Position = UDim2.fromOffset(12, 126), Size = UDim2.new(1, -24, 0, 18), Text = "KM 0.0", TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = dash})
	el.carName = txt({Position = UDim2.fromOffset(12, 146), Size = UDim2.new(1, -24, 0, 18), Text = "", TextSize = 14, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = dash})

	-- joueurs (haut droite)
	el.players = make("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 60), Size = UDim2.fromOffset(220, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(12, 16, 22), BackgroundTransparency = 0.3, Parent = gui})
	Ui.corner(el.players, 10)
	Ui.pad(el.players, 8)
	Ui.list(el.players, 2)

	-- aide commandes + copilote
	el.help = txt({AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(760, 40), TextWrapped = true,
		Text = "", TextSize = 14, TextColor3 = C.dim, Parent = gui})
	el.copilot = txt({Position = UDim2.fromOffset(14, 60), Size = UDim2.fromOffset(300, 20), Text = "", TextSize = 15, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, Parent = gui})
	return gui
end

function Hud.gui() return gui end

function Hud.show(on)
	if gui then gui.Enabled = on end
end

function Hud.setTimer(t, raw)
	el.timer.Text = Ui.fmt(t)
end

function Hud.setCP(text, color)
	el.cp.Text = text or ""
	el.cp.TextColor3 = color or C.text
end

function Hud.setProgress(f)
	el.progress.Size = UDim2.fromScale(math.clamp(f, 0, 1), 1)
end

local ARROWS = {[1] = "←", [-1] = "→", [0] = "↑"}
function Hud.setCall(note, dist)
	if not note then
		el.call.Visible = false
		return
	end
	el.call.Visible = true
	local arrow = ARROWS[note.dir or 0] or "!"
	if note.hairpin then arrow = note.dir == 1 and "↶" or "↷" end
	if note.kind == "hazard" then arrow = "⚠" end
	el.arrow.Text = arrow
	el.callText.Text = note.text
	local sub = ""
	if note.puis then sub = "puis " .. note.puis end
	if dist and dist > 5 then sub = (sub ~= "" and (sub .. " · ") or "") .. math.floor(dist / 10 + 0.5) * 10 .. " m" end
	el.callSub.Text = sub
	el.callTag.Text = note.label or ""
	local red = note.tight or note.danger
	el.arrow.TextColor3 = red and C.red or C.text
	el.callTag.TextColor3 = (note.label == "LÉGER") and C.green or C.red
	el.callStroke.Thickness = red and 3 or 0
end

local tipToken = 0
function Hud.tip(text, dur)
	tipToken = tipToken + 1
	local my = tipToken
	el.tip.Text = text
	el.tip.Visible = true
	task.delay(dur or 4, function()
		if tipToken == my then el.tip.Visible = false end
	end)
end

local bigToken = 0
function Hud.big(text, color, dur)
	bigToken = bigToken + 1
	local my = bigToken
	el.big.Text = text
	el.big.TextColor3 = color or C.text
	if dur then
		task.delay(dur, function() if bigToken == my then el.big.Text = "" end end)
	end
end

local penToken = 0
function Hud.penalty(text)
	penToken = penToken + 1
	local my = penToken
	el.pen.Text = text
	task.delay(2.5, function() if penToken == my then el.pen.Text = "" end end)
end

local coToken = 0
function Hud.callout(text)
	coToken = coToken + 1
	local my = coToken
	el.callout.Text = text
	task.delay(2.5, function() if coToken == my then el.callout.Text = "" end end)
end

function Hud.setDash(kmh, gear, rpm, surface, km, carName, boost, boostText)
	el.speed.Text = tostring(math.floor(kmh + 0.5))
	el.gear.Text = gear
	el.rpm.Size = UDim2.fromScale(math.clamp(rpm, 0, 1), 1)
	el.rpm.BackgroundColor3 = rpm > 0.95 and C.red or C.green
	el.surface.Text = surface or ""
	el.km.Text = string.format("KM %.2f", km)
	el.carName.Text = carName or ""
	el.boostBack.Visible = boost ~= nil
	el.boostLabel.Text = boostText or ""
	if boost then el.boost.Size = UDim2.fromScale(math.clamp(boost, 0, 1), 1) end
end

function Hud.setHelp(text) el.help.Text = text or "" end
function Hud.setCopilot(text) el.copilot.Text = text or "" end

function Hud.flash()
	el.flash.BackgroundTransparency = 0.45
	TweenService:Create(el.flash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
end

-- fissures du pare-brise (lignes tournées)
function Hud.setCracks(level, visible)
	el.cracks.Visible = visible
	local want = math.floor(level * 14)
	local have = #el.cracks:GetChildren()
	local rnd = Random.new(have + 7)
	while have < want do
		have = have + 1
		local cx, cy = rnd:NextNumber(0.2, 0.8), rnd:NextNumber(0.1, 0.5)
		for k = 1, 5 do
			make("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(cx, cy), Size = UDim2.fromOffset(rnd:NextInteger(40, 160), 2),
				Rotation = k * 72 + rnd:NextNumber(-20, 20), BackgroundColor3 = Color3.fromRGB(235, 245, 255), BackgroundTransparency = 0.25, Parent = el.cracks})
		end
	end
	if want == 0 then
		for _, ch in ipairs(el.cracks:GetChildren()) do ch:Destroy() end
	end
end

-- boue sur le pare-brise
function Hud.setMud(level, visible)
	el.mud.Visible = visible
	local want = math.floor(level * 26)
	local list = el.mud:GetChildren()
	local rnd = Random.new(#list + 3)
	while #list < want do
		local s = rnd:NextInteger(30, 110)
		local f = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(rnd:NextNumber(0.05, 0.95), rnd:NextNumber(0.05, 0.6)), Size = UDim2.fromOffset(s, s * 0.7),
			BackgroundColor3 = Color3.fromRGB(70, 50, 30), BackgroundTransparency = 0.25, Parent = el.mud})
		Ui.corner(f, s)
		list = el.mud:GetChildren()
	end
	while #list > want do
		list[#list]:Destroy()
		list = el.mud:GetChildren()
	end
end

-- mini-carte : tracé centré sur la voiture, tourné selon le cap
local mapPts = nil
function Hud.buildMap(T)
	Ui.clear(el.mapInner)
	mapPts = {}
	local S = T.S
	for i = 1, #S, 6 do
		local f = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(5, 5), BackgroundColor3 = Color3.fromRGB(230, 230, 230), Parent = el.mapInner})
		mapPts[#mapPts + 1] = {f = f, x = S[i].x, z = S[i].z}
	end
	local fi = S[T.finishIdx]
	local fin = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(9, 9), BackgroundColor3 = C.green, ZIndex = 2, Parent = el.mapInner})
	mapPts[#mapPts + 1] = {f = fin, x = fi.x, z = fi.z}
end

function Hud.updateMap(x, z, heading)
	if not mapPts then return end
	local scale = 0.35
	local c, s = math.cos(heading), math.sin(heading)
	for _, p in ipairs(mapPts) do
		local dx, dz = p.x - x, p.z - z
		-- rotation : l'avant de la voiture vers le haut de la carte
		local rx = dx * c - dz * s
		local ry = dx * s + dz * c
		local px, py = 88 - rx * scale, 88 - ry * scale
		local vis = px > -10 and px < 186 and py > -10 and py < 186
		p.f.Visible = vis
		if vis then p.f.Position = UDim2.fromOffset(px, py) end
	end
	local deg = (math.deg(heading) % 360)
	el.hdg.Text = string.format("HDG %03d", math.floor(deg))
end

function Hud.updatePlayers()
	if not el.players then return end
	Ui.clear(el.players)
	make("TextLabel", {Size = UDim2.new(1, 0, 0, 18), Text = "JOUEURS", Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = C.acc,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = el.players})
	for _, p in ipairs(Players:GetPlayers()) do
		local stage = p:GetAttribute("StageName")
		local lvl = p:GetAttribute("Level") or 1
		make("TextLabel", {Size = UDim2.new(1, 0, 0, 18), Text = string.format("%s  · Niv %d · %s", p.DisplayName, lvl, stage or "Parc"),
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = el.players})
	end
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[-- Menus : accueil, étapes, garage, boutique, contrats, défis, conduite partagée, paramètres, résultats

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Rallye")
local Config = require(Shared.Config)
local Track = require(Shared.Track)
local Ui = require(script.Parent.Ui)
local make, C = Ui.make, Ui.C

local Menus = {}
local App -- fourni par le script principal
local gui, top, win, winTitle, body, toastBox, inviteBox
local player = Players.LocalPlayer
local trackInfo = {}

local function info(stageId)
	if not trackInfo[stageId] then
		local T = Track.generate(Config.STAGE_BY_ID[stageId])
		local ymin, ymax = math.huge, -math.huge
		local surfs, seen = {}, {}
		for _, s in ipairs(T.S) do
			ymin = math.min(ymin, s.y); ymax = math.max(ymax, s.y)
			local n = (Config.SURFACES[s.surf] or Config.DEFAULT_SURFACE).name
			if not seen[n] then seen[n] = true; surfs[#surfs + 1] = n end
		end
		for _, f in ipairs(T.features) do
			local h = Track.HAZARDS[f.kind]
			if h and not seen[h.text] and (f.kind == "gue" or f.kind == "pont" or f.kind == "pontCouvert" or f.kind == "saut" or f.kind == "tunnel") then
				seen[h.text] = true
				surfs[#surfs + 1] = h.text
			end
		end
		trackInfo[stageId] = {T = T, km = T.stageLength / 1000, climb = ymax - ymin, surfaces = table.concat(surfs, ", ")}
	end
	return trackInfo[stageId]
end

---------------------------------------------------------------------------
-- structure
---------------------------------------------------------------------------
function Menus.init(app)
	App = app
	local pg = player:WaitForChild("PlayerGui")
	gui = make("ScreenGui", {Name = "RallyeMenus", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 10, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = pg})

	-- barre du haut (parc)
	top = make("Frame", {Position = UDim2.fromOffset(12, 50), Size = UDim2.fromOffset(520, 44), BackgroundTransparency = 1, Parent = gui})
	Ui.list(top, 8, true)
	Ui.button("☰  MENU", {Size = UDim2.fromOffset(120, 40)}, function() Menus.open("main") end).Parent = top
	Menus.topInfo = make("TextLabel", {Size = UDim2.fromOffset(380, 40), BackgroundColor3 = C.panel, BackgroundTransparency = 0.15, Text = "",
		Font = Enum.Font.GothamBold, TextSize = 16, Parent = top})
	Ui.corner(Menus.topInfo, 10)

	-- fenêtre
	win = Ui.panel({AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.new(0.94, 0, 0.84, 0), Visible = false, Parent = gui})
	make("UISizeConstraint", {MaxSize = Vector2.new(960, 640), Parent = win})
	winTitle = make("TextLabel", {Position = UDim2.fromOffset(20, 10), Size = UDim2.new(1, -140, 0, 40), Text = "", Font = Enum.Font.GothamBlack, TextSize = 28,
		TextColor3 = C.acc, TextXAlignment = Enum.TextXAlignment.Left, Parent = win})
	local close = Ui.button("✕", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(40, 36)}, function() Menus.close() end, "secondary")
	close.Parent = win
	Menus.backBtn = Ui.button("◀ Retour", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -60, 0, 12), Size = UDim2.fromOffset(100, 36)}, function() Menus.open("main") end, "secondary")
	Menus.backBtn.Parent = win
	body = make("ScrollingFrame", {Position = UDim2.fromOffset(16, 58), Size = UDim2.new(1, -32, 1, -72), BackgroundTransparency = 1, ScrollBarThickness = 6,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = win})

	toastBox = make("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 60), Size = UDim2.fromOffset(460, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, ZIndex = 30, Parent = gui})
	Ui.list(toastBox, 6, false, Enum.HorizontalAlignment.Center)
	Menus.refreshTop()
end

function Menus.showTop(on) top.Visible = on end

function Menus.refreshTop()
	local p = App.profile
	if not p or not Menus.topInfo then return end
	local lvl = math.floor(p.exp / Config.LEVEL_EXP) + 1
	local building = Shared:GetAttribute("Building")
	local extra = building and ("  ·  construction : " .. math.floor((Shared:GetAttribute("BuildProgress") or 0) * 100) .. " %") or ""
	Menus.topInfo.Text = string.format("  %s CR   ·   Niveau %d   ·   %d EXP%s", Ui.num(p.cr), lvl, p.exp % Config.LEVEL_EXP, extra)
end

function Menus.isOpen() return win.Visible end

function Menus.close()
	win.Visible = false
	if App.onMenuClosed then App.onMenuClosed() end
end

function Menus.toast(text, color)
	local t = make("TextLabel", {Size = UDim2.fromOffset(460, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = color or C.panel2, Text = text,
		TextWrapped = true, Font = Enum.Font.GothamBold, TextSize = 17, ZIndex = 30, Parent = toastBox})
	Ui.corner(t, 10)
	Ui.pad(t, 10)
	task.delay(3.5, function() t:Destroy() end)
end

local SCREENS = {}
function Menus.open(name, arg)
	if not SCREENS[name] then return end
	win.Visible = true
	Ui.clear(body)
	body.CanvasPosition = Vector2.zero
	Menus.backBtn.Visible = name ~= "main" and name ~= "results"
	if not body:FindFirstChildOfClass("UIListLayout") then Ui.list(body, 10) end
	SCREENS[name](arg)
end

local function section(text)
	return make("TextLabel", {Size = UDim2.new(1, 0, 0, 26), Text = text, Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = C.dim,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = body})
end

local function row(height, parent)
	local f = make("Frame", {Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = C.panel2, Parent = parent or body})
	Ui.corner(f, 12)
	return f
end

---------------------------------------------------------------------------
-- accueil
---------------------------------------------------------------------------
SCREENS.main = function()
	winTitle.Text = "PISTE POUSSIÈRE"
	local p = App.profile
	local lvl = math.floor(p.exp / Config.LEVEL_EXP) + 1
	local head = row(70)
	Ui.label(string.format("%s   ·   Niveau %d   ·   %s CR", player.DisplayName, lvl, Ui.num(p.cr)), {Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -32, 0, 26),
		Font = Enum.Font.GothamBold, TextSize = 20, Parent = head})
	Ui.bar(head, {Position = UDim2.fromOffset(16, 42), Size = UDim2.new(1, -32, 0, 10)}, (p.exp % Config.LEVEL_EXP) / Config.LEVEL_EXP)

	-- événement
	local ev = row(56)
	ev.BackgroundColor3 = Color3.fromRGB(120, 70, 20)
	Ui.label(string.format("ÉVÉNEMENT EN COURS : %s — jetons de raid %d / 10 → gants « Sable du raid »", Config.EVENT.name, p.tokens or 0),
		{Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -150, 1, 0), Font = Enum.Font.GothamBold, TextSize = 16, Parent = ev})
	Ui.button("Y aller", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(120, 38)}, function()
		App.startStage(Config.EVENT.stage)
	end).Parent = ev

	local grid = make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = body})
	make("UIGridLayout", {CellSize = UDim2.new(0.5, -6, 0, 64), CellPadding = UDim2.fromOffset(12, 12), Parent = grid})
	local items = {
		{"CONDUIRE", function() Menus.open("stages") end},
		{"CONDUITE PARTAGÉE", function() Menus.open("drivers") end},
		{"DÉPLACEMENT LIBRE", function() Menus.close(); App.freeRoam() end},
		{"MON GARAGE", function() Menus.open("garage") end},
		{"BOUTIQUE", function() Menus.open("shop") end},
		{"CONTRATS", function() Menus.open("contracts") end},
		{"DÉFIER UN JOUEUR", function() Menus.open("challenge") end},
		{"PARAMÈTRES", function() Menus.open("settings") end},
	}
	for i, it in ipairs(items) do
		local b = Ui.button(it[1], {TextSize = 20}, it[2], i == 1 and "primary" or "secondary")
		b.Parent = grid
	end
	local building = Shared:GetAttribute("Building")
	if building then
		section("Construction des étapes en cours : " .. building .. " (" .. math.floor((Shared:GetAttribute("BuildProgress") or 0) * 100) .. " %)")
	end
end

---------------------------------------------------------------------------
-- étapes
---------------------------------------------------------------------------
SCREENS.stages = function()
	winTitle.Text = "ÉTAPES"
	local p = App.profile
	local car = Config.CAR_BY_ID[p.car]
	local carRow = row(50)
	Ui.label("Voiture : " .. car.name .. "  (" .. car.cls .. " " .. car.score .. ")", {Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -200, 1, 0),
		Font = Enum.Font.GothamBold, TextSize = 18, Parent = carRow})
	Ui.button("Changer", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(120, 36)}, function() Menus.open("garage") end, "secondary").Parent = carRow

	for _, st in ipairs(Config.STAGES) do
		local inf = info(st.id)
		local T = inf.T
		local r = row(150)
		if st.event then Ui.stroke(r, Color3.fromRGB(250, 150, 30), 2) end
		Ui.label((st.event and "ÉVÉNEMENT — " or "") .. st.name .. "  ·  " .. st.country, {Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -220, 0, 26),
			Font = Enum.Font.GothamBlack, TextSize = 20, Parent = r})
		local got = 0
		local cs = p.coins[st.id]
		if cs then for _ in pairs(cs) do got = got + 1 end end
		local medal = p.medals[st.id]
		local best = p.best[st.id]
		Ui.label(string.format("%.1f km · dénivelé %d m · %d virages · pièces %d/%d\n%s", inf.km, math.floor(inf.climb + 0.5), #T.corners, got, #T.coins, inf.surfaces),
			{Position = UDim2.fromOffset(16, 36), Size = UDim2.new(1, -220, 0, 40), TextSize = 14, TextColor3 = C.dim, Parent = r})
		local md = T.medals
		Ui.label(string.format("Bronze %s · Argent %s · Or %s · Platine %s", Ui.fmt(md.bronze), Ui.fmt(md.argent), Ui.fmt(md["or"]), Ui.fmt(md.platine)),
			{Position = UDim2.fromOffset(16, 80), Size = UDim2.new(1, -220, 0, 20), TextSize = 14, Parent = r})
		local lb = App.leaderboards[st.id]
		local glob = (lb and lb[1]) and (Ui.fmt(lb[1].t) .. " (" .. lb[1].name .. ")") or "--"
		Ui.label(string.format("Record perso : %s%s   ·   Meilleur temps mondial : %s", best and Ui.fmt(best.t) or "--",
			medal and ("  · " .. Config.MEDAL_NAMES[medal]) or "", glob), {Position = UDim2.fromOffset(16, 104), Size = UDim2.new(1, -220, 0, 36), TextSize = 14,
			TextColor3 = medal and Ui.rgb(Config.MEDAL_COLORS[medal]) or C.text, Parent = r})
		local ready = App.stageReady[st.id]
		local go = Ui.button(ready and "PARTIR" or "Construction…", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 14), Size = UDim2.fromOffset(180, 50), TextSize = 20},
			function() if App.stageReady[st.id] then App.startStage(st.id) end end, ready and "primary" or "secondary")
		go.Parent = r
		Ui.button("Classement", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 76), Size = UDim2.fromOffset(180, 40)}, function()
			Menus.open("leaderboard", st.id)
		end, "secondary").Parent = r
	end
end

SCREENS.leaderboard = function(stageId)
	local st = Config.STAGE_BY_ID[stageId]
	winTitle.Text = "CLASSEMENT — " .. string.upper(st.name)
	local list = App.req("leaderboard", stageId) or {}
	if #list == 0 then section("Aucun temps enregistré pour l'instant (ou classement indisponible en test dans Studio).") end
	for i, e in ipairs(list) do
		local r = row(40)
		Ui.label(string.format("%d.  %s", i, e.name or "?"), {Position = UDim2.fromOffset(16, 0), Size = UDim2.new(0.7, 0, 1, 0), Font = Enum.Font.GothamBold, TextSize = 17, Parent = r})
		Ui.label(Ui.fmt(e.t), {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 0), Size = UDim2.new(0.3, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right,
			Font = Enum.Font.GothamBlack, TextSize = 17, Parent = r})
	end
	Ui.button("◀ Étapes", {Size = UDim2.fromOffset(160, 40)}, function() Menus.open("stages") end, "secondary").Parent = body
end

---------------------------------------------------------------------------
-- garage
---------------------------------------------------------------------------
local function statBar(parent, y, name, v)
	Ui.label(name, {Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(120, 18), TextSize = 14, TextColor3 = C.dim, Parent = parent})
	Ui.bar(parent, {Position = UDim2.fromOffset(124, y + 5), Size = UDim2.new(1, -160, 0, 8)}, v / 10)
	Ui.label(tostring(v), {Position = UDim2.new(1, -30, 0, y), Size = UDim2.fromOffset(30, 18), TextSize = 14, Parent = parent})
end

SCREENS.garage = function(selId)
	winTitle.Text = "MON GARAGE"
	local p = App.profile
	selId = selId or p.car
	local car = Config.CAR_BY_ID[selId] or Config.CARS[1]
	local owned = p.owned[car.id]

	-- liste des voitures
	local list = make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = body})
	make("UIGridLayout", {CellSize = UDim2.new(0.25, -8, 0, 54), CellPadding = UDim2.fromOffset(8, 8), Parent = list})
	for _, c in ipairs(Config.CARS) do
		local own = p.owned[c.id]
		local t = c.name .. "  " .. c.cls .. "\n" .. (own and (c.id == p.car and "★ Choisie" or "Possédée") or (c.gamepass and App.cometeId ~= 0 and "Pass de jeu" or (Ui.num(c.price) .. " CR")))
		local b = Ui.button(t, {TextSize = 14}, function() Menus.open("garage", c.id) end, c.id == car.id and "primary" or "secondary")
		b.TextWrapped = true
		b.Parent = list
	end

	-- détail
	local d = row(250)
	local stats = Config.carStats(car)
	local drive = car.front == 1 and "Traction" or (car.front == 0 and "Propulsion" or string.format("4x4 %d/%d", math.floor(car.front * 100 + 0.5), math.floor((1 - car.front) * 100 + 0.5)))
	Ui.label(string.format("%s   %s %d", car.name, car.cls, car.score), {Position = UDim2.fromOffset(16, 10), Size = UDim2.new(0.5, -20, 0, 30), Font = Enum.Font.GothamBlack, TextSize = 24, Parent = d})
	Ui.label(car.desc, {Position = UDim2.fromOffset(16, 44), Size = UDim2.new(0.5, -20, 0, 60), TextSize = 14, TextColor3 = C.dim, Parent = d})
	Ui.label(string.format("%d km/h · %d ch · %d Nm · %d kg · %s%s", car.vmax, car.ch + (car.hybrid and car.hybrid.ch or 0), car.nm, car.kg, drive,
		car.turbo and " · turbo" or (car.hybrid and " · hybride" or (car.electric and " · électrique" or ""))),
		{Position = UDim2.fromOffset(16, 108), Size = UDim2.new(0.5, -20, 0, 36), TextSize = 14, Parent = d})
	local mexp = p.mastery[car.id] or 0
	local mlvl = 1
	for i, need in ipairs(Config.MASTERY_EXP) do if mexp >= need then mlvl = i end end
	local nextNeed = Config.MASTERY_EXP[mlvl + 1]
	Ui.label(string.format("Maîtrise M%d%s", mlvl, nextNeed and string.format("  (%d / %d EXP)", mexp, nextNeed) or "  (max)"),
		{Position = UDim2.fromOffset(16, 150), Size = UDim2.new(0.5, -20, 0, 20), Font = Enum.Font.GothamBold, TextSize = 15, Parent = d})
	Ui.bar(d, {Position = UDim2.fromOffset(16, 174), Size = UDim2.new(0.5, -36, 0, 8)}, nextNeed and (mexp - Config.MASTERY_EXP[mlvl]) / (nextNeed - Config.MASTERY_EXP[mlvl]) or 1, C.blue)

	local sp = make("Frame", {Position = UDim2.new(0.5, 10, 0, 16), Size = UDim2.new(0.5, -26, 0, 110), BackgroundTransparency = 1, Parent = d})
	statBar(sp, 0, "Vitesse max", stats.vitesse)
	statBar(sp, 26, "Accélération", stats.acceleration)
	statBar(sp, 52, "Adhérence", stats.adherence)
	statBar(sp, 78, "Maniabilité", stats.maniabilite)

	local act
	if owned then
		act = Ui.button(p.car == car.id and "Voiture choisie" or "CHOISIR", {}, function()
			App.req("selectCar", car.id)
			Menus.open("garage", car.id)
		end, p.car == car.id and "secondary" or nil)
	elseif car.gamepass and App.cometeId ~= 0 then
		act = Ui.button("Acheter le pass", {}, function() MarketplaceService:PromptGamePassPurchase(player, App.cometeId) end)
	else
		act = Ui.button("ACHETER  " .. Ui.num(car.price) .. " CR", {}, function()
			local r = App.req("buyCar", car.id)
			if r and r.ok then Menus.toast(car.name .. " ajoutée au garage !", C.green) else Menus.toast(r and r.msg or "Achat impossible", C.red) end
			Menus.open("garage", car.id)
		end)
	end
	act.AnchorPoint = Vector2.new(1, 1)
	act.Position = UDim2.new(1, -16, 1, -16)
	act.Size = UDim2.fromOffset(240, 50)
	act.Parent = d
	if owned then
		Ui.button("Rouler avec", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -266, 1, -16), Size = UDim2.fromOffset(150, 50)}, function()
			App.req("selectCar", car.id)
			Menus.open("stages")
		end, "secondary").Parent = d
	end

	-- peintures
	if owned then
		section("PEINTURE")
		local pal = make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = body})
		make("UIGridLayout", {CellSize = UDim2.fromOffset(110, 46), CellPadding = UDim2.fromOffset(8, 8), Parent = pal})
		for i, paint in ipairs(Config.PAINTS) do
			local own = p.ownedPaints[tostring(i)]
			local col = paint.rgb and Ui.rgb(paint.rgb) or Ui.rgb(car.color)
			local b = Ui.button(own and paint.name or "🔒", {TextSize = 12}, function()
				if own then
					App.req("setPaint", car.id, i)
					Menus.toast("Peinture appliquée à la prochaine course")
					Menus.open("garage", car.id)
				else
					Menus.toast("Débloque des peintures avec la caisse de peinture (Boutique)")
				end
			end)
			b.BackgroundColor3 = col
			b.TextColor3 = (col.R + col.G + col.B > 1.6) and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
			if (p.paints[car.id] or 1) == i then Ui.stroke(b, C.acc, 3) end
			if not own then b.BackgroundTransparency = 0.6 end
			b.Parent = pal
		end
	end

	-- gants du chauffeur
	section("GANTS DU CHAUFFEUR")
	local gl = make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = body})
	make("UIGridLayout", {CellSize = UDim2.fromOffset(170, 46), CellPadding = UDim2.fromOffset(8, 8), Parent = gl})
	for _, g in ipairs(Config.GLOVES) do
		local own = p.ownedGloves[g.id]
		local txt = g.name
		if not own then
			if g.price then txt = txt .. " · " .. g.price .. " CR" elseif g.event then txt = txt .. " · événement" elseif g.mastery then txt = txt .. " · M10" end
		end
		local b = Ui.button(txt, {TextSize = 13}, function()
			if own then
				App.req("setGloves", g.id)
			elseif g.price then
				local r = App.req("buyGloves", g.id)
				if not (r and r.ok) then Menus.toast(r and r.msg or "Impossible", C.red) end
			else
				Menus.toast("Ces gants se gagnent : " .. (g.event and "10 jetons de raid" or "maîtrise M10 sur une voiture"))
			end
			Menus.open("garage", car.id)
		end, p.gloves == g.id and "primary" or "secondary")
		b.TextWrapped = true
		local sw = make("Frame", {Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(10, 34), BackgroundColor3 = Ui.rgb(g.rgb), Parent = b})
		Ui.corner(sw, 4)
		b.Parent = gl
	end
end

