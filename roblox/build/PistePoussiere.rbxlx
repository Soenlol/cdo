<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX0000000C"><Properties><string name="Name">Workspace</string><float name="Gravity">29.43</float></Properties></Item><Item class="ReplicatedStorage" referent="RBX0000000D"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Rallye</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Cars</string><ProtectedString name="Source"><![CDATA[-- Construction des modèles de voitures en blocs (low-poly)
-- Utilisé par le serveur (voiture de course, vitrine) et par le client (fantôme, replay)

local Config = require(script.Parent.Config)

local Cars = {}
local M = Config.M

-- gabarits : longueur, largeur, hauteur caisse, hauteur cabine, longueur cabine, décalage cabine, rayon roue, garde au sol
local SHAPES = {
	citadine = {len = 3.7, wid = 1.65, body = 0.75, cab = 0.75, cabLen = 1.9, cabOff = -0.15, wheel = 0.33, ride = 0.42, wb = 2.3},
	coupe    = {len = 3.9, wid = 1.6, body = 0.6, cab = 0.55, cabLen = 1.6, cabOff = -0.2, wheel = 0.32, ride = 0.30, wb = 2.25},
	mini     = {len = 3.1, wid = 1.45, body = 0.65, cab = 0.62, cabLen = 1.6, cabOff = -0.1, wheel = 0.28, ride = 0.28, wb = 2.05},
	compacte = {len = 4.0, wid = 1.75, body = 0.7, cab = 0.62, cabLen = 1.9, cabOff = -0.2, wheel = 0.34, ride = 0.34, wb = 2.4},
	cubique  = {len = 4.2, wid = 1.7, body = 0.72, cab = 0.62, cabLen = 1.8, cabOff = -0.15, wheel = 0.33, ride = 0.32, wb = 2.55},
	berline  = {len = 4.5, wid = 1.75, body = 0.72, cab = 0.66, cabLen = 2.4, cabOff = -0.1, wheel = 0.34, ride = 0.34, wb = 2.6},
	buggy    = {len = 4.1, wid = 2.0, body = 0.5, cab = 0.9, cabLen = 1.8, cabOff = 0.1, wheel = 0.45, ride = 0.55, wb = 2.8, open = true},
	groupeb  = {len = 4.0, wid = 1.85, body = 0.68, cab = 0.58, cabLen = 1.7, cabOff = -0.1, wheel = 0.35, ride = 0.30, wb = 2.3, wing = true},
	rally1   = {len = 4.2, wid = 1.88, body = 0.72, cab = 0.62, cabLen = 1.9, cabOff = -0.1, wheel = 0.35, ride = 0.32, wb = 2.6, wing = true},
	suv      = {len = 4.9, wid = 1.98, body = 0.95, cab = 0.72, cabLen = 2.6, cabOff = -0.15, wheel = 0.40, ride = 0.42, wb = 2.95},
	truck    = {len = 5.4, wid = 2.2, body = 0.85, cab = 0.8, cabLen = 1.9, cabOff = 0.2, wheel = 0.55, ride = 0.62, wb = 3.3, open = false, bed = true},
	supercar = {len = 4.3, wid = 1.9, body = 0.55, cab = 0.5, cabLen = 1.7, cabOff = -0.15, wheel = 0.34, ride = 0.24, wb = 2.5, wing = true},
}
Cars.SHAPES = SHAPES

function Cars.shapeOf(car)
	return SHAPES[car.shape] or SHAPES.compacte
end

local function c3(rgb) return Color3.fromRGB(rgb[1], rgb[2], rgb[3]) end

local function part(props)
	local p = Instance.new(props.Class or "Part")
	props.Class = nil
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do p[k] = v end
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
	return w
end

-- construit le modèle ; anchored = vitrine / fantôme
function Cars.build(car, paintRGB, opts)
	opts = opts or {}
	local sh = Cars.shapeOf(car)
	local col = c3(paintRGB or car.color)
	local model = Instance.new("Model")
	model.Name = car.name

	local len, wid = sh.len * M, sh.wid * M
	local bodyH, cabH = sh.body * M, sh.cab * M
	local ride = (sh.ride + sh.wheel * 0.2) * M

	-- châssis = la seule pièce physique (collision avec le décor)
	local chassis = part({Name = "Chassis", Size = Vector3.new(wid * 0.92, bodyH * 0.85, len * 0.96),
		Transparency = 1, CanCollide = true, CanQuery = false, Massless = false})
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.6, 0.05, 0, 100, 1)
	chassis.CFrame = CFrame.new(0, ride + bodyH / 2, 0)
	chassis.Parent = model
	model.PrimaryPart = chassis

	local base = chassis.CFrame
	local function add(name, size, offset, color, material, extra)
		local p = part({Name = name, Size = size, Color = color or col, CFrame = base * offset})
		if material then p.Material = material end
		if extra then for k, v in pairs(extra) do p[k] = v end end
		p.Parent = model
		weld(chassis, p)
		return p
	end

	local dark = Color3.fromRGB(28, 28, 30)
	local glass = Color3.fromRGB(150, 200, 235)
	local white = Color3.fromRGB(245, 245, 245)

	-- caisse
	add("Body", Vector3.new(wid, bodyH, len), CFrame.new(0, 0, 0))
	add("Bumper", Vector3.new(wid * 1.01, bodyH * 0.35, 0.25 * M), CFrame.new(0, -bodyH * 0.3, -len / 2), dark)
	add("BumperR", Vector3.new(wid * 1.01, bodyH * 0.35, 0.25 * M), CFrame.new(0, -bodyH * 0.3, len / 2), dark)
	-- plaque numéro portière
	add("Number", Vector3.new(wid * 1.02, bodyH * 0.55, 0.9 * M), CFrame.new(0, 0, -sh.cabOff * M), white)
	-- phares
	for _, sx in ipairs({-1, 1}) do
		add("Light", Vector3.new(0.35 * M, 0.18 * M, 0.06 * M), CFrame.new(sx * wid * 0.32, bodyH * 0.1, -len / 2 - 0.02 * M),
			Color3.fromRGB(255, 250, 220), Enum.Material.Neon)
		add("Tail", Vector3.new(0.35 * M, 0.14 * M, 0.06 * M), CFrame.new(sx * wid * 0.34, bodyH * 0.15, len / 2 + 0.02 * M),
			Color3.fromRGB(200, 20, 20), Enum.Material.Neon)
	end

	-- cabine (ou arceau pour le buggy)
	local cabY = bodyH / 2 + cabH / 2
	local cabZ = sh.cabOff * M
	if sh.open then
		for _, sx in ipairs({-1, 1}) do
			for _, sz in ipairs({-1, 1}) do
				add("Cage", Vector3.new(0.12 * M, cabH, 0.12 * M), CFrame.new(sx * wid * 0.38, cabY, cabZ + sz * sh.cabLen * M * 0.45), dark)
			end
		end
		add("CageTop", Vector3.new(wid * 0.8, 0.1 * M, sh.cabLen * M), CFrame.new(0, bodyH / 2 + cabH, cabZ), dark)
		add("Windshield", Vector3.new(wid * 0.7, cabH * 0.6, 0.04 * M), CFrame.new(0, cabY, cabZ - sh.cabLen * M * 0.45) * CFrame.Angles(math.rad(-15), 0, 0),
			glass, Enum.Material.Glass, {Transparency = 0.6})
	else
		add("Cabin", Vector3.new(wid * 0.86, cabH, sh.cabLen * M), CFrame.new(0, cabY, cabZ))
		add("Roof", Vector3.new(wid * 0.8, 0.06 * M, sh.cabLen * M * 0.8), CFrame.new(0, bodyH / 2 + cabH + 0.03 * M, cabZ), white)
		add("Windshield", Vector3.new(wid * 0.8, cabH * 0.8, 0.05 * M), CFrame.new(0, cabY, cabZ - sh.cabLen * M / 2 - 0.01 * M),
			glass, Enum.Material.Glass, {Transparency = 0.25})
		add("RearGlass", Vector3.new(wid * 0.78, cabH * 0.7, 0.05 * M), CFrame.new(0, cabY, cabZ + sh.cabLen * M / 2 + 0.01 * M),
			glass, Enum.Material.Glass, {Transparency = 0.3})
		for _, sx in ipairs({-1, 1}) do
			add("SideGlass", Vector3.new(0.05 * M, cabH * 0.7, sh.cabLen * M * 0.8), CFrame.new(sx * (wid * 0.43 + 0.01 * M), cabY, cabZ),
				glass, Enum.Material.Glass, {Transparency = 0.3})
		end
	end
	if sh.wing then
		add("Wing", Vector3.new(wid * 0.95, 0.06 * M, 0.45 * M), CFrame.new(0, bodyH / 2 + cabH * 0.75, len / 2 - 0.3 * M), dark)
		for _, sx in ipairs({-1, 1}) do
			add("WingLeg", Vector3.new(0.06 * M, cabH * 0.6, 0.2 * M), CFrame.new(sx * wid * 0.35, bodyH / 2 + cabH * 0.4, len / 2 - 0.3 * M), dark)
		end
	end
	if sh.bed then
		add("Bed", Vector3.new(wid * 0.9, 0.5 * M, len * 0.32), CFrame.new(0, bodyH / 2 + 0.25 * M, len * 0.3), dark)
		add("Spare", Vector3.new(wid * 0.5, 0.35 * M, 0.9 * M), CFrame.new(0, bodyH / 2 + 0.6 * M, len * 0.32), dark)
	end
	-- prise d'air / rampe de phares pour les voitures de rallye
	if car.cls == "A" or car.cls == "S" then
		add("Scoop", Vector3.new(wid * 0.3, 0.12 * M, 0.6 * M), CFrame.new(0, bodyH / 2 + cabH + 0.08 * M, cabZ), dark)
	end

	-- sièges (le conducteur s'assoit à gauche, le copilote à droite)
	local seatY = -bodyH * 0.4
	local seatZ = cabZ + 0.15 * M
	local function seat(name, sx)
		local s = part({Class = "Seat", Name = name, Size = Vector3.new(0.6 * M, 0.2 * M, 0.6 * M), Transparency = 1,
			CFrame = base * CFrame.new(sx * wid * 0.22, seatY, seatZ)})
		s.CanTouch = false
		s.Parent = model
		weld(chassis, s)
		return s
	end
	seat("DriverSeat", -1)
	seat("PassengerSeat", 1)

	-- tableau de bord / volant (repère pour la vue cockpit)
	local dashZ = cabZ - sh.cabLen * M * 0.38
	add("Dash", Vector3.new(wid * 0.82, 0.25 * M, 0.3 * M), CFrame.new(0, bodyH * 0.45, dashZ), dark)
	add("SteeringWheel", Vector3.new(0.38 * M, 0.38 * M, 0.05 * M), CFrame.new(-wid * 0.22, bodyH * 0.55 + 0.15 * M, dashZ + 0.25 * M) * CFrame.Angles(math.rad(-20), 0, 0), dark)
	local eye = Instance.new("Attachment")
	eye.Name = "Eye"
	eye.Position = Vector3.new(-wid * 0.22, bodyH * 0.55 + 0.6 * M, cabZ + 0.05 * M)
	eye.Parent = chassis

	-- roues (soudées, l'animation est faite côté client)
	local wheelW = 0.26 * M
	local rad = sh.wheel * M
	local zF, zR = -sh.wb * M / 2, sh.wb * M / 2
	local wx = wid / 2 - wheelW * 0.3
	local wy = -(ride + bodyH / 2) + rad
	local names = {{"FL", -1, zF}, {"FR", 1, zF}, {"RL", -1, zR}, {"RR", 1, zR}}
	for _, w in ipairs(names) do
		local wp = part({Class = "Part", Name = "Wheel" .. w[1], Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(wheelW, rad * 2, rad * 2), Color = dark, Material = Enum.Material.SmoothPlastic})
		wp.CFrame = base * CFrame.new(w[2] * wx, wy, w[3])
		wp.Parent = model
		local hub = part({Name = "Hub" .. w[1], Size = Vector3.new(wheelW * 1.05, rad * 0.9, rad * 0.9), Color = Color3.fromRGB(190, 190, 195),
			CFrame = wp.CFrame})
		hub.Shape = Enum.PartType.Cylinder
		hub.Parent = model
		weld(wp, hub)
		local m6 = Instance.new("Weld")
		m6.Name = "Joint" .. w[1]
		m6.Part0 = chassis
		m6.Part1 = wp
		m6.C0 = CFrame.new(w[2] * wx, wy, w[3])
		m6.Parent = wp
		local at = Instance.new("Attachment")
		at.Name = "Mount" .. w[1]
		at.Position = Vector3.new(w[2] * wx, wy + rad, w[3])
		at.Parent = chassis
		-- poussière
		if w[1] == "RL" or w[1] == "RR" then
			local pa = Instance.new("Attachment")
			pa.Name = "Dust" .. w[1]
			pa.Position = Vector3.new(w[2] * wx, wy - rad * 0.6, w[3] + rad)
			pa.Parent = chassis
			local pe = Instance.new("ParticleEmitter")
			pe.Name = "Dust"
			pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
			pe.Rate = 0
			pe.Lifetime = NumberRange.new(0.8, 1.6)
			pe.Speed = NumberRange.new(2, 6)
			pe.SpreadAngle = Vector2.new(25, 25)
			pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 6)})
			pe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1)})
			pe.Acceleration = Vector3.new(0, 2, 0)
			pe.Drag = 1.5
			pe.EmissionDirection = Enum.NormalId.Back
			pe.Parent = pa
			local mud = Instance.new("ParticleEmitter")
			mud.Name = "Chunks"
			mud.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			mud.Rate = 0
			mud.Lifetime = NumberRange.new(0.4, 0.8)
			mud.Speed = NumberRange.new(6, 14)
			mud.SpreadAngle = Vector2.new(35, 35)
			mud.Size = NumberSequence.new(0.4)
			mud.Acceleration = Vector3.new(0, -30, 0)
			mud.EmissionDirection = Enum.NormalId.Back
			mud.Parent = pa
		end
	end

	model:SetAttribute("CarId", car.id)
	model:SetAttribute("WheelRadius", rad)
	model:SetAttribute("Ride", ride)

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = opts.anchored == true
			if opts.ghost and d.Transparency < 1 then d.Transparency = 0.6 end
			if opts.ghost or opts.anchored then
				d.CanCollide = false
			end
		end
	end
	return model
end

-- positions des roues dans le repère du châssis (pour la suspension par rayons)
function Cars.wheelMounts(model)
	local out = {}
	local ch = model.PrimaryPart
	for _, n in ipairs({"FL", "FR", "RL", "RR"}) do
		local at = ch:FindFirstChild("Mount" .. n)
		out[#out + 1] = {name = n, pos = at.Position, front = (n == "FL" or n == "FR")}
	end
	return out
end

function Cars.paint(model, rgb)
	local col = c3(rgb)
	for _, n in ipairs({"Body", "Cabin"}) do
		local p = model:FindFirstChild(n)
		if p then p.Color = col end
	end
end

return Cars
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Piste Poussière : données du jeu (voitures, étapes, surfaces, récompenses)
-- Unités internes : mètres, secondes, kg. 1 m = Config.M studs dans Roblox.

local Config = {}

Config.VERSION = 1
Config.M = 3                 -- studs par mètre
Config.G = 9.81
Config.HALF = 4              -- demi-largeur de la route (m)
Config.STEP = 2              -- pas d'échantillonnage du tracé (m)
Config.START_D = 22          -- distance de l'arche de départ (m)
Config.SPAWN_D = 8           -- position d'apparition (m)
Config.RECOVER_PENALTY = 3   -- R = dernier point de passage (+3 s)

-- IDs Roblox à remplir après publication (0 = désactivé)
Config.VIP_GAMEPASS_ID = 0       -- double EXP et crédits
Config.COMETE_GAMEPASS_ID = 0    -- débloque la Comète Bi

---------------------------------------------------------------------------
-- Surfaces : clé = nom du matériau de terrain Roblox
-- grip : multiplicateur d'adhérence, drag : résistance (m/s²), fx : couleur de poussière
---------------------------------------------------------------------------
Config.BASE_MU = 1.6      -- adhérence de base (arcade) sur asphalte
Config.LONG_MU = 1.45     -- les freins mordent plus fort que l'adhérence latérale

Config.SURFACES = {
	Asphalt   = {name = "Asphalte",        grip = 1.00, drag = 0.15, dust = nil},
	Pavement  = {name = "Pavés",           grip = 0.90, drag = 0.25, dust = nil},
	Cobblestone = {name = "Pavés",         grip = 0.88, drag = 0.30, dust = nil},
	Ground    = {name = "Gravier",         grip = 0.72, drag = 0.45, dust = {200, 172, 130}},
	Sandstone = {name = "Terre rouge",     grip = 0.70, drag = 0.50, dust = {196, 104, 60}},
	Mud       = {name = "Boue",            grip = 0.52, drag = 1.80, dust = {78, 56, 36}, mud = true},
	Salt      = {name = "Neige tassée",    grip = 0.46, drag = 0.55, dust = {245, 248, 255}},
	Ice       = {name = "Glace",           grip = 0.20, drag = 0.10, dust = {220, 240, 255}},
	Sand      = {name = "Sable",           grip = 0.58, drag = 2.30, dust = {236, 214, 160}, sand = true},
	WoodPlanks = {name = "Pont en bois",   grip = 0.85, drag = 0.30, dust = nil},
	Grass     = {name = "Herbe",           grip = 0.60, drag = 5.00, dust = {96, 128, 60}, offroad = true},
	LeafyGrass = {name = "Herbe haute",    grip = 0.58, drag = 5.50, dust = {150, 140, 70}, offroad = true},
	Snow      = {name = "Neige profonde",  grip = 0.40, drag = 6.00, dust = {255, 255, 255}, offroad = true},
	Rock      = {name = "Rocaille",        grip = 0.75, drag = 1.50, dust = {150, 120, 100}, offroad = true},
	Glacier   = {name = "Glace du lac",    grip = 0.18, drag = 0.20, dust = {220, 240, 255}},
	Water     = {name = "Eau",             grip = 0.50, drag = 6.00, dust = {200, 220, 240}, mud = true},
}
Config.DEFAULT_SURFACE = {name = "Bas-côté", grip = 0.65, drag = 3.0, dust = {120, 110, 90}, offroad = true}

-- couleurs des matériaux de terrain (appliquées une fois)
Config.MATERIAL_COLORS = {
	Ground = {168, 142, 104}, Sandstone = {178, 92, 52}, Salt = {226, 232, 240},
	Asphalt = {74, 76, 82}, Mud = {92, 66, 42}, Grass = {96, 140, 58},
	LeafyGrass = {178, 160, 84}, Snow = {242, 246, 250}, Sand = {226, 202, 140},
	Rock = {128, 112, 100}, Glacier = {170, 214, 236}, Ice = {196, 230, 248},
	WoodPlanks = {130, 92, 58}, Pavement = {150, 146, 140}, Cobblestone = {140, 134, 126},
}

---------------------------------------------------------------------------
-- Voitures (toutes originales)
-- ch : puissance, nm : couple, kg : masse, vmax : km/h
-- front : part du couple sur l'avant (1 = traction, 0 = propulsion, 0.44 = 4x4 44/56)
-- rear : répartition des masses vers l'arrière, travel : débattement (m), freq : raideur (Hz)
---------------------------------------------------------------------------
Config.CARS = {
	{id = "moineau", name = "Moineau 4", cls = "D", score = 281, ch = 75, nm = 110, kg = 830, vmax = 149, front = 0,
		rear = 0.48, travel = 0.30, freq = 1.05, grip = 0.95, gears = 4, price = 0, shape = "citadine",
		color = {120, 190, 70}, desc = "Citadine surélevée pour débuter. Penche, rebondit, glisse lentement : très indulgente."},
	{id = "pomme", name = "Pomme 2", cls = "D", score = 362, ch = 130, nm = 160, kg = 880, vmax = 177, front = 1,
		rear = 0.40, travel = 0.22, freq = 1.4, grip = 1.0, gears = 5, price = 1500, shape = "coupe",
		color = {220, 60, 50}, desc = "Petit coupé des années 60 au moteur pointu. Traction : pousse si on est gourmand, rentre au lever de pied."},
	{id = "puce", name = "Puce S", cls = "C", score = 438, ch = 110, nm = 120, kg = 690, vmax = 157, front = 1,
		rear = 0.38, travel = 0.20, freq = 1.6, grip = 1.04, gears = 4, price = 2500, shape = "mini",
		color = {250, 210, 60}, desc = "Mini joyeuse, une roue à chaque coin. Virevolte dans le serré, s'essouffle en ligne droite."},
	{id = "eclair", name = "Éclair T", cls = "C", score = 492, ch = 215, nm = 300, kg = 1200, vmax = 175, front = 0.45,
		rear = 0.47, travel = 0.25, freq = 1.4, grip = 1.02, gears = 5, price = 4500, shape = "compacte",
		turbo = {lag = 0.45}, nervous = true, color = {245, 245, 245},
		desc = "Compacte turbo à empattement court. 4x4 indulgente sur gravier, nerveuse sur les crêtes."},
	{id = "lynx", name = "Lynx 16V", cls = "B", score = 584, ch = 230, nm = 240, kg = 1150, vmax = 178, front = 0,
		rear = 0.50, travel = 0.24, freq = 1.5, grip = 1.03, gears = 5, price = 6500, shape = "cubique",
		color = {40, 110, 220}, desc = "Deux-portes cubique Groupe A. Propulsion : l'arrière glisse à l'accélérateur."},
	{id = "ondine", name = "Ondine RS", cls = "B", score = 648, ch = 300, nm = 400, kg = 1350, vmax = 191, front = 0.38,
		rear = 0.50, travel = 0.25, freq = 1.45, grip = 1.06, gears = 5, price = 9000, shape = "berline",
		turbo = {lag = 0.5}, color = {30, 60, 140},
		desc = "Berline 4 portes turbo. Tire fort dès que le turbo s'active, stable à haute vitesse."},
	{id = "scorpion", name = "Scorpion", cls = "A", score = 736, ch = 310, nm = 520, kg = 1050, vmax = 184, front = 0,
		rear = 0.60, travel = 0.45, freq = 0.95, grip = 1.0, gears = 5, price = 12000, shape = "buggy",
		sand = true, color = {230, 120, 30},
		desc = "Buggy de raid à moteur arrière. Flotte sur les bosses, l'arrière balaie large en sortie."},
	{id = "tempete", name = "Tempête T4", cls = "A", score = 828, ch = 470, nm = 490, kg = 1090, vmax = 195, front = 0.44,
		rear = 0.55, travel = 0.27, freq = 1.5, grip = 1.06, gears = 5, price = 16000, shape = "groupeb",
		turbo = {lag = 0.85}, color = {200, 30, 40},
		desc = "Groupe B à empattement court. Le turbo ne fait rien… puis tout. Coup de frein à main pour faire passer l'arrière."},
	{id = "volt", name = "Volt H1", cls = "A", score = 790, ch = 380, nm = 450, kg = 1260, vmax = 198, front = 0.42,
		rear = 0.52, travel = 0.27, freq = 1.55, grip = 1.12, brake = 19, gears = 5, price = 19000, shape = "rally1",
		hybrid = {ch = 134}, color = {20, 20, 30},
		desc = "Hybride : la batterie se recharge au freinage puis ajoute 134 ch dans le virage suivant. Meilleur grip et meilleurs freins."},
	{id = "tonnerre", name = "Tonnerre E", cls = "A", score = 842, ch = 1020, nm = 1420, kg = 2200, vmax = 200, front = 0.5,
		rear = 0.50, travel = 0.32, freq = 1.2, grip = 1.0, gears = 1, price = 22000, shape = "suv",
		electric = true, color = {60, 200, 190},
		desc = "SUV électrique : couple instantané, mais 2,2 tonnes à arrêter avant chaque épingle."},
	{id = "bison", name = "Bison V8", cls = "S", score = 893, ch = 850, nm = 940, kg = 2200, vmax = 204, front = 0,
		rear = 0.52, travel = 0.50, freq = 0.85, grip = 1.0, gears = 5, price = 26000, shape = "truck",
		sand = true, color = {255, 150, 30},
